sqldelight_library(
    name = "sqldelight",
    srcs = glob(["src/commonMain/sqldelight/**/*.sq"]),
    module_name = "write",
    package = "com.moneymanager.database.sql.testwrite",
    visibility = ["//visibility:public"],
    deps = ["//app/db/schema:sqldelight"],
)

kmp_library(
    name = "write",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    sqldelight = ":sqldelight",
    visibility = ["//test/app/db:__pkg__"],
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = ["//app/db/schema"],
    deps = ["//app/db/write"],
)
