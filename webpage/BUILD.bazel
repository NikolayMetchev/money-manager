load("//bazel/kmp/dokka:dokka.bzl", "dokka_site")
load("//bazel/pages:pages.bzl", "module_graph", "pages_site")
load(":kdoc_modules.bzl", "KDOC_MODULES")

# The GitHub Pages site (#1027), as static.yml deploys it: the checked-in pages plus what the build generates.
pages_site(
    name = "site",
    srcs = glob(["*.html"]),
    generated = {
        "//app/main/web:dist": "app",
        "//app/db/schemaspy:docs": "database",
        ":kdoc": "kdoc",
        "//tools/strategy-catalog:catalog_site": ".",
        ":modules-graph": "modules-graph.md",
    },
    strip_prefix = "webpage",
    tags = ["manual"],
)

# What modules.html renders: every module's dependencies, from what each one declares (//:modules).
module_graph(
    name = "modules-graph",
    tags = ["manual"],
)

# The root build's dokkaGeneratePublicationHtml.
dokka_site(
    name = "kdoc",
    module_name = "Money Manager",
    modules = KDOC_MODULES,
    tags = ["manual"],
)
