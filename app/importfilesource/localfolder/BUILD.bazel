# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web
# Local import folders need file times, which the browser has none of (utils/files): no browser tests.
# gazelle:kmp_web_tests false
# gazelle:kmp_export //app/importfilesource/core

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "localfolder",
    android = True,
    android_srcs = glob(["src/androidMain/kotlin/**/*.kt"]),
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = ["//app/importfilesource/core"],
    deps = [
        "//utils/coroutines",
        "//utils/files",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_io_core",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":localfolder",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    deps = [
        "//bazel/kmp/deps:kotlin_test",
        "//utils/files",
        "@maven_kmp//:kotlinx_coroutines_test",
        "@maven_kmp//:kotlinx_io_core",
    ],
)
