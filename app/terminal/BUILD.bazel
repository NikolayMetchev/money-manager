# gazelle:kmp_generate true
# gazelle:kmp_targets linuxArm64 linuxX64 macosArm64 mingwX64
# gazelle:kmp_plugins compose
# gazelle:kmp_export //app/tasks
# gazelle:kmp_export @maven_kmp//:kotlinx_coroutines_core
# gazelle:kmp_export @maven_kmp//:mosaic_runtime
# gazelle:kmp_export @maven_kmp//:androidx_compose_runtime_desktop jvmMain
# gazelle:kmp_export @maven_kmp//:mosaic_terminal jvmMain
# gazelle:kmp_keep_dep @maven_kmp//:androidx_compose_runtime_desktop jvmTest

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "terminal",
    apple_srcs = glob(["src/appleMain/kotlin/**/*.kt"]),
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_deps = ["@maven_kmp//:kermit"],
    jvm_exports = ["@maven_kmp//:androidx_compose_runtime_desktop"],
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    linux_srcs = glob(["src/linuxMain/kotlin/**/*.kt"]),
    mingw_srcs = glob(["src/mingwMain/kotlin/**/*.kt"]),
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["compose"],
    visibility = ["//visibility:public"],
    exports = [
        "//app/tasks",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:mosaic_runtime",
        "@maven_kmp//:mosaic_terminal",
    ],
    deps = ["@maven_kmp//:atomicfu"],
)

kmp_test(
    name = "test",
    associate = ":terminal",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    jvm_deps = ["@maven_kmp//:androidx_compose_runtime_desktop"],
    keep_deps = ["@maven_kmp//:androidx_compose_runtime_desktop"],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["compose"],
    deps = [
        "//app/tasks",
        "//bazel/kmp/deps:kotlin_test",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_coroutines_test",
        "@maven_kmp//:mosaic_terminal",
        "@maven_kmp//:mosaic_testing",
    ],
)
