# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web
# gazelle:kmp_plugins serialization
# gazelle:kmp_export //utils/bigdecimal
# gazelle:kmp_export @maven_kmp//:kotlinx_serialization_core

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "core",
    android = True,
    android_srcs = glob(["src/androidMain/kotlin/**/*.kt"]),
    apple_srcs = glob(["src/appleMain/kotlin/**/*.kt"]),
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    linux_srcs = glob(["src/linuxMain/kotlin/**/*.kt"]),
    mingw_srcs = glob(["src/mingwMain/kotlin/**/*.kt"]),
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    visibility = ["//visibility:public"],
    web_srcs = glob(["src/webMain/kotlin/**/*.kt"]),
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = [
        "//utils/bigdecimal",
        "@maven_kmp//:kotlinx_serialization_core",
    ],
    deps = [
        "//utils/files",
        "@maven_kmp//:kotlinx_io_core",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":core",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    web_srcs = glob(["src/webTest/kotlin/**/*.kt"]),
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = [
        "//bazel/kmp/deps:kotlin_test",
        "//utils/bigdecimal",
    ],
)
