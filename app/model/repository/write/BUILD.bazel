# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web
# Only the ImportEngine may write (CLAUDE.md, "Database Writes"): these modules define, implement or inject the
# write repositories, and app/importer is the engine.
# gazelle:kmp_visibility //app/db/core:__pkg__ //app/db/di:__pkg__ //app/db/write:__pkg__ //app/di/core:__pkg__ //app/importer:__pkg__ //test/app/db:__pkg__
# gazelle:kmp_export //app/model/accountmapping
# gazelle:kmp_export //app/model/apistrategy
# gazelle:kmp_export //app/model/core
# gazelle:kmp_export //app/model/csv
# gazelle:kmp_export //app/model/csvstrategy
# gazelle:kmp_export //app/model/importdirectory
# gazelle:kmp_export //app/model/passthrough
# gazelle:kmp_export //app/model/repository/read

load("//bazel/kmp:defs.bzl", "kmp_library")

kmp_library(
    name = "write",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = [
        "//app/db/core:__pkg__",
        "//app/db/di:__pkg__",
        "//app/db/write:__pkg__",
        "//app/di/core:__pkg__",
        "//app/importer:__pkg__",
        "//test/app/db:__pkg__",
    ],
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = [
        "//app/model/accountmapping",
        "//app/model/apistrategy",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/csvstrategy",
        "//app/model/importdirectory",
        "//app/model/passthrough",
        "//app/model/repository/read",
    ],
    deps = ["//utils/regex"],
)
