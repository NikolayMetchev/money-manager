load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

# gazelle:kmp_generate true
# gazelle:kmp_keep_dep //bazel/kmp/deps:compose_desktop_current_os jvmTest
# gazelle:kmp_test_jvm_flags -Djava.awt.headless=true -Dskiko.test.harness=true
# gazelle:kmp_test_flaky true
# gazelle:kmp_test_jvm_tags no-remote-exec

kmp_library(
    name = "timeline",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    plugins = ["compose"],
    visibility = ["//visibility:public"],
    deps = [
        "//app/model/core",
        "//app/model/repository/read",
        "//app/model/timeline",
        "//app/presenter/core",
        "//app/ui/components",
        "//app/ui/foundation",
        "@maven_kmp//:androidx_compose_runtime",
        "@maven_kmp//:compose_foundation_desktop",
        "@maven_kmp//:compose_foundation_layout_desktop",
        "@maven_kmp//:compose_material3_desktop",
        "@maven_kmp//:compose_ui_desktop",
        "@maven_kmp//:compose_ui_geometry_desktop",
        "@maven_kmp//:compose_ui_text_desktop",
        "@maven_kmp//:kotlinx_datetime",
    ],
)

kmp_test(
    name = "test",
    associate = ":timeline",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    flaky = True,
    jvm_deps = ["//bazel/kmp/deps:compose_desktop_current_os"],
    jvm_flags = [
        "-Djava.awt.headless=true",
        "-Dskiko.test.harness=true",
    ],
    jvm_tags = ["no-remote-exec"],
    keep_deps = ["//bazel/kmp/deps:compose_desktop_current_os"],
    plugins = ["compose"],
    deps = [
        "//app/model/core",
        "//app/model/repository/read",
        "//app/model/timeline",
        "//app/presenter/core",
        "//bazel/kmp/deps:kotlin_test",
        "//test/app/ui",
        "@maven_kmp//:compose_ui_test_desktop",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_datetime",
    ],
)
