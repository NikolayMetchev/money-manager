load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

# gazelle:kmp_generate true
# gazelle:kmp_test_jvm_flags -Djava.awt.headless=true -Dskiko.test.harness=true
# gazelle:kmp_test_flaky true

kmp_library(
    name = "api",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    plugins = ["compose"],
    visibility = ["//visibility:public"],
    deps = [
        "//app/apiimport",
        "//app/apiimporter",
        "//app/db/read",
        "//app/importengineapi",
        "//app/model/apistrategy",
        "//app/model/core",
        "//app/model/repository/read",
        "//app/model/rules",
        "//app/model/timeline",
        "//app/presenter/core",
        "//app/tasks",
        "//app/ui/audit",
        "//app/ui/components",
        "//app/ui/foundation",
        "//utils/bigdecimal",
        "//utils/compose/filePicker",
        "//utils/compose/scrollbar",
        "//utils/credentialvault",
        "@maven_kmp//:androidx_compose_runtime",
        "@maven_kmp//:compose_foundation_desktop",
        "@maven_kmp//:compose_foundation_layout_desktop",
        "@maven_kmp//:compose_material3_desktop",
        "@maven_kmp//:compose_material_icons_core_desktop",
        "@maven_kmp//:compose_ui_desktop",
        "@maven_kmp//:compose_ui_text_desktop",
        "@maven_kmp//:kermit",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_serialization_core",
        "@maven_kmp//:kotlinx_serialization_json",
    ],
)

kmp_test(
    name = "test",
    associate = ":api",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    flaky = True,
    jvm_flags = [
        "-Djava.awt.headless=true",
        "-Dskiko.test.harness=true",
    ],
    plugins = ["compose"],
    deps = [
        "//app/model/apistrategy",
        "//app/model/core",
        "//app/model/rules",
        "//bazel/kmp/deps:kotlin_test",
    ],
)
