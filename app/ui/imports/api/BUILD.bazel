load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

# gazelle:kmp_generate true
# gazelle:kmp_targets android
# gazelle:kmp_android_host_tests false
# gazelle:kmp_test_jvm_flags -Djava.awt.headless=true -Dskiko.test.harness=true
# gazelle:kmp_test_flaky true
# gazelle:kmp_test_jvm_tags no-remote-exec

kmp_library(
    name = "api",
    android = True,
    android_deps = [
        "@maven_kmp//:androidx_compose_material3",
        "@maven_kmp//:androidx_compose_material_icons_core",
    ],
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_deps = [
        "@maven_kmp//:compose_material3_desktop",
        "@maven_kmp//:compose_material_icons_core_desktop",
    ],
    plugins = ["compose"],
    visibility = ["//visibility:public"],
    deps = [
        "//app/apiimport",
        "//app/apiimporter",
        "//app/db/read",
        "//app/importengineapi",
        "//app/model/apistrategy",
        "//app/model/core",
        "//app/model/repository/read",
        "//app/model/rules",
        "//app/model/timeline",
        "//app/presenter/core",
        "//app/tasks",
        "//app/ui/audit",
        "//app/ui/components",
        "//app/ui/foundation",
        "//utils/bigdecimal",
        "//utils/compose/filePicker",
        "//utils/compose/scrollbar",
        "//utils/credentialvault",
        "@maven_kmp//:androidx_compose_runtime",
        "@maven_kmp//:kermit",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_serialization_core",
        "@maven_kmp//:kotlinx_serialization_json",
        "@maven_kmp//:org_jetbrains_compose_foundation_foundation",
        "@maven_kmp//:org_jetbrains_compose_foundation_foundation_layout",
        "@maven_kmp//:org_jetbrains_compose_ui_ui",
        "@maven_kmp//:org_jetbrains_compose_ui_ui_text",
    ],
)

kmp_test(
    name = "test",
    associate = ":api",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    flaky = True,
    jvm_flags = [
        "-Djava.awt.headless=true",
        "-Dskiko.test.harness=true",
    ],
    jvm_tags = ["no-remote-exec"],
    plugins = ["compose"],
    deps = [
        "//app/model/apistrategy",
        "//app/model/core",
        "//app/model/rules",
        "//bazel/kmp/deps:kotlin_test",
    ],
)
