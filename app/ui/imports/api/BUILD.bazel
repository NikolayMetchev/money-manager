        "@maven_kmp//:compose_foundation",
        "@maven_kmp//:compose_ui",
    ],
    device_manifest = "src/androidDeviceTest/AndroidManifest.xml",
    device_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    flaky = True,
    jvm_deps = ["//bazel/kmp/deps:compose_desktop_current_os"],
