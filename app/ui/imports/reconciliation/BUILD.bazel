kmp_library(
    name = "reconciliation",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    plugins = ["compose"],
    visibility = ["//visibility:public"],
    deps = [
        "//app/csvimporter",
        "//app/importengineapi",
