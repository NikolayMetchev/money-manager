    deps = [
        "//app/importengineapi",
        "//app/model/core",
        "//app/model/csvstrategy",
        "//app/model/repository/read",
        "//app/tasks",
        "//utils/archive",
        "//utils/bigdecimal",
        "//utils/credentialvault",
        "//utils/currency",
        "@maven_kmp//:androidx_compose_runtime",
        "@maven_kmp//:androidx_navigation3_runtime",
        "@maven_kmp//:androidx_savedstate",
        "@maven_kmp//:compose_foundation",
        "@maven_kmp//:compose_ui",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_datetime",
        "@maven_kmp//:kotlinx_serialization_core",
        "@maven_kmp//:org_jetbrains_compose_foundation_foundation_layout",
        "@maven_kmp//:org_jetbrains_compose_ui_ui_text",
    ],
