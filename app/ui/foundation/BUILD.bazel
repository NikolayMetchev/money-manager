kmp_test(
    name = "test",
    associate = ":foundation",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    device_deps = [
        "//app/model/core",
        "//app/model/csvstrategy",
        "//app/tasks",
