        "//test/app/ui",
        "//test/utils/credentialvault",
        "//utils/bigdecimal",
        "//utils/credentialvault",
        "@maven_kmp//:androidx_compose_material3",
        "@maven_kmp//:androidx_compose_runtime",
        "@maven_kmp//:androidx_compose_ui_test",
        "@maven_kmp//:androidx_navigation3_runtime",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_coroutines_test",
        "@maven_kmp//:kotlinx_serialization_core",
        "@maven_kmp//:kotlinx_serialization_json",
    ],
    device_manifest = "src/androidDeviceTest/AndroidManifest.xml",
