load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

# gazelle:kmp_generate true
# gazelle:kmp_targets android web
# gazelle:kmp_web_tests false
# gazelle:kmp_android_host_tests false
# gazelle:kmp_keep_dep //bazel/kmp/deps:compose_desktop_current_os jvmTest
# gazelle:kmp_test_jvm_flags -Djava.awt.headless=true -Dskiko.test.harness=true
# gazelle:kmp_test_flaky true
# gazelle:kmp_device_test_srcs src/commonTest/kotlin
# gazelle:kmp_device_test_resources src/commonTest/resources

kmp_library(
    name = "foundation",
    android = True,
    android_deps = [
        "@maven_kmp//:androidx_compose_material3",
        "@maven_kmp//:androidx_compose_material_icons_core",
    ],
    android_srcs = glob(["src/androidMain/kotlin/**/*.kt"]),
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    js_deps = [
        "@maven_kmp//:compose_material3",
        "@maven_kmp//:compose_material_icons_core",
    ],
    jvm_android_srcs = glob(["src/jvmAndroidMain/kotlin/**/*.kt"]),
    jvm_deps = [
        "//utils/localsettings",
        "@maven_kmp//:kermit",
        "@maven_kmp//:compose_material3_desktop",
        "@maven_kmp//:compose_material_icons_core_desktop",
        "@maven_kmp//:compose_ui_desktop",
    ],
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    metadata_deps = [
        "@maven_kmp//:compose_material3",
        "@maven_kmp//:compose_material_icons_core",
    ],
    plugins = [
        "compose",
        "serialization",
    ],
    visibility = ["//visibility:public"],
    wasm_js_deps = [
        "@maven_kmp//:compose_material3",
        "@maven_kmp//:compose_material_icons_core",
    ],
    web_srcs = glob(["src/webMain/kotlin/**/*.kt"]),
