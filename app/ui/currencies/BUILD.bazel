load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

# gazelle:kmp_generate true
# gazelle:kmp_targets android
# gazelle:kmp_keep_dep //bazel/kmp/deps:compose_desktop_current_os jvmTest
# gazelle:kmp_test_jvm_flags -Djava.awt.headless=true -Dskiko.test.harness=true
# gazelle:kmp_test_flaky true
# gazelle:kmp_test_jvm_tags no-remote-exec

kmp_library(
    name = "currencies",
    android = True,
    android_deps = ["@maven_kmp//:androidx_compose_material3"],
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_deps = ["@maven_kmp//:compose_material3_desktop"],
    plugins = ["compose"],
    visibility = ["//visibility:public"],
    deps = [
        "//app/importengineapi",
        "//app/model/core",
        "//app/model/repository/read",
        "//app/presenter/core",
        "//app/ui/audit",
        "//app/ui/components",
        "//app/ui/foundation",
        "//utils/compose/scrollbar",
        "@maven_kmp//:androidx_compose_runtime",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:org_jetbrains_compose_foundation_foundation",
        "@maven_kmp//:org_jetbrains_compose_foundation_foundation_layout",
        "@maven_kmp//:org_jetbrains_compose_ui_ui",
    ],
)

kmp_test(
    name = "test",
    associate = ":currencies",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    flaky = True,
    jvm_deps = ["//bazel/kmp/deps:compose_desktop_current_os"],
    jvm_flags = [
        "-Djava.awt.headless=true",
        "-Dskiko.test.harness=true",
    ],
    jvm_tags = ["no-remote-exec"],
    keep_deps = ["//bazel/kmp/deps:compose_desktop_current_os"],
    plugins = [
        "compose",
        "mokkery",
    ],
    deps = [
        "//app/model/core",
        "//app/model/repository/write:write_for_tests",
        "//app/presenter/core",
        "//bazel/kmp/deps:kotlin_test",
        "//test/app/ui",
        "@maven_kmp//:compose_ui_test_desktop",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:mokkery_core",
        "@maven_kmp//:mokkery_runtime",
    ],
)
