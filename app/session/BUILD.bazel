load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "session",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    exports = [
        "//app/apiimport",
        "//app/db/core",
        "//app/db/di",
        "//app/db/write",
        "//app/importdirectory",
        "//app/importengineapi",
        "//app/importfilesource/core",
        "//app/model/core",
        "//app/model/importdirectory",
        "//app/remotestorage/sync",
        "//app/tasks",
        "//utils/credentialvault",
        "//utils/localsettings",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:ktor_client_core",
    ],
    deps = ["@maven_kmp//:kermit"],
)

kmp_test(
    name = "test",
    associate = ":session",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    deps = [
        "//app/db/core",
        "//app/importengineapi",
        "//app/model/core",
        "//app/remotestorage/core",
        "//app/remotestorage/sync",
        "//bazel/kmp/deps:kotlin_test",
        "//test/app/db",
        "//test/app/remotestorage",
        "//test/utils/credentialvault",
        "//utils/credentialvault",
        "//utils/localsettings",
        "@maven_kmp//:kotlinx_coroutines_test",
    ],
)
