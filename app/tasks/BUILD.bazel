# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64
# gazelle:kmp_forbid_deps //app/db/core //app/di/core //app/ui/core
# gazelle:kmp_export @maven_kmp//:kotlinx_coroutines_core

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "tasks",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    exports = ["@maven_kmp//:kotlinx_coroutines_core"],
    deps = ["@maven_kmp//:kermit"],
)

kmp_test(
    name = "test",
    associate = ":tasks",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    deps = [
        "//bazel/kmp/deps:kotlin_test",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_coroutines_test",
    ],
)
