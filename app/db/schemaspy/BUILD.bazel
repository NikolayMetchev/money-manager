load("@rules_java//java:java_binary.bzl", "java_binary")
load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")
load("//bazel/pages:pages.bzl", "schemaspy_docs")

# gazelle:kmp_generate true

kmp_library(
    name = "schemaspy",
    jvm_deps = [
        "//app/db/core",
        "//app/model/core",
    ],
    jvm_srcs = glob(["src/main/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
)

# app/db/schemaspy's publishSchemaSpyDocs (#1027): the schema in a fresh database, documented by SchemaSpy.
# It needs Graphviz's `dot` on the PATH, so it isn't part of `bazel build //...` (static.yml builds it).
java_binary(
    name = "database_creator",
    main_class = "com.moneymanager.schemaspy.SchemaSpyDatabaseCreatorKt",
    runtime_deps = [":schemaspy_jvm"],
)

java_binary(
    name = "schemaspy_main",
    main_class = "org.schemaspy.Main",
    runtime_deps = [
        "@schemaspy//:org_schemaspy_schemaspy",
        "@schemaspy//:org_xerial_sqlite_jdbc",
    ],
)

schemaspy_docs(
    name = "docs",
    database_creator = ":database_creator",
    schemaspy = ":schemaspy_main",
    tags = ["manual"],
    visibility = ["//webpage:__pkg__"],
)

kmp_test(
    name = "test",
    associate = ":schemaspy",
    jvm_deps = [
        "//bazel/kmp/deps:kotlin_test",
        "@maven_kmp//:kotlinx_coroutines_test",
    ],
    jvm_srcs = glob(["src/test/kotlin/**/*.kt"]),
)
