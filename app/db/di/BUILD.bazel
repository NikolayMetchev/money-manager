# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64
# gazelle:kmp_plugins metro
# gazelle:kmp_export //app/db/core
# gazelle:kmp_export //app/db/write
# gazelle:kmp_export //app/di/params
# gazelle:kmp_export //app/di/scope
# gazelle:kmp_export //app/importengineapi
# gazelle:kmp_export //app/importer
# gazelle:kmp_export //app/model/core
# gazelle:kmp_export //app/model/csvstrategy
# gazelle:kmp_export //app/model/repository/read
# gazelle:kmp_export //app/model/repository/write

load("//bazel/kmp:defs.bzl", "kmp_library")

kmp_library(
    name = "di",
    android = True,
    android_srcs = glob(["src/androidMain/kotlin/**/*.kt"]),
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["metro"],
    visibility = ["//visibility:public"],
    exports = [
        "//app/db/core",
        "//app/db/write",
        "//app/di/params",
        "//app/di/scope",
        "//app/importengineapi",
        "//app/importer",
        "//app/model/core",
        "//app/model/csvstrategy",
        "//app/model/repository/read",
        "//app/model/repository/write",
    ],
    deps = [
        "//app/db/repository",
        "@maven_kmp//:metro_runtime",
    ],
)
