# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64
# gazelle:kmp_plugins mappie serialization
# gazelle:kmp_sqldelight_package com.moneymanager.database.sql.read
# gazelle:kmp_sqldelight_dep //app/db/schema:sqldelight
# gazelle:kmp_export //app/db/schema
# gazelle:kmp_export //app/model/accountmapping
# gazelle:kmp_export //app/model/apistrategy
# gazelle:kmp_export //app/model/core
# gazelle:kmp_export //app/model/csvstrategy
# gazelle:kmp_export //app/model/passthrough
# gazelle:kmp_export @maven_kmp//:kotlinx_serialization_core
# gazelle:kmp_export @maven_kmp//:mappie_api

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")
load("//bazel/kmp/sqldelight:sqldelight.bzl", "sqldelight_library")

sqldelight_library(
    name = "sqldelight",
    srcs = glob(["src/commonMain/sqldelight/**/*.sq"]),
    module_name = "read",
    package = "com.moneymanager.database.sql.read",
    visibility = ["//visibility:public"],
    deps = ["//app/db/schema:sqldelight"],
)

kmp_library(
    name = "read",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = [
        "mappie",
        "serialization",
    ],
    sqldelight = ":sqldelight",
    visibility = ["//visibility:public"],
    exports = [
        "//app/db/schema",
        "//app/model/accountmapping",
        "//app/model/apistrategy",
        "//app/model/core",
        "//app/model/csvstrategy",
        "//app/model/passthrough",
        "@maven_kmp//:kotlinx_serialization_core",
        "@maven_kmp//:mappie_api",
    ],
    deps = [
        "//utils/bigdecimal",
        "@maven_kmp//:kotlinx_serialization_json",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":read",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    jvm_deps = [
        "//app/model/passthrough",
        "//bazel/kmp/deps:kotlin_reflect",
        "@maven_kmp//:kotlinx_serialization_core",
    ],
    jvm_srcs = glob(["src/jvmTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = [
        "mappie",
        "serialization",
    ],
    deps = [
        "//app/model/accountmapping",
        "//app/model/apistrategy",
        "//app/model/core",
        "//app/model/csvstrategy",
        "//app/model/rules",
        "//bazel/kmp/deps:kotlin_test",
    ],
)
