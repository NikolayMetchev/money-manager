-- The `transfer.* + asset_details.*` projection these queries share lives in the `transfer_with_asset`
-- view (:app:db:schema, Transfer.sq), so each query below is only its predicate and ordering.

selectById:
SELECT * FROM transfer_with_asset
WHERE id = ?;

selectByIds:
SELECT * FROM transfer_with_asset
WHERE id IN ?;

selectByAccount:
SELECT * FROM transfer_with_asset
WHERE source_account_id = ? OR target_account_id = ?
ORDER BY timestamp DESC;

selectByDateRange:
SELECT * FROM transfer_with_asset
WHERE timestamp >= ? AND timestamp <= ?
ORDER BY timestamp DESC;

selectByAccountAndDateRange:
SELECT * FROM transfer_with_asset
WHERE (source_account_id = ? OR target_account_id = ?)
AND timestamp >= ? AND timestamp <= ?
ORDER BY timestamp DESC;

selectAllBalances:
SELECT
    account_balance_materialized_view.account_id,
    account_balance_materialized_view.asset_id,
    account_balance_materialized_view.balance,
    asset_details.code AS asset_code,
    asset_details.name AS asset_name,
    asset_details.scale_factor AS asset_scale_factor,
    asset_details.kind AS asset_kind
FROM account_balance_materialized_view
JOIN account ON account_balance_materialized_view.account_id = account.id
JOIN asset_details ON account_balance_materialized_view.asset_id = asset_details.id
ORDER BY asset_details.code, account.name;

-- The three paginated account-transaction queries below all read the `account_row_source` view
-- (:app:db:schema, Transfer.sq) and differ only in their cursor predicate and ordering. They are kept
-- as three separate statements on purpose: folding the cursors into one guarded-predicate query risks
-- SQLite dropping the (account_id, timestamp) index on this scroll-critical path.

selectRunningBalanceByAccountPaginated:
SELECT * FROM account_row_source
WHERE account_id = :accountId
  AND (:currencyId IS NULL OR asset_id = :currencyId)
  AND ((:lastTimestamp IS NULL AND :lastId IS NULL)
       OR timestamp < :lastTimestamp
       OR (timestamp = :lastTimestamp AND id < :lastId))
ORDER BY timestamp DESC, id DESC
LIMIT :limit;

-- Load earlier transactions (backward pagination - items newer than the current first item)
-- Results are returned in ASC order (oldest first), must be reversed in code
selectRunningBalanceByAccountPaginatedBackward:
SELECT * FROM account_row_source
WHERE account_id = :accountId
  AND (:currencyId IS NULL OR asset_id = :currencyId)
  AND (timestamp > :firstTimestamp
       OR (timestamp = :firstTimestamp AND id > :firstId))
ORDER BY timestamp ASC, id ASC
LIMIT :limit;

-- Get the row position (0-indexed) of a transaction within an account's transaction list
-- Returns the count of transactions that come BEFORE this one (i.e., have higher timestamp or same timestamp but higher id)
getTransactionRowPosition:
SELECT COUNT(*)
FROM running_balance_materialized_view
WHERE account_id = :accountId
  AND (:currencyId IS NULL OR asset_id = :currencyId)
  AND (timestamp > :targetTimestamp
       OR (timestamp = :targetTimestamp AND id > :targetId));

-- Load transactions for an account with offset-based pagination
selectRunningBalanceByAccountOffset:
SELECT * FROM account_row_source
WHERE account_id = :accountId
  AND (:currencyId IS NULL OR asset_id = :currencyId)
ORDER BY timestamp DESC, id DESC
LIMIT :limit OFFSET :offset;

-- Get total count of transactions for an account
countTransactionsByAccount:
SELECT COUNT(*)
FROM running_balance_materialized_view
WHERE account_id = :accountId
  AND (:currencyId IS NULL OR asset_id = :currencyId);

countTransfersByAccount:
SELECT COUNT(*)
FROM transfer
WHERE source_account_id = :accountId OR target_account_id = :accountId;

-- Which of the given accounts appear on either side of any transfer (batch emptiness check).
selectAccountsWithTransfers:
SELECT DISTINCT source_account_id AS account_id FROM transfer WHERE source_account_id IN :accountIds
UNION
SELECT DISTINCT target_account_id FROM transfer WHERE target_account_id IN :accountIds;

selectTransfersBetweenAccounts:
SELECT * FROM transfer_with_asset
WHERE (source_account_id = :accountA AND target_account_id = :accountB)
   OR (source_account_id = :accountB AND target_account_id = :accountA)
ORDER BY timestamp DESC;

-- Candidate originals for reversal (refund/cancellation) links: transfers touching any of the given
-- accounts with one of the given amounts, not yet reversed (never id2 of a :reversalTypeId
-- relationship), newest first. The import engine loads these once per batch (every pass-through
-- spend leg has a conduit endpoint) and pairs legs with charges in memory.
selectUnreversedTransfersTouchingAccounts:
SELECT * FROM transfer_with_asset
WHERE (source_account_id IN :accountIds OR target_account_id IN :accountIds)
  AND amount IN :amounts
  AND timestamp <= :maxTimestamp
  AND NOT EXISTS (
      SELECT 1 FROM transfer_relationship
      WHERE transfer_relationship.id2 = transfer_with_asset.id
        AND transfer_relationship.relationship_type_id = :reversalTypeId
  )
ORDER BY timestamp DESC, id DESC;

-- Current revision of a single transfer, for recording its source after a merge/unmerge reassignment.
selectRevisionById:
SELECT revision_id FROM transfer WHERE id = ?;

-- Captured before a merge moves them, so unmerge can move back exactly the affected transfers.
selectTransferIdsBySourceAccount:
SELECT id FROM transfer WHERE source_account_id = ?;

selectTransferIdsByTargetAccount:
SELECT id FROM transfer WHERE target_account_id = ?;

-- Transfers whose match attribute fits the LIKE pattern but for which no transfer
-- carries the link attribute with the same value (companion transaction missing).
selectTransfersMissingCompanion:
SELECT
    transfer.id,
    transfer.timestamp,
    transfer.description,
    transfer.amount,
    match_attr.attribute_value AS match_value,
    source_account.id AS source_account_id,
    source_account.name AS source_account_name,
    target_account.id AS target_account_id,
    target_account.name AS target_account_name,
    asset_details.id AS asset_id,
    asset_details.code AS asset_code,
    asset_details.name AS asset_name,
    asset_details.scale_factor AS asset_scale_factor,
    asset_details.kind AS asset_kind
FROM transfer
JOIN transfer_attribute match_attr ON match_attr.transaction_id = transfer.id
JOIN attribute_type match_type ON match_attr.attribute_type_id = match_type.id
JOIN account source_account ON transfer.source_account_id = source_account.id
JOIN account target_account ON transfer.target_account_id = target_account.id
JOIN asset_details ON transfer.asset_id = asset_details.id
WHERE match_type.name = :matchAttributeName
  AND match_attr.attribute_value LIKE :matchValuePattern
  AND NOT EXISTS (
    SELECT 1
    FROM transfer_attribute link_attr
    JOIN attribute_type link_type ON link_attr.attribute_type_id = link_type.id
    WHERE link_type.name = :linkAttributeName
      AND link_attr.attribute_value = match_attr.attribute_value
  )
ORDER BY transfer.timestamp DESC, transfer.id DESC;
