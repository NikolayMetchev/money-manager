selectHeaderById:
SELECT observation.id, observation.transaction_id, observation.kind, observation_owner.owner_kind, observation_owner.owner_id, observation_owner.slot
FROM observation
JOIN observation_owner ON observation_owner.observation_id = observation.id
WHERE observation.id = ?;

selectHeadersByOwner:
SELECT observation.id, observation.transaction_id, observation.kind, observation_owner.owner_kind, observation_owner.owner_id, observation_owner.slot
FROM observation
JOIN observation_owner ON observation_owner.observation_id = observation.id
WHERE observation_owner.owner_kind = ? AND observation_owner.owner_id = ?
ORDER BY observation_owner.slot;

selectHeadersByTransaction:
SELECT observation.id, observation.transaction_id, observation.kind, observation_owner.owner_kind, observation_owner.owner_id, observation_owner.slot
FROM observation
JOIN observation_owner ON observation_owner.observation_id = observation.id
WHERE observation.transaction_id = ?
ORDER BY observation.id;

-- Every observation naming one of :accountIds, by id: the stored observations a match over those accounts may pair.
selectHeadersOnAccounts:
SELECT observation.id, observation.transaction_id, observation.kind, observation_owner.owner_kind, observation_owner.owner_id, observation_owner.slot
FROM observation
JOIN observation_owner ON observation_owner.observation_id = observation.id
WHERE observation.id IN (
  SELECT observation_id FROM transfer_observation WHERE source_account_id IN :accountIds OR target_account_id IN :accountIds
  UNION
  SELECT observation_id FROM trade_observation WHERE from_account_id IN :accountIds OR to_account_id IN :accountIds
)
ORDER BY observation.id;

selectTransferValues:
SELECT * FROM transfer_observation WHERE observation_id = ?;

selectTradeValues:
SELECT * FROM trade_observation WHERE observation_id = ?;

selectAttributes:
SELECT attribute_type_id, group_key, attribute_value
FROM observation_attribute
WHERE observation_id = ?
ORDER BY attribute_type_id, group_key;

countApproximateTime:
SELECT COUNT(*) FROM observation_approximate_time WHERE observation_id = ?;

selectPlaceholderEnds:
SELECT end_name FROM observation_placeholder_end WHERE observation_id = ? ORDER BY end_name;

countGrossAmount:
SELECT COUNT(*) FROM observation_gross_amount WHERE observation_id = ?;

selectOwnEnd:
SELECT end_name FROM observation_own_end WHERE observation_id = ?;

selectKind:
SELECT kind FROM observation WHERE id = ?;

-- Observations that would join an account to itself once one of the two is merged into the other: a transfer
-- between them, or a trade between them in one asset.
countObservationsBetweenAccounts:
SELECT
  (SELECT COUNT(*) FROM transfer_observation
   WHERE (source_account_id = :accountA AND target_account_id = :accountB)
      OR (source_account_id = :accountB AND target_account_id = :accountA))
  + (SELECT COUNT(*) FROM trade_observation
     WHERE from_asset_id = to_asset_id
       AND ((from_account_id = :accountA AND to_account_id = :accountB)
         OR (from_account_id = :accountB AND to_account_id = :accountA)));

-- The accounts among :accountIds that some observation names.
selectAccountsWithObservations:
SELECT source_account_id AS account_id FROM transfer_observation WHERE source_account_id IN :accountIds
UNION
SELECT target_account_id FROM transfer_observation WHERE target_account_id IN :accountIds
UNION
SELECT from_account_id FROM trade_observation WHERE from_account_id IN :accountIds
UNION
SELECT to_account_id FROM trade_observation WHERE to_account_id IN :accountIds;

-- A transaction's materialized row and attributes, as the materializer compares them with its observations' merge.
selectMaterializedTransfer:
SELECT timestamp, description, source_account_id, target_account_id, asset_id, amount FROM transfer WHERE id = ?;

selectMaterializedTransferAttributes:
SELECT attribute_type_id, group_key, attribute_value FROM transfer_attribute WHERE transaction_id = ?;

selectMaterializedTrade:
SELECT timestamp, description, from_account_id, from_asset_id, from_amount, to_account_id, to_asset_id, to_amount
FROM trade WHERE id = ?;

selectMaterializedTradeAttributes:
SELECT attribute_type_id, attribute_value FROM trade_attribute WHERE trade_id = ?;

-- The transactions the records of one staged file observe, with each one's kind, that a staged file or the match
-- created (source types 2 and 10): those unimporting the file withdraws its observations from, and deletes once nothing
-- else observes them. One a person, an API session or a reconciliation copy created stays theirs.
selectTransactionsObservedByCsvImport:
SELECT DISTINCT observation.transaction_id, observation.kind
FROM observation
JOIN observation_owner ON observation_owner.observation_id = observation.id
WHERE (
    (
      observation_owner.owner_kind = 'RECORD'
      AND observation_owner.owner_id IN (SELECT record_id FROM csv_import_record WHERE csv_import_id = :csvImportId)
    )
    OR (
      observation_owner.owner_kind = 'GROUP'
      AND observation_owner.owner_id IN (
        SELECT import_group_member.group_id FROM import_group_member
        JOIN csv_import_record ON csv_import_record.record_id = import_group_member.record_id
        WHERE csv_import_record.csv_import_id = :csvImportId
      )
    )
  )
  AND EXISTS (
    SELECT 1 FROM entity_source
    WHERE entity_source.entity_type_id = CASE observation.kind WHEN 'TRADE' THEN 11 ELSE 7 END
      AND entity_source.entity_id = observation.transaction_id
      AND entity_source.revision_id = 1
      AND entity_source.matched = 0
      AND entity_source.source_type_id IN (2, 10)
  );

-- Which of :transactionIds something other than the staged files :csvImportIds still observes: a record of another
-- file or API session, a person (a transaction made by hand), or a leg group none of whose records those files hold: a
-- group says what its records say together, so it stops saying it once one of them is withdrawn.
selectTransactionsObservedOutsideCsvImports:
SELECT DISTINCT observation.transaction_id
FROM observation
JOIN observation_owner ON observation_owner.observation_id = observation.id
WHERE observation.transaction_id IN :transactionIds
  AND (
    observation_owner.owner_kind = 'MANUAL'
    OR (
      observation_owner.owner_kind = 'RECORD'
      AND observation_owner.owner_id NOT IN (SELECT record_id FROM csv_import_record WHERE csv_import_id IN :csvImportIds)
    )
    OR (
      observation_owner.owner_kind = 'GROUP'
      AND EXISTS (SELECT 1 FROM import_group_member WHERE import_group_member.group_id = observation_owner.owner_id)
      AND NOT EXISTS (
        SELECT 1 FROM import_group_member
        WHERE import_group_member.group_id = observation_owner.owner_id
          AND import_group_member.record_id IN (SELECT record_id FROM csv_import_record WHERE csv_import_id IN :csvImportIds)
      )
    )
  );

-- The values, attributes and facts of every observation naming one of :accountIds, each in one query (#1433): a match
-- scope's observations load in a fixed number of queries rather than several per observation.
selectTransferValuesOnAccounts:
SELECT * FROM transfer_observation
WHERE source_account_id IN :accountIds OR target_account_id IN :accountIds;

selectTradeValuesOnAccounts:
SELECT * FROM trade_observation
WHERE from_account_id IN :accountIds OR to_account_id IN :accountIds;

selectAttributesOnAccounts:
SELECT observation_id, attribute_type_id, group_key, attribute_value
FROM observation_attribute
WHERE observation_id IN (
  SELECT observation_id FROM transfer_observation WHERE source_account_id IN :accountIds OR target_account_id IN :accountIds
  UNION
  SELECT observation_id FROM trade_observation WHERE from_account_id IN :accountIds OR to_account_id IN :accountIds
)
ORDER BY observation_id, attribute_type_id, group_key;

selectApproximateTimeOnAccounts:
SELECT observation_id FROM observation_approximate_time
WHERE observation_id IN (
  SELECT observation_id FROM transfer_observation WHERE source_account_id IN :accountIds OR target_account_id IN :accountIds
  UNION
  SELECT observation_id FROM trade_observation WHERE from_account_id IN :accountIds OR to_account_id IN :accountIds
);

selectPlaceholderEndsOnAccounts:
SELECT observation_id, end_name FROM observation_placeholder_end
WHERE observation_id IN (
  SELECT observation_id FROM transfer_observation WHERE source_account_id IN :accountIds OR target_account_id IN :accountIds
  UNION
  SELECT observation_id FROM trade_observation WHERE from_account_id IN :accountIds OR to_account_id IN :accountIds
)
ORDER BY observation_id, end_name;

selectGrossAmountOnAccounts:
SELECT observation_id FROM observation_gross_amount
WHERE observation_id IN (
  SELECT observation_id FROM transfer_observation WHERE source_account_id IN :accountIds OR target_account_id IN :accountIds
  UNION
  SELECT observation_id FROM trade_observation WHERE from_account_id IN :accountIds OR to_account_id IN :accountIds
);

selectOwnEndsOnAccounts:
SELECT observation_id, end_name FROM observation_own_end
WHERE observation_id IN (
  SELECT observation_id FROM transfer_observation WHERE source_account_id IN :accountIds OR target_account_id IN :accountIds
  UNION
  SELECT observation_id FROM trade_observation WHERE from_account_id IN :accountIds OR to_account_id IN :accountIds
);
