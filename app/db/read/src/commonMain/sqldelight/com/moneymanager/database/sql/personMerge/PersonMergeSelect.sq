selectReversible:
SELECT * FROM person_merge WHERE reversed = 0 ORDER BY id DESC;

selectById:
SELECT * FROM person_merge WHERE id = ?;

selectBySurvivingPerson:
SELECT * FROM person_merge WHERE surviving_person_id = ? ORDER BY id DESC;

selectByDeletedPerson:
SELECT * FROM person_merge WHERE deleted_person_id = ? ORDER BY id DESC;

selectOwnershipsForMerge:
SELECT account_id, grafted FROM person_merge_ownership WHERE merge_id = ?;

selectAttributesForMerge:
SELECT attribute_type_id, attribute_value, group_key, grafted FROM person_merge_attribute WHERE merge_id = ?;

selectAliasesForMerge:
SELECT name_key, kind FROM person_merge_alias WHERE merge_id = ?;
