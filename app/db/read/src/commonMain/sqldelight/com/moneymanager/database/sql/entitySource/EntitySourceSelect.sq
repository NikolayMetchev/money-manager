-- The "created by" queries below start from the per-source table (`csv_entity_source` etc.), whose import index
-- narrows to one file's rows, and CROSS JOIN fixes that order: without statistics (nothing runs ANALYZE) SQLite
-- otherwise drives them from entity_source's entity-type index and walks every row of the type, ~4x slower on a
-- real database whatever the file's size.

-- Accounts (entity_type_id = 1) whose creation was recorded against the given CSV import — the
-- accounts the import auto-created, used by re-import to scope merges/deletes to them.
selectAccountIdsCreatedByCsvImport:
SELECT DISTINCT entity_source.entity_id
FROM csv_entity_source
CROSS JOIN entity_source ON entity_source.id = csv_entity_source.id
WHERE csv_entity_source.csv_import_id = ? AND entity_source.entity_type_id = 1;

-- Transfers (entity_type_id = 7) created (not merely updated) by the given CSV import, still-existing
-- only: revision_id = 1 is the creating write, so a transfer another file created and this one only
-- UPDATED is excluded, and the join against `transfer` skips ids a prior pass already deleted
-- (entity_source is never cascade-cleaned). Fee and pass-through legs carry the same CSV source. Used by
-- unimport to find everything the file produced.
selectTransferIdsCreatedByCsvImport:
SELECT DISTINCT entity_source.entity_id
FROM csv_entity_source
CROSS JOIN entity_source ON entity_source.id = csv_entity_source.id
JOIN transfer ON transfer.id = entity_source.entity_id
WHERE csv_entity_source.csv_import_id = ?
  AND entity_source.entity_type_id = 7
  AND entity_source.revision_id = 1
  AND entity_source.matched = 0;

-- The account whose statement (or API feed) each of the given transfers came from: their creating records' own accounts.
selectStatementAccountsOfTransfers:
SELECT entity_source.entity_id, entity_source_statement_account.account_id
FROM entity_source
CROSS JOIN entity_source_statement_account ON entity_source_statement_account.entity_source_id = entity_source.id
WHERE entity_source.entity_id IN ?
  AND entity_source.entity_type_id = 7
  AND entity_source.revision_id = 1
  AND entity_source.matched = 0;

-- Trades (entity_type_id = 11) created by the given CSV import, still-existing only — see
-- selectTransferIdsCreatedByCsvImport.
selectTradeIdsCreatedByCsvImport:
SELECT DISTINCT entity_source.entity_id
FROM csv_entity_source
CROSS JOIN entity_source ON entity_source.id = csv_entity_source.id
JOIN trade ON trade.id = entity_source.entity_id
WHERE csv_entity_source.csv_import_id = ?
  AND entity_source.entity_type_id = 11
  AND entity_source.revision_id = 1
  AND entity_source.matched = 0;

-- Accounts (entity_type_id = 1) created (not merely touched) by the given API session — revision_id = 1
-- means the entity's creating write is still its only recorded revision. Joined against `account` so a
-- row whose account a PRIOR re-import already deleted (entity_source is never cascade-cleaned) doesn't
-- resurface. Used by API re-import to scope deletes/cleanup to what the session itself produced.
selectAccountIdsCreatedByApiSession:
SELECT DISTINCT entity_source.entity_id
FROM api_entity_source
CROSS JOIN entity_source ON entity_source.id = api_entity_source.id
JOIN account ON account.id = entity_source.entity_id
WHERE api_entity_source.api_session_id = ?
  AND entity_source.entity_type_id = 1
  AND entity_source.revision_id = 1;

-- Transfers (entity_type_id = 7) created by the given API session, still-existing only — see
-- selectAccountIdsCreatedByApiSession for why the join against `transfer` matters: re-importing the
-- same session more than once must not keep re-discovering ids a prior pass already deleted.
selectTransferIdsCreatedByApiSession:
SELECT DISTINCT entity_source.entity_id
FROM api_entity_source
CROSS JOIN entity_source ON entity_source.id = api_entity_source.id
JOIN transfer ON transfer.id = entity_source.entity_id
WHERE api_entity_source.api_session_id = ?
  AND entity_source.entity_type_id = 7
  AND entity_source.revision_id = 1;

-- Trades (entity_type_id = 11) created by the given API session, still-existing only — see
-- selectAccountIdsCreatedByApiSession for why the join against `trade` matters.
selectTradeIdsCreatedByApiSession:
SELECT DISTINCT entity_source.entity_id
FROM api_entity_source
CROSS JOIN entity_source ON entity_source.id = api_entity_source.id
JOIN trade ON trade.id = entity_source.entity_id
WHERE api_entity_source.api_session_id = ?
  AND entity_source.entity_type_id = 11
  AND entity_source.revision_id = 1;

selectEntitySourceForRevision:
SELECT id, source_type_id
FROM entity_source
WHERE entity_type_id = ?
  AND entity_id = ?
  AND revision_id = ?
  AND matched = 0;

selectApiEntitySourceId:
SELECT id
FROM api_entity_source
WHERE id = ?;

-- Every recorded source for one entity, newest revision first.
--
-- The single shared source read: audit history and the transfer source screens both use it instead
-- of repeating this join (and its flat column list) once per entity type. Callers key the result by
-- (entity_id, revision_id) -- idx_entity_source_writer (one writer per revision) makes that pairing
-- exact, so attaching in memory matches what a LEFT JOIN on those columns produced.
--
-- Deliberately one entity per call rather than `entity_id IN :ids`: a dynamic IN list is not a
-- statically cacheable statement, and re-import calls this once per transfer in a loop.
selectEntitySources:
SELECT
    entity_source.id,
    entity_source.entity_id,
    entity_source.revision_id,
    entity_source.device_id,
    source_type.name AS source_type,
    entity_source.created_at,
    device_view.platform_name,
    device_view.os_name,
    device_view.machine_name,
    device_view.device_make,
    device_view.device_model,
    csv_entity_source.csv_import_id,
    csv_entity_source.csv_row_index,
    csv_import_metadata.original_file_name AS csv_file_name,
    api_entity_source.api_session_id,
    api_entity_source.api_request_id,
    api_entity_source.json_path AS api_json_path
FROM entity_source
JOIN source_type ON entity_source.source_type_id = source_type.id
JOIN device_view ON entity_source.device_id = device_view.id
LEFT JOIN csv_entity_source ON entity_source.id = csv_entity_source.id
LEFT JOIN csv_import_metadata ON csv_entity_source.csv_import_id = csv_import_metadata.id
LEFT JOIN api_entity_source ON entity_source.id = api_entity_source.id
WHERE entity_source.entity_type_id = :entityTypeId AND entity_source.entity_id = :entityId
  AND entity_source.matched = 0
ORDER BY entity_source.revision_id DESC;

-- Still-existing transfers (entity_type_id = 7) a CSV import created, with the row each came from.
-- A row can create several (fee and pass-through legs). Re-import uses it to find the transfer a
-- re-run created from the same row as a hand-edited one it deleted, to re-apply the edit there.
selectCreatedTransferRowsByCsvImport:
SELECT entity_source.entity_id, csv_entity_source.csv_row_index
FROM csv_entity_source
CROSS JOIN entity_source ON entity_source.id = csv_entity_source.id
JOIN transfer ON transfer.id = entity_source.entity_id
WHERE csv_entity_source.csv_import_id = ?
  AND entity_source.entity_type_id = 7
  AND entity_source.revision_id = 1
  AND entity_source.matched = 0;

-- The API analogue of selectCreatedTransferRowsByCsvImport: a record is a response node.
selectCreatedTransferNodesByApiSession:
SELECT entity_source.entity_id, api_entity_source.api_request_id, api_entity_source.json_path
FROM api_entity_source
CROSS JOIN entity_source ON entity_source.id = api_entity_source.id
JOIN transfer ON transfer.id = entity_source.entity_id
WHERE api_entity_source.api_session_id = ?
  AND entity_source.entity_type_id = 7
  AND entity_source.revision_id = 1;

-- The trade analogues of the two queries above. A trade assembled from several rows was created by each of
-- them; ordered so a caller can take the first row as the trade's record, the same one on every run.
selectCreatedTradeRowsByCsvImport:
SELECT entity_source.entity_id, csv_entity_source.csv_row_index
FROM csv_entity_source
CROSS JOIN entity_source ON entity_source.id = csv_entity_source.id
JOIN trade ON trade.id = entity_source.entity_id
WHERE csv_entity_source.csv_import_id = ?
  AND entity_source.entity_type_id = 11
  AND entity_source.revision_id = 1
  AND entity_source.matched = 0
ORDER BY entity_source.id;

selectCreatedTradeNodesByApiSession:
SELECT entity_source.entity_id, api_entity_source.api_request_id, api_entity_source.json_path
FROM api_entity_source
CROSS JOIN entity_source ON entity_source.id = api_entity_source.id
JOIN trade ON trade.id = entity_source.entity_id
WHERE api_entity_source.api_session_id = ?
  AND entity_source.entity_type_id = 11
  AND entity_source.revision_id = 1
ORDER BY entity_source.id;

-- Transfers among the given ids that a person has edited by hand since they were created: a later
-- revision recorded with the MANUAL source (source_type_id = 1).
selectHandEditedTransferIds:
SELECT DISTINCT entity_id
FROM entity_source
WHERE entity_type_id = 7
  AND source_type_id = 1
  AND revision_id > 1
  AND entity_id IN ?;

-- The CSV rows whose current link is one of the given transfers or trades (they share one id space) without
-- having written it: their matched entries, which mirror those links exactly (see recordMatchedSource).
selectImportRecordsMatchedTo:
SELECT csv_entity_source.csv_import_id AS import_id, csv_entity_source.csv_row_index AS record_index
FROM entity_source
CROSS JOIN csv_entity_source ON csv_entity_source.id = entity_source.id
WHERE entity_source.entity_type_id IN (7, 11)
  AND entity_source.entity_id IN :transactionIds
  AND entity_source.matched = 1
  AND csv_entity_source.csv_row_index IS NOT NULL;

-- The matched entries of the given rows of one CSV import, or of all its rows; see forgetMatchedSources.
selectMatchedCsvSourceIds:
SELECT csv_entity_source.id
FROM csv_entity_source
CROSS JOIN entity_source ON entity_source.id = csv_entity_source.id
WHERE csv_entity_source.csv_import_id = ?
  AND csv_entity_source.csv_row_index IN ?
  AND entity_source.matched = 1;

selectAllMatchedCsvSourceIds:
SELECT csv_entity_source.id
FROM csv_entity_source
CROSS JOIN entity_source ON entity_source.id = csv_entity_source.id
WHERE csv_entity_source.csv_import_id = ?
  AND entity_source.matched = 1;

-- Every staged file a re-import of the given files and API sessions takes along, with the given files themselves:
-- the closure of "depends on what it created". A file depends on a transaction another file or session created when
-- one of its rows matched it (a matched entry), or when it created a transfer reconciled against it that the
-- deletion would leave hidden (excluded as 'reconciled') or that took an end from it (the pair's primary, on other
-- accounts: ImportDeduper.otherSideOf). A partner reconciled against several transfers joins once any of them goes,
-- which only re-imports its file. Only staged files are ever taken along: an API session's partners are un-hidden.
selectRerunClosure:
WITH RECURSIVE
dependant AS (
    SELECT e.entity_id AS transaction_id, c.csv_import_id AS import_id
    FROM entity_source e
    CROSS JOIN csv_entity_source c ON c.id = e.id
    WHERE e.entity_type_id IN (7, 11)
      AND e.matched = 1
      AND c.csv_row_index IS NOT NULL
    UNION ALL
    SELECT mine.transaction_id, c.csv_import_id
    FROM relationship r
    CROSS JOIN relationship_member mine ON mine.relationship_id = r.id
    CROSS JOIN relationship_member other ON other.relationship_id = r.id AND other.transaction_id <> mine.transaction_id
    CROSS JOIN transfer kept ON kept.id = other.transaction_id
    CROSS JOIN transfer lent ON lent.id = mine.transaction_id
    CROSS JOIN entity_source e ON e.entity_type_id = 7 AND e.entity_id = other.transaction_id AND e.revision_id = 1 AND e.matched = 0
    CROSS JOIN csv_entity_source c ON c.id = e.id
    WHERE r.relationship_type_id = 1
      AND (
        other.transaction_id IN (
            SELECT transaction_id FROM transfer_attribute WHERE attribute_type_id = -1 AND attribute_value = 'reconciled'
        )
        OR (
            other.role = 0 AND mine.role = 1
            -- On other accounts: neither the same pair nor the same pair reversed.
            AND (kept.source_account_id <> lent.source_account_id OR kept.target_account_id <> lent.target_account_id)
            AND (kept.source_account_id <> lent.target_account_id OR kept.target_account_id <> lent.source_account_id)
        )
      )
),
seed AS (
    SELECT id AS import_id FROM csv_import_metadata WHERE id IN :importIds
    UNION
    SELECT dependant.import_id
    FROM api_entity_source a
    CROSS JOIN entity_source e ON e.id = a.id
    JOIN dependant ON dependant.transaction_id = e.entity_id
    WHERE a.api_session_id IN :sessionIds
      AND e.entity_type_id IN (7, 11)
      AND e.revision_id = 1
),
closure AS (
    SELECT import_id FROM seed
    UNION
    SELECT dependant.import_id
    FROM closure
    CROSS JOIN csv_entity_source c ON c.csv_import_id = closure.import_id
    CROSS JOIN entity_source e ON e.id = c.id
    JOIN dependant ON dependant.transaction_id = e.entity_id
    WHERE e.entity_type_id IN (7, 11)
      AND e.revision_id = 1
      AND e.matched = 0
)
SELECT import_id FROM closure;
