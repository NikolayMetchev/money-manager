-- Every account and asset some statement reports balances for, with how many there are and the latest one's instant.
selectAccountAssets:
SELECT
    rb.account_id,
    account.name AS account_name,
    ad.id AS asset_id,
    ad.code AS asset_code,
    ad.name AS asset_name,
    ad.scale_factor AS asset_scale_factor,
    ad.fraction_digits AS asset_fraction_digits,
    ad.kind AS asset_kind,
    COUNT(*) AS balance_count,
    MAX(rb.timestamp) AS latest_timestamp
FROM reported_balance rb
JOIN account ON account.id = rb.account_id
JOIN asset_details ad ON ad.id = rb.asset_id
GROUP BY rb.account_id, rb.asset_id
ORDER BY account.name, ad.code;

-- One account's reported balances of one asset, oldest first. Rows reported at one instant come in their statement's
-- order (a CSV row's index, else the order they were recorded in), so the last of them is the balance after all of them.
selectBalances:
SELECT rb.id, rb.timestamp, rb.amount, rb.revision_id
FROM reported_balance rb
LEFT JOIN csv_import_record cir ON cir.record_id = rb.record_id
WHERE rb.account_id = :accountId AND rb.asset_id = :assetId
ORDER BY rb.timestamp, cir.row_index, rb.record_id;

-- The balance a record reports, if it reports one: the engine revises it in place.
selectByRecord:
SELECT id, account_id, asset_id, timestamp, amount, revision_id
FROM reported_balance
WHERE record_id = ?;
