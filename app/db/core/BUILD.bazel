load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "core",
    android = True,
    android_deps = [
        "@maven_kmp//:androidx_sqlite",
        "@maven_kmp//:sqldelight_android_driver",
    ],
    android_srcs = glob(["src/androidMain/kotlin/**/*.kt"]),
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_deps = ["@maven_kmp//:sqldelight_sqlite_driver"],
    jvm_exports = [
        "@maven_kmp//:kotlinx_serialization_core",
        "@maven_kmp//:sqldelight_jdbc_driver",
    ],
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    keep_deps = [
        "//utils/sqlite3",
        "@maven_kmp//:kotlinx_datetime",
        "@maven_kmp//:kotlinx_serialization_json",
        "@maven_kmp//:sqldelight_sqlite_driver",
    ],
    native_deps = [
        "@maven_kmp//:co_touchlab_sqliter_driver",
        "@maven_kmp//:sqldelight_native_driver",
        "//utils/sqlite3",
        "@maven_kmp//:kermit",
    ],
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    visibility = ["//visibility:public"],
    web_deps = ["@maven_kmp//:kotlinx_browser"],
    web_srcs = glob(["src/webMain/kotlin/**/*.kt"]),
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = [
        "//app/db/read",
        "//app/db/write",
        "//app/importengineapi",
        "//app/model/accountmapping",
        "//app/model/apistrategy",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/csvstrategy",
        "//app/model/importdirectory",
        "//app/model/passthrough",
        "//app/model/qif",
        "//app/model/repository/read",
        "//app/model/repository/write",
        "//app/model/timeline",
        "//app/tasks",
        "//utils/currency",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_io_core",
        "@maven_kmp//:sqldelight_runtime",
    ],
    deps = [
        "//app/db/seed",
        "//app/model/calendar",
        "//utils/bigdecimal",
        "//utils/coroutines",
        "//utils/files",
        "//utils/regex",
        "@maven_kmp//:kotlinx_datetime",
        "@maven_kmp//:kotlinx_serialization_json",
        "@maven_kmp//:sqldelight_async_extensions",
    ],
)

