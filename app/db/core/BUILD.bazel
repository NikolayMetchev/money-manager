        "//app/db/di",
        "//app/db/read",
        "//app/db/write",
        "//app/importdirectory",
        "//app/importengineapi",
        "//app/importer",
        "//app/importfilesource/core",
        "//app/model/apistrategy",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/csvstrategy",
        "//app/model/importdirectory",
        "//app/model/qif",
        "//app/model/repository/read",
        "//app/model/repository/write",
        "//app/model/rules",
        "//app/model/timeline",
        "//app/qifimporter",
        "//app/reconciliation",
