load("//bazel/kmp:defs.bzl", "kmp_library")
load("//bazel/kmp/sqldelight:sqldelight.bzl", "sqldelight_library")

sqldelight_library(
    name = "sqldelight",
    srcs = glob(["src/commonMain/sqldelight/**/*.sq"]),
    module_name = "write",
    package = "com.moneymanager.database.sql.write",
    visibility = ["//visibility:public"],
    deps = ["//app/db/schema:sqldelight"],
)

kmp_library(
    name = "write",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    sqldelight = ":sqldelight",
    visibility = ["//visibility:public"],
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = [
        "//app/db/read",
        "//app/db/repository",
        "//app/db/schema",
        "//app/model/accountmapping",
        "//app/model/apistrategy",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/csvstrategy",
        "//app/model/importdirectory",
        "//app/model/passthrough",
        "//app/model/qif",
        "//app/model/reconciliation",
        "//app/model/repository/read",
        "//app/model/repository/write",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:sqldelight_runtime",
    ],
    deps = [
        "//app/model/calendar",
        "//utils/coroutines",
        "//utils/regex",
        "@maven_kmp//:sqldelight_async_extensions",
        "@maven_kmp//:sqldelight_coroutines_extensions",
    ],
)
