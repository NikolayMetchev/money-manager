-- Insert source for an entity
insertSource:
INSERT OR IGNORE INTO entity_source (entity_type_id, entity_id, revision_id, source_type_id, device_id)
VALUES (?, ?, ?, ?, ?);

-- Insert API-specific details for an entity source (must be called after insertSource)
insertApiSource:
INSERT INTO api_entity_source (id, api_session_id, api_request_id, json_path)
VALUES (?, ?, ?, ?);

-- Records the account whose statement an import's record is (must be called after insertSource)
insertStatementAccount:
INSERT OR IGNORE INTO entity_source_statement_account (entity_source_id, account_id)
VALUES (?, ?);

-- Insert CSV-specific details for an entity source (must be called after insertSource)
insertFileEntitySource:
INSERT OR IGNORE INTO entity_source (entity_type_id, entity_id, revision_id, source_type_id, device_id)
VALUES (:entityType, :entityId, :revision, CASE WHEN EXISTS (
    SELECT 1 FROM import_sqlite_file WHERE csv_import_id = :fileId
) THEN 11 ELSE 2 END, :device);

insertCsvSource:
INSERT OR IGNORE INTO csv_entity_source (id, csv_import_id, csv_row_index)
VALUES (?, ?, ?);

-- An account merge moves the deleted account's statement lines to the surviving account, like its transfers
-- (insertMergeStatementSources first, so the unmerge can move them back).
reassignStatementAccount:
UPDATE entity_source_statement_account SET account_id = :survivingAccountId WHERE account_id = :deletedAccountId;

