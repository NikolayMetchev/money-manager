-- Insert source for an entity
insertSource:
INSERT OR IGNORE INTO entity_source (entity_type_id, entity_id, revision_id, source_type_id, device_id)
VALUES (?, ?, ?, ?, ?);

-- Insert API-specific details for an entity source (must be called after insertSource)
insertApiSource:
INSERT INTO api_entity_source (id, api_session_id, api_request_id, json_path)
VALUES (?, ?, ?, ?);

-- Insert CSV-specific details for an entity source (must be called after insertSource)
insertCsvSource:
INSERT OR IGNORE INTO csv_entity_source (id, csv_import_id, csv_row_index)
VALUES (?, ?, ?);

-- Records an import record that links to a transaction from another record (a duplicate, or an update)
-- as a matched source of the transaction's current revision. Transfers and trades share one id space, so whichever
-- holds the id is the entity. Follow with lastInsertedSourceId and its detail row.
insertMatchedSource:
INSERT INTO entity_source (entity_type_id, entity_id, revision_id, source_type_id, device_id, matched)
SELECT 7, id, revision_id, :sourceTypeId, :deviceId, 1 FROM transfer WHERE id = :transactionId
UNION ALL
SELECT 11, id, revision_id, :sourceTypeId, :deviceId, 1 FROM trade WHERE id = :transactionId;

lastInsertedSourceId:
SELECT last_insert_rowid();

-- Removes matched entries (never a writer's: the audit trail keeps those) once their record's link is gone.
-- Detail rows first, as they reference entity_source.
deleteCsvEntitySources:
DELETE FROM csv_entity_source WHERE id IN ?;

deleteMatchedEntitySources:
DELETE FROM entity_source WHERE id IN ? AND matched = 1;
