-- id must be an already-allocated `transaction_id` (mirrors transfer). Amounts are decimal-string TEXT.
insert:
INSERT INTO trade(id, revision_id, timestamp, description, from_account_id, from_asset_id, from_amount, to_account_id, to_asset_id, to_amount)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM trade WHERE id = ?;

upsertAttribute:
INSERT INTO trade_attribute(trade_id, attribute_type_id, attribute_value)
VALUES (?, ?, ?)
ON CONFLICT(trade_id, attribute_type_id) DO UPDATE SET attribute_value = excluded.attribute_value;

deleteAttribute:
DELETE FROM trade_attribute WHERE trade_id = ? AND attribute_type_id = ?;

-- A hand edit's new trade revision; see trade_attribute_audit.
bumpRevision:
UPDATE trade SET revision_id = revision_id + 1 WHERE id = ?;

insertAttributeAudit:
INSERT INTO trade_attribute_audit(audit_timestamp, audit_type_id, trade_id, revision_id, attribute_type_id, attribute_value)
VALUES (?, ?, ?, ?, ?, ?);
