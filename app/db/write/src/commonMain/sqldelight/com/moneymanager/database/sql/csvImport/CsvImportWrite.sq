insertImport:
INSERT INTO csv_import_metadata (id, table_name, original_file_name, import_timestamp, row_count, column_count, device_id, file_checksum, file_last_modified)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteImport:
DELETE FROM csv_import_metadata WHERE id = ?;

-- The import-directory files staged into this import. Deleting their tracking rows (which cascades the
-- link) lets the import itself be deleted, and makes the folder's next scan stage the file afresh.
deleteDirectoryFilesForImport:
DELETE FROM import_directory_file
WHERE id IN (SELECT file_id FROM import_directory_file_csv_import WHERE csv_import_id = ?);

updateImportCounts:
UPDATE csv_import_metadata SET row_count = ?, column_count = ? WHERE id = ?;

updateImportFile:
UPDATE csv_import_metadata SET file_checksum = ?, file_last_modified = ? WHERE id = ?;

-- Re-staging in place renumbers rows, so the provenance pointing at them is moved in two steps: park every
-- old index out of the way (negated), then map each parked index to its new one. Anything still parked
-- afterwards points at a row the new file no longer has.
parkEntitySourceRows:
UPDATE csv_entity_source SET csv_row_index = -csv_row_index WHERE csv_import_id = ? AND csv_row_index > 0;

moveEntitySourceRow:
UPDATE csv_entity_source SET csv_row_index = :newIndex WHERE csv_import_id = :importId AND csv_row_index = -:oldIndex;

clearParkedEntitySourceRows:
UPDATE csv_entity_source SET csv_row_index = NULL WHERE csv_import_id = ? AND csv_row_index < 0;

setImportIgnored:
UPDATE csv_import_metadata SET ignored = ? WHERE id = ?;

insertColumn:
INSERT INTO csv_column_metadata (id, import_id, column_index, original_name)
VALUES (?, ?, ?, ?);

deleteColumnsByImportId:
DELETE FROM csv_column_metadata WHERE import_id = ?;

-- Only unimport deletes applications; the csv_import_application_audit DELETE entries it leaves behind
-- are how the file's "unimported" state is remembered.
deleteApplicationsByImportId:
DELETE FROM csv_import_application WHERE csv_import_id = ?;

insertApplication:
INSERT INTO csv_import_application (id, csv_import_id, strategy_id, strategy_name, applied_at)
VALUES (?, ?, ?, ?, ?);

-- csv_import_error queries
insertOrReplaceError:
INSERT OR REPLACE INTO csv_import_error (csv_import_id, row_index, error_message, error_timestamp)
VALUES (?, ?, ?, ?);

deleteError:
DELETE FROM csv_import_error WHERE csv_import_id = ? AND row_index = ?;

deleteErrorsByImportId:
DELETE FROM csv_import_error WHERE csv_import_id = ?;

-- xlsx_import_blob queries
insertXlsxBlob:
INSERT INTO xlsx_import_blob (csv_import_id, file_bytes, worksheet_name)
VALUES (?, ?, ?);

updateXlsxBlobWorksheet:
UPDATE xlsx_import_blob SET worksheet_name = ? WHERE csv_import_id = ?;

updateXlsxBlobBytes:
UPDATE xlsx_import_blob SET file_bytes = ? WHERE csv_import_id = ?;
