insertMerge:
INSERT INTO account_merge(
    merged_at, surviving_account_id, deleted_account_id, deleted_account_name,
    deleted_account_opening_date, deleted_account_category_id, deleted_account_revision_id, parent_merge_id
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

setRetaggedFeeAttribute:
UPDATE account_merge SET retagged_fee_attribute_id = :attributeId WHERE id = :mergeId;

lastInsertRowId:
SELECT last_insert_rowid();

insertMergeTransfer:
INSERT INTO account_merge_transfer(merge_id, transfer_id, moved_source, moved_target)
VALUES (?, ?, ?, ?);

insertMergeAttribute:
-- Record an attribute row this merge grafted onto the SURVIVOR, so unmerge can remove exactly the rows
-- the merge added and leave the survivor's own attributes alone.
INSERT INTO account_merge_attribute(merge_id, attribute_id)
VALUES (?, ?);

markReversed:
UPDATE account_merge SET reversed = 1 WHERE id = ?;

-- A file imported onto the deleted account re-imports onto the survivor. Run before the delete, which would otherwise
-- clear the file's account (ON DELETE SET NULL). The audit trail records the account it had.
moveImportApplications:
UPDATE csv_import_application SET account_id = :survivingAccount WHERE account_id = :deletedAccount;

-- Points back the files whose last change of account moved them off the restored account, which is what
-- moveImportApplications did (read from csv_import_application_audit's UPDATE entries, which keep the old value).
restoreImportApplications:
UPDATE csv_import_application SET account_id = :deletedAccount
WHERE account_id = :survivingAccount
  AND id IN (
      SELECT change.csv_import_application_id
      FROM csv_import_application_audit change
      WHERE change.audit_type_id = 2
        AND change.account_id = :deletedAccount
        AND change.id = (
            SELECT MAX(latest.id) FROM csv_import_application_audit latest
            WHERE latest.csv_import_application_id = change.csv_import_application_id AND latest.audit_type_id = 2
        )
  );

-- Remembers the provenance rows naming the deleted account as their statement account, before the merge repoints them.
insertMergeStatementSources:
INSERT INTO account_merge_statement_source (merge_id, entity_source_id)
SELECT :mergeId, id FROM entity_source WHERE statement_account_id = :deletedAccount;

-- Gives the restored account back the statement lines the merge moved to the survivor.
restoreStatementSources:
UPDATE entity_source SET statement_account_id = :deletedAccount
WHERE id IN (SELECT entity_source_id FROM account_merge_statement_source WHERE merge_id = :mergeId);
