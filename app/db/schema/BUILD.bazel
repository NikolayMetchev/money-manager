# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web
# gazelle:kmp_sqldelight_package com.moneymanager.database.sql

load("//bazel/kmp:defs.bzl", "kmp_library")
load("//bazel/kmp/sqldelight:sqldelight.bzl", "sqldelight_library")

sqldelight_library(
    name = "sqldelight",
    srcs = glob(["src/commonMain/sqldelight/**/*.sq"]),
    module_name = "schema",
    package = "com.moneymanager.database.sql",
    visibility = ["//visibility:public"],
)

kmp_library(
    name = "schema",
    android = True,
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    sqldelight = ":sqldelight",
    visibility = ["//visibility:public"],
    web_targets = [
        "wasmJs",
        "js",
    ],
)
