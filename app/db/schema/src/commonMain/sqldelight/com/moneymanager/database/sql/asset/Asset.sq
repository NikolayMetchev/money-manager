-- asset: shared id-generator supertype for every asset class (fiat currency, crypto, and future
-- kinds such as stocks). Mirrors `transaction_id` for transactions: a bare, permanent id space so a
-- transfer/trade/balance can denominate in any asset uniformly via a single asset id.
-- Like transaction_id, rows are NEVER deleted directly; deleting the concrete subtype row
-- (currency/crypto) cascades from here.
CREATE TABLE asset (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL
);

-- asset_details: unifying read view over every asset subtype, exposing the common columns plus a
-- `kind` discriminator (and a currency's ISO minor unit, `fraction_digits`, NULL for crypto) so a reader (e.g. a transfer/trade mapper) can resolve any asset_id to the
-- right domain type without knowing which subtype table it lives in.
-- Joins off `asset` rather than a UNION ALL of the subtypes: SQLite can't push a join's `asset_details.id = ?` into a
-- union, so every transfer or trade read by id scanned every crypto row (thousands, per record a re-import books). As
-- joins the view flattens into its reader and each lookup is a primary-key search. The trailing literals only keep the
-- columns NOT NULL for SQLDelight: the WHERE guarantees one subtype row.
CREATE VIEW asset_details AS
SELECT
    asset.id,
    COALESCE(currency.revision_id, crypto.revision_id, 0) AS revision_id,
    COALESCE(currency.code, crypto.code, '') AS code,
    COALESCE(currency.name, crypto.name, '') AS name,
    COALESCE(currency.scale_factor, crypto.scale_factor, 0) AS scale_factor,
    currency.fraction_digits AS fraction_digits,
    CASE WHEN currency.id IS NOT NULL THEN 'FIAT' ELSE 'CRYPTO' END AS kind
FROM asset
LEFT JOIN currency ON currency.id = asset.id
LEFT JOIN crypto ON crypto.id = asset.id
WHERE currency.id IS NOT NULL OR crypto.id IS NOT NULL;
