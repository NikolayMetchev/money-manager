CREATE TABLE transfer (
    id INTEGER PRIMARY KEY NOT NULL,
    revision_id INTEGER NOT NULL DEFAULT 1,
    timestamp INTEGER NOT NULL,
    description TEXT NOT NULL,
    source_account_id INTEGER NOT NULL,
    target_account_id INTEGER NOT NULL,
    asset_id INTEGER NOT NULL,
    -- Arbitrary-precision minor-unit amount, stored as a decimal string (BigInteger.toString()).
    amount TEXT NOT NULL,
    CHECK (source_account_id != target_account_id),
    FOREIGN KEY (id) REFERENCES transaction_id(id) ON DELETE RESTRICT,
    FOREIGN KEY (source_account_id) REFERENCES account(id) ON DELETE CASCADE,
    FOREIGN KEY (target_account_id) REFERENCES account(id) ON DELETE CASCADE,
    FOREIGN KEY (asset_id) REFERENCES asset(id) ON DELETE RESTRICT
);

CREATE INDEX IF NOT EXISTS idx_transfer_src_target_amount ON transfer(source_account_id, target_account_id, amount);
CREATE INDEX IF NOT EXISTS idx_transfer_target_timestamp ON transfer(target_account_id, timestamp);
CREATE INDEX IF NOT EXISTS idx_transfer_asset ON transfer(asset_id);

-- Materialized table for account balances (manually refreshed)
CREATE TABLE account_balance_materialized_view (
    account_id INTEGER NOT NULL,
    asset_id INTEGER NOT NULL,
    -- Arbitrary-precision balance as a decimal string (BigInteger.toString()).
    balance TEXT NOT NULL,
    PRIMARY KEY (account_id, asset_id),
    FOREIGN KEY (account_id) REFERENCES account(id) ON DELETE CASCADE,
    FOREIGN KEY (asset_id) REFERENCES asset(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_account_balance_mv_account ON account_balance_materialized_view(account_id);
CREATE INDEX IF NOT EXISTS idx_account_balance_mv_currency ON account_balance_materialized_view(asset_id);

-- Materialized table for running balances (manually refreshed)
CREATE TABLE running_balance_materialized_view (
    id INTEGER NOT NULL,
    timestamp INTEGER NOT NULL,
    description TEXT NOT NULL,
    account_id INTEGER NOT NULL,
    asset_id INTEGER NOT NULL,
    -- Signed arbitrary-precision amounts as decimal strings (BigInteger.toString()).
    transaction_amount TEXT NOT NULL,
    running_balance TEXT NOT NULL,
    is_excluded INTEGER NOT NULL DEFAULT 0,
    -- asset_id is part of the key: a same-account cross-asset trade (e.g. BTC→ETH in one wallet)
    -- produces two rows for the same (id, account_id) differing only by asset.
    PRIMARY KEY (id, account_id, asset_id),
    FOREIGN KEY (account_id) REFERENCES account(id) ON DELETE CASCADE,
    FOREIGN KEY (asset_id) REFERENCES asset(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_running_balance_mv_account ON running_balance_materialized_view(account_id);
CREATE INDEX IF NOT EXISTS idx_running_balance_mv_timestamp ON running_balance_materialized_view(timestamp DESC);
CREATE INDEX IF NOT EXISTS idx_running_balance_mv_account_timestamp ON running_balance_materialized_view(account_id, timestamp DESC);

-- NOTE: The old `account_balance_view` / `running_balance_view` (SQL SUM aggregations) were removed
-- when amounts became arbitrary-precision TEXT: SQLite cannot SUM decimal strings without losing
-- precision on values beyond a Long. The materialized tables above are now populated by Kotlin
-- BigInteger aggregation in DatabaseMaintenanceServiceImpl (fed by the leg-enumeration queries in
-- BalanceLegsSelect.sq). Excluded transactions (attribute_type_id = -1) are omitted from balance
-- sums but still appear in the running-balance list.

-- Table to track pending changes for incremental refresh
CREATE TABLE pending_materialized_view_changes (
    account_id INTEGER NOT NULL,
    asset_id INTEGER NOT NULL,
    min_timestamp INTEGER NOT NULL,
    PRIMARY KEY (account_id, asset_id),
    FOREIGN KEY (account_id) REFERENCES account(id) ON DELETE CASCADE,
    FOREIGN KEY (asset_id) REFERENCES asset(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_pending_changes_account ON pending_materialized_view_changes(account_id);
CREATE INDEX IF NOT EXISTS idx_pending_changes_currency ON pending_materialized_view_changes(asset_id);
CREATE INDEX IF NOT EXISTS idx_pending_changes_timestamp ON pending_materialized_view_changes(min_timestamp);

-- NOTE: Triggers are created at runtime via DatabaseConfig.createIncrementalRefreshTriggers()
-- SQLDelight 2.2.1 has limited trigger support, so we create them dynamically

-- transfer_with_asset: the transfer row with its asset resolved through `asset_details`, i.e. the
-- projection every transfer read query needs in order to build a domain `Transfer` (the amount is a
-- bare minor-unit string, meaningless without the asset's code/scale). Declared once here so the
-- select queries in :app:db:read carry only their WHERE/ORDER BY.
CREATE VIEW transfer_with_asset AS
SELECT
    transfer.id,
    transfer.revision_id,
    transfer.timestamp,
    transfer.description,
    transfer.source_account_id,
    transfer.target_account_id,
    transfer.amount,
    asset_details.id AS asset_id,
    asset_details.code AS asset_code,
    asset_details.name AS asset_name,
    asset_details.scale_factor AS asset_scale_factor,
    asset_details.fraction_digits AS asset_fraction_digits,
    asset_details.kind AS asset_kind
FROM transfer
JOIN asset_details ON transfer.asset_id = asset_details.id;

-- account_row_source: one row per account-transaction line as the transactions list renders it —
-- the running-balance materialized row, its asset, the transfer/trade endpoints, and the relationship
-- links (reconciled / fee / pass-through / exchange order) the row's badges are drawn from. It carries
-- no account or ordering predicate: callers add their own WHERE/ORDER BY, and SQLite flattens the view
-- into the outer query so the (account_id, timestamp) index is still used.
CREATE VIEW account_row_source AS
SELECT
    running_balance_materialized_view.id,
    running_balance_materialized_view.timestamp,
    running_balance_materialized_view.description,
    running_balance_materialized_view.account_id,
    running_balance_materialized_view.transaction_amount,
    running_balance_materialized_view.running_balance,
    asset_details.id AS asset_id,
    asset_details.code AS asset_code,
    asset_details.name AS asset_name,
    asset_details.scale_factor AS asset_scale_factor,
    asset_details.fraction_digits AS asset_fraction_digits,
    asset_details.kind AS asset_kind,
    COALESCE(transfer.source_account_id, trade.from_account_id) AS source_account_id,
    COALESCE(transfer.target_account_id, trade.to_account_id) AS target_account_id,
    running_balance_materialized_view.is_excluded,
    -- A pass-through (conduit) leg reads as reconciled when its chain counterpart is: a funding-card
    -- reconcile links the conduit spend to the FUNDING leg, so the sibling SPEND leg (the "Via conduit"
    -- row) — and vice versa — must show reconciled too, since the whole chain is reconciled.
    -- pt_spend.transaction_id is this row's spend leg (when this row is the funding leg); pt_funding.transaction_id
    -- is this row's funding leg (when this row is the spend leg); both are NULL for non-conduit rows, so the extra
    -- checks are no-ops there.
    CASE WHEN EXISTS (
        SELECT 1 FROM relationship_member rm
        JOIN relationship r ON r.id = rm.relationship_id
        WHERE r.relationship_type_id = 1   -- RECONCILED_RELATIONSHIP_TYPE_ID; mirrors the hardcoded -1 used for is_excluded
          AND rm.transaction_id IN (running_balance_materialized_view.id, pt_spend.transaction_id, pt_funding.transaction_id)
    ) THEN 1 ELSE 0 END AS is_reconciled,
    -- Linked fee transfer when this row is the main transaction, and the linked main transaction when this row
    -- is the fee transfer. FEE_RELATIONSHIP_TYPE_ID = 2.
    fee_child.transaction_id AS fee_transfer_id,
    fee_parent.transaction_id AS fee_parent_id,
    -- Pass-through (conduit) link, e.g. Curve: the spend leg when this row is the funding leg (primary),
    -- and the funding leg when this row is the spend leg (related). PASS_THROUGH_RELATIONSHIP_TYPE_ID = 3.
    pt_spend.transaction_id AS pass_through_spend_id,
    pt_funding.transaction_id AS pass_through_funding_id,
    -- The exchange order this trade fills, when any (exchange_order_trade.trade_id is UNIQUE, so
    -- the join never multiplies rows and is a point index lookup).
    order_link.order_id AS exchange_order_id,
    -- Whether this row is a trade (same-transaction asset conversion) or a plain transfer.
    CASE WHEN trade.id IS NOT NULL THEN 'TRADE' ELSE 'TRANSFER' END AS transaction_kind
FROM running_balance_materialized_view
JOIN asset_details ON running_balance_materialized_view.asset_id = asset_details.id
LEFT JOIN transfer ON running_balance_materialized_view.id = transfer.id
LEFT JOIN trade ON running_balance_materialized_view.id = trade.id
-- Each pairwise link is two point lookups on relationship_member: this row's own membership in a relationship of
-- the type with the given role, then the other end of that relationship. (Not the relationship_pair view: as the
-- right side of a LEFT JOIN SQLite can't flatten a join, so it would materialize every pair of the type per query.)
-- A row has at most one link of each type per side, so the joins never multiply rows. LEFT JOINs (rather than
-- scalar subqueries) so SQLDelight infers the ids as NULLABLE. Roles: 0 = PRIMARY, 1 = RELATED.
LEFT JOIN relationship_member fee_self_main
    ON fee_self_main.transaction_id = running_balance_materialized_view.id AND fee_self_main.role = 0
   AND EXISTS (SELECT 1 FROM relationship r WHERE r.id = fee_self_main.relationship_id AND r.relationship_type_id = 2)
LEFT JOIN relationship_member fee_child
    ON fee_child.relationship_id = fee_self_main.relationship_id AND fee_child.role = 1
LEFT JOIN relationship_member fee_self_child
    ON fee_self_child.transaction_id = running_balance_materialized_view.id AND fee_self_child.role = 1
   AND EXISTS (SELECT 1 FROM relationship r WHERE r.id = fee_self_child.relationship_id AND r.relationship_type_id = 2)
LEFT JOIN relationship_member fee_parent
    ON fee_parent.relationship_id = fee_self_child.relationship_id AND fee_parent.role = 0
LEFT JOIN relationship_member pt_self_funding
    ON pt_self_funding.transaction_id = running_balance_materialized_view.id AND pt_self_funding.role = 0
   AND EXISTS (SELECT 1 FROM relationship r WHERE r.id = pt_self_funding.relationship_id AND r.relationship_type_id = 3)
LEFT JOIN relationship_member pt_spend
    ON pt_spend.relationship_id = pt_self_funding.relationship_id AND pt_spend.role = 1
LEFT JOIN relationship_member pt_self_spend
    ON pt_self_spend.transaction_id = running_balance_materialized_view.id AND pt_self_spend.role = 1
   AND EXISTS (SELECT 1 FROM relationship r WHERE r.id = pt_self_spend.relationship_id AND r.relationship_type_id = 3)
LEFT JOIN relationship_member pt_funding
    ON pt_funding.relationship_id = pt_self_spend.relationship_id AND pt_funding.role = 0
LEFT JOIN exchange_order_trade order_link ON order_link.trade_id = running_balance_materialized_view.id;
