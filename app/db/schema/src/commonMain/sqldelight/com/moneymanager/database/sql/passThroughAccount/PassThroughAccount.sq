-- Stores "pass-through" (conduit) account definitions such as Curve: generic, user-editable config
-- that tells importers how to detect a wrapper-card charge (e.g. a "CRV*" marker on the description)
-- and route it through a conduit account (card -> conduit -> merchant). Its detection rules are the rows of
-- pass_through_rule. This is a config/lookup table: it is in EXCLUDED_FROM_AUDIT, so the generic attribute/audit
-- mechanism ignores it. It carries no provenance, so there is no _source companion table (unlike
-- csv_import_strategy / import_directory). It does, however, have a pass_through_account_audit table
-- populated by dedicated triggers, so that user edits to this config register in dataChangeToken() (which
-- counts audit rows) and therefore get synced. See Audit.sq / AuditTriggers.sq.
CREATE TABLE pass_through_account (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE CHECK(length(trim(name)) > 0),
    conduit_account_name TEXT NOT NULL CHECK(length(trim(conduit_account_name)) > 0),
    relationship_type_id INTEGER NOT NULL DEFAULT 3,
    FOREIGN KEY (relationship_type_id) REFERENCES relationship_type(id)
);

CREATE INDEX idx_pass_through_account_name ON pass_through_account(name);

-- A pass-through account's detection rules, in order: the first whose detection_pattern matches wins. They are only
-- ever written together with their account, so the account's audit row records an edit to any of them.
CREATE TABLE pass_through_rule (
    pass_through_account_id INTEGER NOT NULL,
    position INTEGER NOT NULL,
    detection_pattern TEXT NOT NULL,
    merchant_pattern TEXT NOT NULL,
    merchant_template TEXT NOT NULL,
    PRIMARY KEY (pass_through_account_id, position),
    FOREIGN KEY (pass_through_account_id) REFERENCES pass_through_account(id) ON DELETE CASCADE
);
