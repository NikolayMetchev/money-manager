# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64
# gazelle:kmp_sqldelight_package com.moneymanager.database.sql.seed
# gazelle:kmp_sqldelight_dep //app/db/schema:sqldelight
# gazelle:kmp_export //app/db/schema

load("//bazel/kmp:defs.bzl", "kmp_library")
load("//bazel/kmp/sqldelight:sqldelight.bzl", "sqldelight_library")

sqldelight_library(
    name = "sqldelight",
    srcs = glob(["src/commonMain/sqldelight/**/*.sq"]),
    module_name = "seed",
    package = "com.moneymanager.database.sql.seed",
    visibility = ["//visibility:public"],
    deps = ["//app/db/schema:sqldelight"],
)

kmp_library(
    name = "seed",
    android = True,
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    sqldelight = ":sqldelight",
    visibility = ["//visibility:public"],
    exports = ["//app/db/schema"],
)
