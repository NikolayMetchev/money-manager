# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web
# gazelle:kmp_plugins serialization
# gazelle:kmp_export //app/model/core
# gazelle:kmp_export //app/model/csvstrategy
# gazelle:kmp_export //utils/localsettings
# gazelle:kmp_export @maven_kmp//:kotlinx_coroutines_core
# gazelle:kmp_export @maven_kmp//:ktor_client_core
# gazelle:kmp_export @maven_kmp//:kotlinx_serialization_core jvmMain
# gazelle:kmp_keep_dep @maven_kmp//:ktor_utils jvmMain

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "strategycatalog",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_deps = ["@maven_kmp//:ktor_utils"],
    keep_deps = ["@maven_kmp//:ktor_utils"],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    visibility = ["//visibility:public"],
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = [
        "//app/model/core",
        "//app/model/csvstrategy",
        "//utils/localsettings",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_serialization_core",
        "@maven_kmp//:ktor_client_core",
    ],
    deps = [
        "//utils/coroutines",
        "//utils/files",
        "//utils/httpclient",
        "@maven_kmp//:kotlinx_io_core",
        "@maven_kmp//:kotlinx_serialization_json",
        "@maven_kmp//:ktor_http",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":strategycatalog",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = [
        "//app/model/core",
        "//app/model/csvstrategy",
        "//bazel/kmp/deps:kotlin_test",
        "//utils/localsettings",
        "@maven_kmp//:kotlinx_coroutines_test",
        "@maven_kmp//:ktor_client_core",
        "@maven_kmp//:ktor_client_mock",
        "@maven_kmp//:ktor_http",
    ],
)
