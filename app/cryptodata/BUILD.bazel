# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64
# gazelle:kmp_plugins serialization
# gazelle:kmp_export //app/model/core
# gazelle:kmp_export @maven_kmp//:ktor_client_core jvmMain
# gazelle:kmp_keep_dep @maven_kmp//:ktor_http jvmMain

# gazelle:kmp_generated_srcs :generated_crypto_dataset
load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")
load("//bazel/kmp/constants:constants.bzl", "kotlin_constants")

# GenerateKotlinConstantsTask in the Gradle build, which generated_by names until the cutover (#1031).
kotlin_constants(
    name = "generated_crypto_dataset",
    constants = {"data/coins.tsv": "COINS_TSV"},
    generated_by = ":app:cryptodata:generateBundledCryptoDataset",
    object = "GeneratedCryptoDataset",
    package = "com.moneymanager.cryptodata",
)

kmp_library(
    name = "cryptodata",
    android = True,
    android_srcs = glob(["src/androidMain/kotlin/**/*.kt"]),
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    generated_srcs = [":generated_crypto_dataset"],
    jvm_deps = ["@maven_kmp//:ktor_http"],
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    keep_deps = ["@maven_kmp//:ktor_http"],
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    visibility = ["//visibility:public"],
    exports = [
        "//app/model/core",
        "@maven_kmp//:ktor_client_core",
    ],
    deps = [
        "//utils/files",
        "//utils/httpclient",
        "@maven_kmp//:kotlinx_io_core",
        "@maven_kmp//:kotlinx_serialization_core",
        "@maven_kmp//:kotlinx_serialization_json",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":cryptodata",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    deps = [
        "//app/model/core",
        "//bazel/kmp/deps:kotlin_test",
    ],
)

# The crypto-dataset tool's test reads the checked-in catalog (#1027).
exports_files(
    ["data/coins.tsv"],
    visibility = ["//tools/crypto-dataset:__pkg__"],
)
