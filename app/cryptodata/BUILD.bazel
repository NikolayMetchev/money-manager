# gazelle:kmp_generate true
# gazelle:kmp_targets linuxArm64 linuxX64 macosArm64 mingwX64
# gazelle:kmp_plugins serialization
# gazelle:kmp_export //app/model/core
# gazelle:kmp_export @maven_kmp//:ktor_client_core jvmMain
# gazelle:kmp_keep_dep @maven_kmp//:ktor_http jvmMain

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "cryptodata",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_deps = ["@maven_kmp//:ktor_http"],
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    visibility = ["//visibility:public"],
    exports = [
        "//app/model/core",
        "@maven_kmp//:ktor_client_core",
    ],
    deps = [
        "//utils/files",
        "//utils/httpclient",
        "@maven_kmp//:kotlinx_io_core",
        "@maven_kmp//:kotlinx_serialization_core",
        "@maven_kmp//:kotlinx_serialization_json",
    ],
)

kmp_test(
    name = "test",
    associate = ":cryptodata",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    deps = [
        "//app/model/core",
        "//bazel/kmp/deps:kotlin_test",
    ],
)
