load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "csvimporter",
    android = True,
    android_deps = ["@maven_kmp//:cryptography_provider_jdk"],
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    jvm_deps = ["@maven_kmp//:cryptography_provider_jdk"],
    keep_deps = [
        "@maven_kmp//:cryptography_provider_jdk",
        "@maven_kmp//:cryptography_provider_openssl3_prebuilt",
    ],
    native_deps = ["@maven_kmp//:cryptography_provider_openssl3_prebuilt"],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    exports = [
        "//app/importengineapi",
        "//app/importfilesource/core",
        "//app/model/accountmapping",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/csvstrategy",
        "//app/model/importdirectory",
        "//app/model/passthrough",
        "//app/model/qif",
        "//app/model/repository/read",
        "//app/tasks",
        "@maven_kmp//:kotlinx_coroutines_core",
    ],
    deps = [
        "//app/model/rules",
        "//utils/bigdecimal",
        "//utils/parsers/csv",
        "//utils/parsers/qif",
        "//utils/parsers/xlsx",
        "@maven_kmp//:cryptography_core",
        "@maven_kmp//:kermit",
        "@maven_kmp//:kotlinx_datetime",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":csvimporter",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    jvm_deps = ["//app/importfilesource/core"],
    jvm_srcs = glob(["src/jvmTest/kotlin/**/*.kt"]),
    native_targets = [
