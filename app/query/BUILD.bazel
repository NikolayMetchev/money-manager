# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web
# gazelle:kmp_forbid_deps //app/db/core //app/di/core //app/ui/core
# gazelle:kmp_plugins serialization
# gazelle:kmp_export //app/model/apistrategy
# gazelle:kmp_export //app/model/core
# gazelle:kmp_export //app/model/csvstrategy
# gazelle:kmp_export //app/model/importdirectory
# gazelle:kmp_export //app/model/repository/read
# gazelle:kmp_export @maven_kmp//:kotlinx_coroutines_core
# gazelle:kmp_export @maven_kmp//:kotlinx_datetime
# gazelle:kmp_export @maven_kmp//:kotlinx_serialization_core

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "query",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    visibility = ["//visibility:public"],
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = [
        "//app/model/apistrategy",
        "//app/model/core",
        "//app/model/csvstrategy",
        "//app/model/importdirectory",
        "//app/model/repository/read",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_datetime",
        "@maven_kmp//:kotlinx_serialization_core",
    ],
    deps = [
        "//app/db/write",
        "//utils/regex",
        "@maven_kmp//:kotlinx_serialization_json",
        "@maven_kmp//:sqldelight_async_extensions",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":query",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = [
        "mokkery",
        "serialization",
    ],
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = [
        "//app/model/core",
        "//bazel/kmp/deps:kotlin_test",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_coroutines_test",
        "@maven_kmp//:kotlinx_datetime",
        "@maven_kmp//:kotlinx_serialization_json",
        "@maven_kmp//:mokkery_runtime",
    ],
)
