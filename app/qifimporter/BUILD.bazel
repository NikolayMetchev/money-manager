# gazelle:kmp_forbid_deps //app/db/core //app/di/core //app/ui/core
# gazelle:kmp_export //app/csvimporter
# gazelle:kmp_export //app/importengineapi
# gazelle:kmp_export //app/model/accountmapping
# gazelle:kmp_export //app/model/core
# gazelle:kmp_export //app/model/csv
# gazelle:kmp_export //app/model/csvstrategy
# gazelle:kmp_export //app/model/qif
# gazelle:kmp_export //app/model/repository/read
# gazelle:kmp_keep_dep @maven_kmp//:kotlinx_coroutines_test commonTest
# gazelle:kmp_export //app/tasks jvmMain

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "qifimporter",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = [
        "//app/csvimporter",
        "//app/importengineapi",
        "//app/model/accountmapping",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/csvstrategy",
        "//app/model/qif",
        "//app/model/repository/read",
        "//app/tasks",
    ],
    deps = [
        "@maven_kmp//:kermit",
        "@maven_kmp//:kotlinx_coroutines_core",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":qifimporter",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    keep_deps = ["@maven_kmp//:kotlinx_coroutines_test"],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = [
        "//app/csvimporter",
        "//app/model/accountmapping",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/qif",
        "//app/strategies",
        "//bazel/kmp/deps:kotlin_test",
        "//utils/regex",
        "@maven_kmp//:kotlinx_coroutines_test",
    ],
)
