# gazelle:kmp_generate true
# gazelle:kmp_targets linuxArm64 linuxX64 macosArm64 mingwX64
# gazelle:kmp_plugins serialization
# gazelle:kmp_keep_dep @maven_kmp//:mosaic_terminal jvmMain

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_native_executable", "kmp_test")
load("//bazel/kmp:distribution.bzl", "jvm_distribution")

kmp_library(
    name = "cli",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_deps = ["@maven_kmp//:mosaic_terminal"],
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    visibility = ["//visibility:public"],
    deps = [
        "//app/apiimport",
        "//app/cryptodata",
        "//app/csvimporter",
        "//app/db/core",
        "//app/db/di",
        "//app/di/core",
        "//app/di/params",
        "//app/importdirectory",
        "//app/importengineapi",
        "//app/importfilesource/core",
        "//app/importfilesource/di",
        "//app/model/core",
        "//app/model/importdirectory",
        "//app/query",
        "//app/remotestorage/googledrive",
        "//app/remotestorage/sync",
        "//app/session",
        "//app/tasks",
        "//app/terminal",
        "//app/tui",
        "//utils/archive",
        "//utils/credentialvault",
        "//utils/files",
        "//utils/localsettings",
        "@maven_kmp//:clikt",
        "@maven_kmp//:clikt_core",
        "@maven_kmp//:kermit",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_datetime",
        "@maven_kmp//:kotlinx_io_core",
        "@maven_kmp//:kotlinx_serialization_core",
        "@maven_kmp//:kotlinx_serialization_json",
        "@maven_kmp//:ktor_client_core",
        "@maven_kmp//:mordant_core",
    ],
)

kmp_test(
    name = "test",
    associate = ":cli",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    plugins = ["serialization"],
    deps = [
        "//app/db/core",
        "//app/db/di",
        "//app/importengineapi",
        "//app/importfilesource/core",
        "//app/importfilesource/di",
        "//app/model/core",
        "//app/model/importdirectory",
        "//app/query",
        "//app/remotestorage/googledrive",
        "//app/session",
        "//app/tasks",
        "//app/terminal",
        "//app/tui",
        "//bazel/kmp/deps:kotlin_test",
        "//test/app/db",
        "//test/utils/credentialvault",
        "//utils/credentialvault",
        "//utils/files",
        "//utils/localsettings",
        "@maven_kmp//:clikt",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_coroutines_test",
        "@maven_kmp//:kotlinx_io_core",
        "@maven_kmp//:kotlinx_serialization_json",
        "@maven_kmp//:ktor_client_core",
        "@maven_kmp//:ktor_client_mock",
        "@maven_kmp//:ktor_http",
        "@maven_kmp//:mordant_core",
        "@maven_kmp//:mosaic_runtime",
    ],
)

# `mm`, release-linked for every native target (Gradle's `binaries.executable(RELEASE)`).
kmp_native_executable(
    name = "mm",
    base_name = "mm",
    entry_point = "com.moneymanager.cli.main",
    library = ":cli",
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    # The release workflow's assets.
    release_assets = {
        "linuxArm64": "mm-linux-arm64",
        "linuxX64": "mm-linux-x64",
        "macosArm64": "mm-macos-arm64",
        "mingwX64": "mm-windows-x64",
    },
)

# `mm-jvm`: the CLI on the JVM, laid out as Gradle's `installDist` (bin/ scripts, lib/ jars); the desktop
# installer bundles it.
jvm_distribution(
    name = "mm-jvm",
    main_class = "com.moneymanager.cli.MainKt",
    deps = [":cli_jvm"],
)

pkg_tar(
    name = "mm-jvm_tar",
    srcs = [":mm-jvm"],
    extension = "tar.gz",
    package_file_name = "mm-jvm.tar.gz",
    strip_prefix = ".",
)
