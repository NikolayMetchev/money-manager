# `mm`, release-linked for every native target (Gradle's `binaries.executable(RELEASE)`).
kmp_native_executable(
    name = "mm",
    base_name = "mm",
    entry_point = "com.moneymanager.cli.main",
    library = ":cli",
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    # The release workflow's assets.
    release_assets = {
        "linuxArm64": "mm-linux-arm64",
        "linuxX64": "mm-linux-x64",
        "macosArm64": "mm-macos-arm64",
        "mingwX64": "mm-windows-x64",
    },
    # The desktop installer bundles the host's mm (`--define=bundle_native_cli=true`).
    visibility = ["//app/main/jvm:__pkg__"],
)

# SLF4J's provider for mm on the JVM: libraries that log through SLF4J reach log4j, which
# keeps them to errors on stderr (log4j2-mm.xml); without a provider SLF4J warns on every start. mm's own logs
# go through Kermit. The desktop installer's mm-jvm launcher carries it too.
java_library(
    name = "mm_jvm_logging",
    resource_strip_prefix = "app/main/cli",
    resources = ["log4j2-mm.xml"],
    visibility = ["//app/main/jvm:__pkg__"],
    runtime_deps = [
        "@maven_kmp//:log4j_core_jvm",
        "@maven_kmp//:log4j_slf4j2_impl_jvm",
    ],
)

# `mm-jvm`: the CLI on the JVM, laid out as Gradle's `installDist` (bin/ scripts, lib/ jars); the desktop
# installer bundles it, with the same options (app/main/jvm/mm-jvm.properties).
jvm_distribution(
    name = "mm-jvm",
    jvm_flags = [
        # Mordant reads the terminal through JNA, which the JDK otherwise warns about on every start.
        "--enable-native-access=ALL-UNNAMED",
        "-Dlog4j2.configurationFile=classpath:log4j2-mm.xml",
    ],
    main_class = "com.moneymanager.cli.MainKt",
    deps = [
        ":cli_jvm",
        ":mm_jvm_logging",
    ],
)

pkg_tar(
    name = "mm-jvm_tar",
    srcs = [":mm-jvm"],
    extension = "tar.gz",
    package_file_name = "mm-jvm.tar.gz",
    strip_prefix = ".",
)
