# gazelle:kmp_export //app/model/reconciliation

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "reconciliation",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    exports = [
        "//app/importengineapi",
        "//app/model/core",
        "//app/model/reconciliation",
    ],
    deps = ["//utils/bigdecimal"],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":reconciliation",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    deps = [
        "//app/importengineapi",
        "//app/model/core",
        "//app/model/reconciliation",
        "//app/tasks",
        "//bazel/kmp/deps:kotlin_test",
        "//utils/bigdecimal",
        "@maven_kmp//:kotlinx_coroutines_test",
    ],
)
