# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web
# gazelle:kmp_forbid_deps //app/db/core //app/di/core //app/ui/core
# The engine is the sole writer, and only ImportEngineImpl may take a write repository.
# gazelle:kmp_forbid_reference \b[A-Za-z]+WriteRepository\b route writes through the ImportEngine (CLAUDE.md, "Database Writes")
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/ImportEngineImpl.kt
# gazelle:kmp_export //app/importengineapi
# gazelle:kmp_export //app/model/core
# gazelle:kmp_export //app/model/csv
# gazelle:kmp_export //app/model/passthrough
# gazelle:kmp_export //app/model/repository/read
# gazelle:kmp_export //app/model/repository/write
# gazelle:kmp_export //app/tasks jvmMain

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "importer",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    forbidden_reference = "\\b[A-Za-z]+WriteRepository\\b",
    forbidden_reference_allowed = ["src/commonMain/kotlin/com/moneymanager/importer/ImportEngineImpl.kt"],
    forbidden_reference_reason = "route writes through the ImportEngine (CLAUDE.md, \"Database Writes\")",
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = [
        "//app/importengineapi",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/passthrough",
        "//app/model/repository/read",
        "//app/model/repository/write",
        "//app/tasks",
    ],
    deps = [
        "//app/model/calendar",
        "//app/model/rules",
        "//utils/bigdecimal",
        "@maven_kmp//:kotlinx_coroutines_core",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":importer",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = [
        "//app/importengineapi",
        "//app/model/calendar",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/passthrough",
        "//app/model/rules",
        "//bazel/kmp/deps:kotlin_test",
        "//utils/bigdecimal",
        "@maven_kmp//:kotlinx_datetime",
    ],
)
