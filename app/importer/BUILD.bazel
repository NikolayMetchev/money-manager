# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/ConfigMutationWriter.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/ExistingTransferLoader.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/HandEdits.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/ImportEngineImpl.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/MatchSync.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/ObservationMaterialization.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/PersonResolver.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/ReconciliationCopier.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/ReferenceDataWriter.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/ReportedBalanceWriter.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/RerunSettlement.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/ReversalLinker.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/SourceObservations.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/TradeImporter.kt
# gazelle:kmp_allow_reference src/commonMain/kotlin/com/moneymanager/importer/TransferImporter.kt
