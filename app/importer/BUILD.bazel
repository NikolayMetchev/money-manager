# gazelle:kmp_export //app/model/csv
# gazelle:kmp_export //app/model/passthrough
# gazelle:kmp_export //app/model/repository/read
# gazelle:kmp_export //app/model/repository/write
# gazelle:kmp_export //app/tasks jvmMain

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "importer",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    forbidden_reference = "\\b[A-Za-z]+WriteRepository\\b",
    forbidden_reference_allowed = [
        "src/commonMain/kotlin/com/moneymanager/importer/ImportEngineImpl.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/MatchSync.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/ObservationMaterialization.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/HandEdits.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/ReconciliationCopier.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/RerunSettlement.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/SourceObservations.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/AccountResolver.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/PersonResolver.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/ConfigMutationWriter.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/ReversalLinker.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/ExistingTransferLoader.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/TransferWriter.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/ReferenceDataWriter.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/TradeImporter.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/TransferImporter.kt",
        "src/commonMain/kotlin/com/moneymanager/importer/ReportedBalanceWriter.kt",
    ],
    forbidden_reference_reason = "route writes through the ImportEngine (CLAUDE.md, \"Database Writes\")",
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = [
        "//app/importengineapi",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/passthrough",
        "//app/model/repository/read",
        "//app/model/repository/write",
        "//app/tasks",
    ],
    deps = [
        "//app/model/calendar",
        "//app/model/observation",
        "//app/model/rules",
        "//app/observationmatcher",
        "@maven_kmp//:kotlinx_coroutines_core",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":importer",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = [
        "//app/importengineapi",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/observation",
        "//app/model/passthrough",
        "//app/model/repository/read",
        "//app/model/rules",
        "//bazel/kmp/deps:kotlin_test",
        "//utils/bigdecimal",
        "@maven_kmp//:kotlinx_coroutines_test",
    ],
)
