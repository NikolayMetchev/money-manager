load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "importengineapi",
    android = True,
    android_deps = ["@maven_kmp//:cryptography_provider_jdk"],
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    jvm_deps = ["@maven_kmp//:cryptography_provider_jdk"],
    keep_deps = [
        "@maven_kmp//:cryptography_provider_jdk",
        "@maven_kmp//:cryptography_provider_openssl3_prebuilt",
        "@maven_kmp//:cryptography_provider_webcrypto",
    ],
    native_deps = ["@maven_kmp//:cryptography_provider_openssl3_prebuilt"],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    web_deps = ["@maven_kmp//:cryptography_provider_webcrypto"],
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = [
        "//app/model/accountmapping",
        "//app/model/apistrategy",
        "//app/model/calendar",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/csvstrategy",
        "//app/model/importdirectory",
        "//app/model/passthrough",
        "//app/model/repository/read",
        "//app/model/rules",
        "//app/tasks",
        "//utils/bigdecimal",
    ],
    deps = [
        "//app/model/observation",
        "//utils/regex",
        "@maven_kmp//:cryptography_core",
        "@maven_kmp//:kotlinx_coroutines_core",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":importengineapi",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    forbidden_deps = [
        "//app/db/core",
        "//app/di/core",
        "//app/ui/core",
    ],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = [
        "//app/model/core",
        "//app/model/observation",
        "//bazel/kmp/deps:kotlin_test",
        "@maven_kmp//:kotlinx_coroutines_test",
    ],
)
