load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "importdirectory",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    exports = [
        "//app/csvimporter",
        "//app/importengineapi",
        "//app/importfilesource/core",
        "//app/model/core",
        "//app/model/csv",
        "//app/model/csvstrategy",
        "//app/model/importdirectory",
        "//app/model/passthrough",
        "//app/model/qif",
        "//app/model/repository/read",
        "//app/tasks",
        "@maven_kmp//:kotlinx_coroutines_core",
    ],
    deps = ["//app/qifimporter"],
)

kmp_test(
    name = "test",
    associate = ":importdirectory",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    deps = [
        "//app/csvimporter",
        "//app/model/core",
        "//app/model/importdirectory",
        "//bazel/kmp/deps:kotlin_test",
    ],
)
