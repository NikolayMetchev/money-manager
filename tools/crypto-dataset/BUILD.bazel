load("@rules_java//java:java_binary.bzl", "java_binary")
load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

# gazelle:kmp_generate true
# gazelle:kmp_test_data //app/cryptodata:data/coins.tsv

kmp_library(
    name = "crypto-dataset",
    jvm_deps = [
        "//app/cryptodata",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_serialization_core",
        "@maven_kmp//:kotlinx_serialization_json",
        "@maven_kmp//:ktor_client_core",
        "@maven_kmp//:ktor_client_cio",
    ],
    jvm_srcs = glob(["src/main/kotlin/**/*.kt"]),
    plugins = ["serialization"],
    visibility = ["//visibility:public"],
)

kmp_test(
    name = "test",
    associate = ":crypto-dataset",
    data = ["//app/cryptodata:data/coins.tsv"],
    jvm_deps = [
        "//app/cryptodata",
        "//bazel/kmp/deps:kotlin_test",
    ],
    jvm_srcs = glob(["src/test/kotlin/**/*.kt"]),
    plugins = ["serialization"],
)

# generateCryptoDataset: `bazel run //tools/crypto-dataset:generate` rewrites app/cryptodata's coins.tsv from CoinGecko.
java_binary(
    name = "generate",
    args = ["app/cryptodata/data/coins.tsv"],
    main_class = "com.moneymanager.tools.cryptodataset.CryptoDatasetToolKt",
    runtime_deps = [":crypto-dataset_jvm"],
)
