{
    "version": "",
    "name": "Koinly",
    "identificationColumns": [
        "Date (UTC)",
        "Deleted",
        "Description",
        "Fee Amount",
        "Fee Currency",
        "Fee Value (read-only)",
        "Fee Worth Amount",
        "Fee Worth Currency",
        "From Amount",
        "From Currency",
        "From Source (read-only)",
        "From Wallet (read-only)",
        "From Wallet ID",
        "ID (read-only)",
        "Missing Cost Basis (read-only)",
        "Missing Rates (read-only)",
        "Negative Balances (read-only)",
        "Net Value (read-only)",
        "Net Worth Amount",
        "Net Worth Currency",
        "Synced To Accounting At (UTC read-only)",
        "Tag",
        "To Amount",
        "To Currency",
        "To Source (read-only)",
        "To Wallet (read-only)",
        "To Wallet ID",
        "TxDest",
        "TxHash",
        "TxSrc",
        "Type",
        "Value Currency (read-only)"
    ],
    "fieldMappings": {
        "AMOUNT": {
            "type": "com.moneymanager.domain.model.csvstrategy.export.AmountParsingExport",
            "fieldType": "AMOUNT",
            "mode": "SINGLE_COLUMN",
            "amountColumnName": "From Amount",
            "creditColumnName": null,
            "debitColumnName": null,
            "negateValues": false,
            "flipAccountsOnPositive": false,
            "feeColumnName": "Fee Amount",
            "feeConditions": [],
            "feeCurrencyColumnName": "Fee Currency",
            "feeCurrencyExtraction": {
                "pattern": "^([^;]*)",
                "outputTemplate": "$1"
            }
        },
        "CURRENCY": {
            "type": "com.moneymanager.domain.model.csvstrategy.export.CurrencyLookupExport",
            "fieldType": "CURRENCY",
            "columnName": "From Currency",
            "extraction": {
                "pattern": "^([^;]*)",
                "outputTemplate": "$1"
            }
        },
        "DESCRIPTION": {
            "type": "com.moneymanager.domain.model.csvstrategy.export.DirectColumnExport",
            "fieldType": "DESCRIPTION",
            "columnName": "Description",
            "fallbackColumns": [
                "Tag",
                "Type"
            ],
            "extraction": null
        },
        "SOURCE_ACCOUNT": {
            "type": "com.moneymanager.domain.model.csvstrategy.export.ConditionalAccountExport",
            "fieldType": "SOURCE_ACCOUNT",
            "conditions": [
                {
                    "columnName": "From Wallet (read-only)",
                    "operator": "IS_NOT_BLANK",
                    "value": null,
                    "otherColumnName": null
                }
            ],
            "whenTrue": {
                "type": "com.moneymanager.domain.model.csvstrategy.export.TemplateAccountExport",
                "fieldType": "SOURCE_ACCOUNT",
                "columnName": "From Wallet (read-only)",
                "prefix": "Koinly · ",
                "suffix": "",
                "defaultCategoryName": "Uncategorized",
                "extraction": {
                    "pattern": "^([^;]*)",
                    "outputTemplate": "$1"
                }
            },
            "whenFalse": {
                "type": "com.moneymanager.domain.model.csvstrategy.export.ConditionalAccountExport",
                "fieldType": "SOURCE_ACCOUNT",
                "conditions": [
                    {
                        "columnName": "Tag",
                        "operator": "IS_BLANK",
                        "value": null,
                        "otherColumnName": null
                    }
                ],
                "whenTrue": {
                    "type": "com.moneymanager.domain.model.csvstrategy.export.RegexAccountExport",
                    "fieldType": "SOURCE_ACCOUNT",
                    "columnName": "Type",
                    "rules": [
                        {
                            "pattern": "^",
                            "accountName": "Koinly: External",
                            "accountNameTemplate": null,
                            "counterpartyIsPerson": false,
                            "personNameTemplate": null
                        }
                    ],
                    "fallbackColumns": [],
                    "defaultCategoryName": "Uncategorized"
                },
                "whenFalse": {
                    "type": "com.moneymanager.domain.model.csvstrategy.export.RegexAccountExport",
                    "fieldType": "SOURCE_ACCOUNT",
                    "columnName": "Tag",
                    "rules": [
                        {
                            "pattern": "^(.+)$",
                            "accountName": "Koinly: Other",
                            "accountNameTemplate": "Koinly: $1",
                            "counterpartyIsPerson": false,
                            "personNameTemplate": null
                        }
                    ],
                    "fallbackColumns": [],
                    "defaultCategoryName": "Uncategorized"
                }
            }
        },
        "TARGET_ACCOUNT": {
            "type": "com.moneymanager.domain.model.csvstrategy.export.ConditionalAccountExport",
            "fieldType": "TARGET_ACCOUNT",
            "conditions": [
                {
                    "columnName": "To Wallet (read-only)",
                    "operator": "IS_NOT_BLANK",
                    "value": null,
                    "otherColumnName": null
                }
            ],
            "whenTrue": {
                "type": "com.moneymanager.domain.model.csvstrategy.export.TemplateAccountExport",
                "fieldType": "TARGET_ACCOUNT",
                "columnName": "To Wallet (read-only)",
                "prefix": "Koinly · ",
                "suffix": "",
                "defaultCategoryName": "Uncategorized",
                "extraction": {
                    "pattern": "^([^;]*)",
                    "outputTemplate": "$1"
                }
            },
            "whenFalse": {
                "type": "com.moneymanager.domain.model.csvstrategy.export.ConditionalAccountExport",
                "fieldType": "TARGET_ACCOUNT",
                "conditions": [
                    {
                        "columnName": "Tag",
                        "operator": "IS_BLANK",
                        "value": null,
                        "otherColumnName": null
                    }
                ],
                "whenTrue": {
                    "type": "com.moneymanager.domain.model.csvstrategy.export.RegexAccountExport",
                    "fieldType": "TARGET_ACCOUNT",
                    "columnName": "Type",
                    "rules": [
                        {
                            "pattern": "^",
                            "accountName": "Koinly: External",
                            "accountNameTemplate": null,
                            "counterpartyIsPerson": false,
                            "personNameTemplate": null
                        }
                    ],
                    "fallbackColumns": [],
                    "defaultCategoryName": "Uncategorized"
                },
                "whenFalse": {
                    "type": "com.moneymanager.domain.model.csvstrategy.export.RegexAccountExport",
                    "fieldType": "TARGET_ACCOUNT",
                    "columnName": "Tag",
                    "rules": [
                        {
                            "pattern": "^(.+)$",
                            "accountName": "Koinly: Other",
                            "accountNameTemplate": "Koinly: $1",
                            "counterpartyIsPerson": false,
                            "personNameTemplate": null
                        }
                    ],
                    "fallbackColumns": [],
                    "defaultCategoryName": "Uncategorized"
                }
            }
        },
        "TIMESTAMP": {
            "type": "com.moneymanager.domain.model.csvstrategy.export.DateTimeParsingExport",
            "fieldType": "TIMESTAMP",
            "dateColumnName": "Date (UTC)",
            "dateFormat": "yyyy-MM-dd",
            "timeColumnName": null,
            "timeFormat": null,
            "defaultTime": "12:00:00",
            "dateTimeFormat": "yyyy-MM-dd HH:mm:ss"
        },
        "TIMEZONE": {
            "type": "com.moneymanager.domain.model.csvstrategy.export.HardCodedTimezoneExport",
            "fieldType": "TIMEZONE",
            "timezoneId": "UTC"
        },
        "TO_AMOUNT": {
            "type": "com.moneymanager.domain.model.csvstrategy.export.AmountParsingExport",
            "fieldType": "TO_AMOUNT",
            "mode": "SINGLE_COLUMN",
            "amountColumnName": "To Amount",
            "creditColumnName": null,
            "debitColumnName": null,
            "negateValues": false,
            "flipAccountsOnPositive": false,
            "feeColumnName": null,
            "feeConditions": []
        },
        "TO_CURRENCY": {
            "type": "com.moneymanager.domain.model.csvstrategy.export.CurrencyLookupExport",
            "fieldType": "TO_CURRENCY",
            "columnName": "To Currency",
            "extraction": {
                "pattern": "^([^;]*)",
                "outputTemplate": "$1"
            }
        }
    },
    "attributeMappings": [
        {
            "columnName": "Deleted",
            "attributeTypeName": "excluded",
            "isUniqueIdentifier": false,
            "extraction": {
                "pattern": "^true$",
                "outputTemplate": "$0"
