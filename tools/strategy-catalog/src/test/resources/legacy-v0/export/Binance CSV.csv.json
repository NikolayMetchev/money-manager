            "pattern": "^\\s*\\d+\\s*$"
        }
    ],
    "accountMappings": [],
    "fileNamePattern": null,
    "crossSourceReconcileWindowSeconds": 3600,
    "conversionConfig": {
        "signalColumn": "Operation",
        "debitPattern": "^Small Assets Exchange BNB( \\(Spot\\))?$",
        "creditPattern": "^Small Assets Exchange BNB( \\(Spot\\))?$",
        "conversionAccountName": "Binance Conversions",
        "conversionAccountRules": [],
        "pairingKeyPattern": null,
