                {
                    "pattern": "^Staking Rewards$",
                    "accountName": "Binance Staking Rewards",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                },
                {
                    "pattern": "^BNB Vault Rewards$",
                    "accountName": "Binance Vault Rewards",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                },
                {
                    "pattern": "^Launchpool Subscription/Redemption$",
                    "accountName": "Binance Launchpool",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                },
                {
                    "pattern": "^Launchpool (Interest|Earnings Withdrawal)$",
                    "accountName": "Binance Launchpool Rewards",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                },
                {
                    "pattern": "^Launchpad (Subscribe|Token Distribution)$",
                    "accountName": "Binance Launchpad",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                },
                {
                    "pattern": "^(Distribution|Rewards Distribution)$",
                    "accountName": "Binance Distribution",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                },
                {
                    "pattern": "^Commission (History|Rebate)$",
                    "accountName": "Binance Commission",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                },
                {
                    "pattern": "^(Liquid Swap Add|Liquidity Farming Remove)$",
                    "accountName": "Binance Liquid Swap",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                },
                {
                    "pattern": "^Dual Savings (Purchase|Settlement)$",
                    "accountName": "Binance Dual Savings",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                },
                {
                    "pattern": "^(Fee|Transaction Fee)$",
                    "accountName": "Binance Fees",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                },
                {
                    "pattern": "^Small Assets Exchange BNB( \\(Spot\\))?$",
                    "accountName": "Binance Conversions",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                },
                {
                    "pattern": "^",
                    "accountName": "Binance Trading",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                }
            ],
            "fallbackColumns": [],
            "defaultCategoryName": "Uncategorized"
        },
        "TIMESTAMP": {
            "type": "com.moneymanager.domain.model.csvstrategy.export.DateTimeParsingExport",
            "fieldType": "TIMESTAMP",
            "dateColumnName": "UTC_Time",
            "dateFormat": "yyyy-MM-dd",
            "timeColumnName": null,
            "timeFormat": null,
            "defaultTime": "12:00:00",
            "dateTimeFormat": "yyyy-MM-dd HH:mm:ss"
        },
        "TIMEZONE": {
            "type": "com.moneymanager.domain.model.csvstrategy.export.HardCodedTimezoneExport",
            "fieldType": "TIMEZONE",
