    "tradeGroupConfig": {
        "signalColumn": "Operation",
        "debitPattern": "^(Sell|Transaction (Spend|Sold))$",
        "creditPattern": "^(Buy|Transaction (Buy|Revenue)|Binance Convert|Transaction Related)$",
        "sideAmountColumn": "Change",
