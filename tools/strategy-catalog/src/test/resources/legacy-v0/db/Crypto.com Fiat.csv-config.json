{
    "identificationColumns": [
        "Amount",
        "Currency",
        "Native Amount",
        "Native Amount (in USD)",
        "Native Currency",
        "Timestamp (UTC)",
        "To Amount",
        "To Currency",
        "Transaction Description",
        "Transaction Hash",
        "Transaction Kind"
    ],
    "fieldMappings": {
        "AMOUNT": {
            "type": "com.moneymanager.domain.model.csvstrategy.AmountParsingMapping",
            "fieldType": "AMOUNT",
            "mode": "SINGLE_COLUMN",
            "amountColumnName": "Amount",
            "creditColumnName": null,
            "debitColumnName": null,
            "negateValues": false,
            "flipAccountsOnPositive": true,
            "feeColumnName": null,
            "feeConditions": []
        },
        "CURRENCY": {
            "type": "com.moneymanager.domain.model.csvstrategy.CurrencyLookupMapping",
            "fieldType": "CURRENCY",
            "columnName": "Currency"
        },
        "DESCRIPTION": {
            "type": "com.moneymanager.domain.model.csvstrategy.DirectColumnMapping",
            "fieldType": "DESCRIPTION",
            "columnName": "Transaction Description",
            "fallbackColumns": [],
            "extraction": null
        },
        "SOURCE_ACCOUNT": {
            "type": "com.moneymanager.domain.model.csvstrategy.RegexAccountMapping",
            "fieldType": "SOURCE_ACCOUNT",
            "columnName": "Transaction Description",
            "rules": [
                {
                    "pattern": "^",
                    "accountName": "Crypto.com Cash",
                    "accountNameTemplate": null,
                    "counterpartyIsPerson": false,
                    "personNameTemplate": null
                }
            ],
            "fallbackColumns": [],
            "defaultCategoryId": -1
        },
        "TARGET_ACCOUNT": {
            "type": "com.moneymanager.domain.model.csvstrategy.ConditionalAccountMapping",
            "fieldType": "TARGET_ACCOUNT",
            "conditions": [
                {
                    "columnName": "Currency",
                    "operator": "NOT_EQUALS_COLUMN",
                    "value": null,
                    "otherColumnName": "To Currency"
                }
            ],
            "whenTrue": {
                "type": "com.moneymanager.domain.model.csvstrategy.RegexAccountMapping",
                "fieldType": "TARGET_ACCOUNT",
                "columnName": "Transaction Description",
                "rules": [
                    {
                        "pattern": "^",
                        "accountName": "Crypto.com",
                        "accountNameTemplate": null,
                        "counterpartyIsPerson": false,
                        "personNameTemplate": null
                    }
                ],
                "fallbackColumns": [],
                "defaultCategoryId": -1
            },
            "whenFalse": {
                "type": "com.moneymanager.domain.model.csvstrategy.RegexAccountMapping",
                "fieldType": "TARGET_ACCOUNT",
                "columnName": "Transaction Description",
                "rules": [
                    {
                        "pattern": "^Top Up Card$",
                        "accountName": "Crypto.com Card",
                        "accountNameTemplate": null,
                        "counterpartyIsPerson": false,
                        "personNameTemplate": null
                    },
                    {
                        "pattern": "^[A-Z]{3,5} (?:Deposit|Withdrawal) \\(via [A-Za-z ]+\\)$",
                        "accountName": "Bank Transfer",
                        "accountNameTemplate": "$0",
                        "counterpartyIsPerson": false,
                        "personNameTemplate": null,
                        "counterpartyIsUnidentified": true
                    }
                ],
                "fallbackColumns": [],
                "defaultCategoryId": -1
            }
        },
        "TIMESTAMP": {
            "type": "com.moneymanager.domain.model.csvstrategy.DateTimeParsingMapping",
            "fieldType": "TIMESTAMP",
            "dateColumnName": "Timestamp (UTC)",
            "dateFormat": "yyyy-MM-dd",
            "timeColumnName": null,
            "timeFormat": null,
            "defaultTime": "12:00:00",
            "dateTimeFormat": "yyyy-MM-dd HH:mm:ss"
        },
        "TIMEZONE": {
            "type": "com.moneymanager.domain.model.csvstrategy.HardCodedTimezoneMapping",
            "fieldType": "TIMEZONE",
            "timezoneId": "UTC"
        },
        "TO_AMOUNT": {
            "type": "com.moneymanager.domain.model.csvstrategy.AmountParsingMapping",
            "fieldType": "TO_AMOUNT",
            "mode": "SINGLE_COLUMN",
            "amountColumnName": "To Amount",
            "creditColumnName": null,
            "debitColumnName": null,
            "negateValues": false,
            "flipAccountsOnPositive": false,
            "feeColumnName": null,
            "feeConditions": []
        },
        "TO_CURRENCY": {
            "type": "com.moneymanager.domain.model.csvstrategy.CurrencyLookupMapping",
            "fieldType": "TO_CURRENCY",
            "columnName": "To Currency"
        }
    },
