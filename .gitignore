# Output of the retired Gradle build, still in older checkouts
.gradle/
build/
.kotlin/

# IntelliJ IDEA
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf
.idea/discord.xml
.idea/deploymentTargetSelector.xml
.idea/csv-editor.xml
.idea/artifacts/
.idea/caches/
*.iws
*.iml
out/

# OS
.DS_Store
Thumbs.db
NUL

# Local configuration
local.properties

# Local Google OAuth client for the desktop build (injected at build time; see
# secrets/google-oauth.properties.example). The example template is committed; the real file is not.
secrets/google-oauth.properties

# SQLDelight generated files (keep in source control)
# All generated files in build/ are already ignored above

# Claude — commands/skills are shared; only local session state is ignored
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
/hs_err_*.log
# Android Studio's Bazel plugin writes its sync aspect here on every sync.
.aswb/

# Qodana results and the .idea a local run moves aside; the profile and the bootstrap script are checked in.
.qodana/*
!.qodana/profile.xml
!.qodana/open-as-bazel.sh
# Monzo API session transcript fixtures
app/db/core/src/commonTest/resources/monzo/sample-apis/

# Generated SchemaSpy database docs (regenerated and published by CI)
webpage/database/
webpage/strategy-library/

# Generated Dokka KDoc API docs (regenerated and published by CI)
webpage/kdoc/

# Generated module dependency graph (regenerated and published by CI)
webpage/modules-graph.md

# Guard against a literal "~" directory accidentally created by un-expanded tilde paths
/~/
/profile.jfr

# Bazel convenience symlinks and personal settings
/bazel-*
# The last invocation's remote gRPC and execution logs (.bazelrc's `cache` config)
/bazel-remote-grpc.log
/execution_log.binpb.zst
/user.bazelrc
