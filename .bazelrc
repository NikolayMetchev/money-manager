common --enable_bzlmod

# Everything runs on MODULE.bazel's JDK (remotejdk_<its feature release>, which repin_jdk.py keeps in step), but
# compiles for Java 25, matching jvm_target in bazel/kmp/BUILD.bazel (the Kotlin toolchain): rules_kotlin's jvm_target
# stops at 25. Move the language versions and jvm_target together.
common --java_language_version=25
common --java_runtime_version=remotejdk_27
common --tool_java_language_version=25
common --tool_java_runtime_version=remotejdk_27

# Keep the host's PATH and environment out of action keys, so caches hit across machines.
common --incompatible_strict_action_env

# A test's friend is its module's own jar, as in KGP, not everything that module exports: K2 treats a friend's
# properties as the test's own and smart-casts them, so a `!!` Gradle needs reads as redundant (#1011).
common --@rules_kotlin//kotlin/settings:experimental_strict_associate_dependencies=true

test --test_output=errors

# Coverage: the JVM and Android host tests run under the IntelliJ coverage engine (Kover's agent), each writing a
# binary report with its results. bazel/kmp/testing/coverage.sh then merges them into one LCOV report.
common:coverage --define=coverage=intellij

# Platform-specific settings below (`common:linux`, `common:windows`, …) apply on their own host.
common --enable_platform_specific_config
# Tests read their data through runfiles, which Windows only lays out when asked.
common:windows --enable_runfiles
# Windows has no symlinks, so a runfiles tree is a copy (every JVM test's carries the JDK): lay one out only for a
# test or `run` that needs it, not for every target `bazel build //...` builds, which filled the runner's disk.
common:windows --nobuild_runfile_links

# STABLE_GIT_COMMIT, which only a stamped build (--stamp) reads: the release APK's VCS info (#1023).
common:linux --workspace_status_command=bazel/stamp/workspace_status.sh
common:macos --workspace_status_command=bazel/stamp/workspace_status.sh
common:windows --workspace_status_command=bazel/stamp/workspace_status.bat

# BuildBuddy (#1017). CI adds the API key (`--remote_header=x-buildbuddy-api-key=…`) to user.bazelrc; without
# one (a fork's PR) it runs on the restored disk cache alone.
# `cache`: the remote cache, and every invocation's results streamed to app.buildbuddy.io.
common:cache --bes_results_url=https://app.buildbuddy.io/invocation/
common:cache --bes_backend=grpcs://remote.buildbuddy.io
common:cache --remote_cache=grpcs://remote.buildbuddy.io
common:cache --remote_timeout=10m
# Download only what a person asked for; intermediate outputs stay in the cache.
common:cache --remote_download_toplevel
# A cache or BES hiccup slows a build down, it doesn't fail it.
common:cache --bes_upload_mode=fully_async
common:cache --remote_local_fallback
# BuildBuddy's suggestions: compressed and chunked (SplitBlob/SpliceBlob) transfers for large blobs, and the
# remote gRPC and compact execution logs of the last invocation, for troubleshooting a cache miss or a remote failure.
common:cache --remote_cache_compression
common:cache --experimental_remote_cache_chunking
common:cache --remote_grpc_log=bazel-remote-grpc.log
common:cache --execution_log_compact_file=execution_log.binpb.zst

# `rbe`: the cache, and every action run on BuildBuddy's Linux x64 executors (the Linux job only: macOS and
# Windows actions run on their GitHub runners, with the cache).
common:rbe --config=cache
common:rbe --remote_executor=grpcs://remote.buildbuddy.io
common:rbe --host_platform=//bazel/platforms:rbe_linux_x64
common:rbe --extra_execution_platforms=//bazel/platforms:rbe_linux_x64
common:rbe --jobs=100

# `rbe-mac`: CI's macOS job (#1089). Everything runs on the Mac but Kotlin/Native klib compiles: listing the bare
# host first keeps every other target on the Mac's own tools (Xcode, the Android SDK, its C++ toolchain), and
# klibs, which require `compiles_klibs`, resolve the Linux toolchain and run on BuildBuddy's executors.
common:rbe-mac --config=cache
common:rbe-mac --remote_executor=grpcs://remote.buildbuddy.io
common:rbe-mac --extra_execution_platforms=@platforms//host,//bazel/platforms:rbe_linux_x64
common:rbe-mac --spawn_strategy=worker,sandboxed,local
common:rbe-mac --strategy=KotlinNativeCompile=remote
common:rbe-mac --jobs=100

# Personal overrides (disk cache, jobs, …), not checked in. user.bazelrc.example turns BuildBuddy on locally.
try-import %workspace%/user.bazelrc
