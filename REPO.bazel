# Keep `//...` and Gazelle out of Gradle's output trees and other non-source directories.
ignore_directories([
    "**/build",
    "**/.gradle",
    "**/.kotlin",
    ".claude",
    ".idea",
    # The Pages site's generated parts, as Gradle writes them (//webpage:site builds its own).
    "webpage/database",
    "webpage/kdoc",
    "webpage/strategy-library",
])
