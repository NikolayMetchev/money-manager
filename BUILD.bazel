# Generates every Kotlin Multiplatform module's BUILD.bazel (//bazel/gazelle/kmp): bazel run //:gazelle
# CI's Auto-format PR job regenerates them on every PR; --mode=diff lists what a run would change.
load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("//bazel/kmp:module_info.bzl", "kmp_modules")

# gazelle:exclude bazel/gazelle/kmp/testdata

# The app version, compiled into app/di/core (#1011).
exports_files(["VERSION"])

# detekt's configuration, over its defaults (//bazel/kmp/lint, #1015).
exports_files(["detekt.yml"])

# The .editorconfig files no module's package owns (app/presenter's, app/ui's): every ktlint test carries them,
# at their own paths, and ktlint reads the ones above each file, as it does in the tree.
filegroup(
    name = "editorconfigs",
    # Depth-limited: `**` would walk every Gradle build directory in the tree.
    srcs = glob(
        [
            "*/.editorconfig",
            "*/*/.editorconfig",
            "*/*/*/.editorconfig",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Gazelle, then ktlint -F over the tree (#1015).
alias(
    name = "format",
    actual = "//bazel/kmp/lint:format",
)

gazelle_binary(
    name = "gazelle_bin",
    languages = ["//bazel/gazelle/kmp"],
    visibility = [
        "//bazel/gazelle/kmp:__pkg__",
        "//bazel/kmp/lint:__pkg__",
    ],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_bin",
)

