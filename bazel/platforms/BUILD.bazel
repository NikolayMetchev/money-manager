# Where CI's Linux job runs its actions: BuildBuddy's remote executors (#1017). `--config=rbe` makes it the
# host platform, so the Linux x64 Kotlin/Native toolchain and the host-only `mm` resolve as on a Linux runner.
platform(
    name = "rbe_linux_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04:latest",
    },
    visibility = ["//visibility:public"],
)
