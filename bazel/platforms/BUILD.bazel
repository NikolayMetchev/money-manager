# Where CI's Linux job runs its actions: BuildBuddy's remote executors (#1017). `--config=rbe` makes it the
# host platform, so the Linux x64 Kotlin/Native toolchain and the host-only `mm` resolve as on a Linux runner.
# The image is BuildBuddy's Ubuntu 24.04 one plus Skiko's libraries (`rbe/Dockerfile`), so the Compose UI tests run
# remotely too. .github/workflows/rbe-image.yml publishes it and prints the digest to pin here.
platform(
    name = "rbe_linux_x64",
    constraint_values = [
        ":compiles_klibs",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "container-image": "docker://ghcr.io/nikolaymetchev/money-manager/rbe-ubuntu24-04@sha256:f424a11ce854cf450edb1bee6c306f48c8fd4c0ca9253cbee91147a9be57d0a4",
    },
    visibility = ["//visibility:public"],
)

# Which execution platforms compile Kotlin/Native klibs (`kt_native_klib` requires it): every one but the bare
# host, which `rbe-mac` lists first so all else stays on the Mac while klibs compile on `rbe_linux_x64` (#1089).
constraint_setting(name = "klib_compiler")

constraint_value(
    name = "compiles_klibs",
    constraint_setting = ":klib_compiler",
    visibility = ["//visibility:public"],
)

# The host, registered in MODULE.bazel so a build without `rbe-mac` compiles klibs where it runs everything else.
platform(
    name = "host_klibs",
    constraint_values = [":compiles_klibs"],
    parents = ["@platforms//host"],
    visibility = ["//visibility:public"],
)

# Linux arm64, a target only: Kotlin/Native has no Linux arm64 host, so CI cross-links the linuxArm64 test
# binaries on x64 (`:<name>_linuxArm64_cross` transitions to this) and runs them on an arm64 runner.
platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

# Windows x64, as a target: CI's Linux job cross-links the mingwX64 test binaries (`:<name>_mingwX64_cross`
# transitions to this) and runs them on a Windows runner.
platform(
    name = "windows_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    visibility = ["//visibility:public"],
)

# macOS arm64, as a target: a Linux host compiles macosArm64 klibs for it (#1089), as CI's macOS job does on
# BuildBuddy's executors.
platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
)
