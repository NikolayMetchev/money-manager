load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

# gazelle:kmp_test_jvm_flags -Djava.awt.headless=true -Dskiko.test.harness=true
# gazelle:kmp_test_flaky true

kmp_library(
    name = "ui",
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    resources = glob(["src/jvmMain/resources/**"]),
    visibility = ["//visibility:public"],
)

kmp_test(
    name = "test",
    associate = ":ui",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    flaky = True,
    jvm_flags = [
        "-Djava.awt.headless=true",
        "-Dskiko.test.harness=true",
    ],
    resources = glob([
        "src/commonTest/resources/**",
        "src/jvmTest/resources/**",
    ]),
    deps = ["//bazel/kmp/deps:kotlin_test"],
)
