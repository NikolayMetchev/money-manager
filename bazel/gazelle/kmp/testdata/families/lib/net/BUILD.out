load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

# gazelle:kmp_export //lib/core

kmp_library(
    name = "net",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_deps = ["@maven_kmp//:ktor_client_okhttp"],
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    linux_deps = ["@maven_kmp//:ktor_client_curl"],
    linux_srcs = glob(["src/linuxMain/kotlin/**/*.kt"]),
    mingw_deps = ["@maven_kmp//:ktor_client_winhttp"],
    mingw_srcs = glob(["src/mingwMain/kotlin/**/*.kt"]),
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxX64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    exports = ["//lib/core"],
    deps = [
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:ktor_client_core",
    ],
)

kmp_test(
    name = "test",
    associate = ":net",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    jvm_deps = ["@maven_kmp//:kotlinx_coroutines_core"],
    jvm_srcs = glob(["src/jvmTest/kotlin/**/*.kt"]),
    native_srcs = glob(["src/nativeTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxX64",
        "mingwX64",
    ],
    deps = [
        "//bazel/kmp/deps:kotlin_test",
        "//fixture",
    ],
)
