    name = "modules",
    modules = [
        "//lib/app:app_module",
        "//lib/app:test_module",
        "//lib/files:files_module",
        "//lib/files:test_module",
        "//lib/server:server_module",
        "//lib/server:test_module",
        "//lib/ui:ui_module",
        "//main:main_module",
    ],
    visibility = ["//visibility:public"],
)
