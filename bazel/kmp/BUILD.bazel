load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain", "kt_kotlinc_options")
load("//bazel/kmp/plugins:plugins.bzl", "PLUGIN_ORDER")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
)

# The flags every Kotlin compile gets.
kt_kotlinc_options(
    name = "kotlinc_options",
    # allWarningsAsErrors.
    warn = "error",
    x_compiler_plugin_order = PLUGIN_ORDER,
    x_expect_actual_classes = True,
    # Gradle's default; rules_kotlin's is "class".
    x_lambdas = "indy",
)

define_kt_toolchain(
    name = "kotlin_toolchain",
    # A dependency used only through another's exports is Gradle's api, not a strict-deps violation. The
    # unused half is //bazel/kmp/checks's kmp_unused_deps: rules_kotlin's also counts what a dep re-exports.
    experimental_strict_kotlin_deps = "error",
    # Downstream compiles see ABI jars, so a body-only change doesn't recompile dependents. The ABI keeps
    # Metro's contribution hints (metro/hints) and Compose's $stable fields; a module whose dependents need
    # more opts out with `tags = ["kt_abi_plugin_incompatible"]` on its kmp_library.
    experimental_use_abi_jars = True,
    # .bazelrc's java_language_version (the JDK the build runs is newer: rules_kotlin's values stop at 25).
    jvm_target = "25",
    kotlinc_options = ":kotlinc_options",
)
