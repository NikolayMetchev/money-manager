load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain", "kt_kotlinc_options")
load("//bazel/kmp/plugins:plugins.bzl", "PLUGIN_ORDER")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
)

# The flags every Kotlin compile gets.
kt_kotlinc_options(
    name = "kotlinc_options",
    # allWarningsAsErrors.
    warn = "error",
    x_compiler_plugin_order = PLUGIN_ORDER,
    x_expect_actual_classes = True,
    # Gradle's default; rules_kotlin's is "class".
    x_lambdas = "indy",
)

define_kt_toolchain(
    name = "kotlin_toolchain",
    # A dependency used only through another's exports is Gradle's api, not a strict-deps violation. The
    # unused half is //bazel/kmp/checks's kmp_unused_deps: rules_kotlin's also counts what a dep re-exports.
    experimental_strict_kotlin_deps = "error",
    # Never strip downstream compile jars to ABI jars: Metro's contribution hints (#1002) and Compose's
    # stability metadata live in what an ABI jar drops.
    experimental_use_abi_jars = False,
    # The JDK .bazelrc runs (java_language_version).
    jvm_target = "25",
    kotlinc_options = ":kotlinc_options",
)
