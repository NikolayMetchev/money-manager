load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_binary")

# `--define=bundle_native_cli=true` puts the host's native mm in the desktop app (Gradle's -PbundleNativeCli=true).
config_setting(
    name = "bundle_native_cli",
    define_values = {"bundle_native_cli": "true"},
    visibility = ["//visibility:public"],
)

# `--define=aot=false` packages the app image without the AOT caches (#1273): training runs each launcher and takes
# minutes, so pull requests skip it on the slow runners. Releases and main keep it.
config_setting(
    name = "no_aot",
    define_values = {"aot": "false"},
    visibility = ["//visibility:public"],
)

# jlink and jpackage, with the Compose Gradle plugin's jar for its default icons and entitlements (see
# JPackageRunner.kt).
kt_jvm_binary(
    name = "runner",
    srcs = ["src/com/moneymanager/bazel/kmp/jpackage/JPackageRunner.kt"],
    main_class = "com.moneymanager.bazel.kmp.jpackage.JPackageRunnerKt",
    visibility = ["//visibility:public"],
    runtime_deps = ["@r8//:org_jetbrains_compose_compose_gradle_plugin"],
)
