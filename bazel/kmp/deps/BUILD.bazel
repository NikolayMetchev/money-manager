# What modules depend on besides Maven libraries (those are `@maven_kmp//:<catalog alias>`, see
# extensions.bzl): kotlin("test"). Compiler plugins are //bazel/kmp/plugins. Like modules, each has one target per platform:
# `<name>_jvm`, `<name>_linuxX64`, …
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")
load("//bazel/kmp:metadata.bzl", "kt_metadata_group")
load("//bazel/kmp:native.bzl", "kt_native_group")

package(default_visibility = ["//visibility:public"])

NATIVE_TARGETS = [
    "linuxArm64",
    "linuxX64",
    "macosArm64",
    "mingwX64",
]

# kotlin("test") on the JVM: kotlin-test plus its JUnit 4 binding, as KGP infers for a JUnit 4 test task.
kt_jvm_library(
    name = "kotlin_test_jvm",
    exports = [
        "@maven_kmp//:junit_jvm",
        "@rules_kotlin//kotlin/compiler:kotlin-test",
        "@rules_kotlin//kotlin/compiler:kotlin-test-junit",
    ],
)

# compose.desktop.currentOs (#1018): Compose Desktop with the Skiko runtime of the platform the JVM runs on.
# Gradle's plugin picks it from the build machine; here it's the target platform, the same thing outside
# cross-compiles.
_DESKTOP_OS = {
    "linux_arm64": [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    "linux_x64": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    "macos_arm64": [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    "macos_x64": [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
    "windows_x64": [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
}

[
    config_setting(
        name = "desktop_" + os,
        constraint_values = constraints,
    )
    for os, constraints in _DESKTOP_OS.items()
]

kt_jvm_library(
    name = "compose_desktop_current_os_jvm",
    exports = select({
        ":desktop_" + os: ["@maven_kmp//:compose_desktop_%s_jvm" % os]
        for os in _DESKTOP_OS
    }),
)

# kotlin("reflect"), at the compiler's version (JVM only).
kt_jvm_library(
    name = "kotlin_reflect_jvm",
    exports = ["@rules_kotlin//kotlin/compiler:kotlin-reflect"],
)

# On native, kotlin.test is part of the distribution's stdlib.
[
    kt_native_group(
        name = "kotlin_test_" + target,
        target = target,
    )
    for target in NATIVE_TARGETS
]

# Common code sees kotlin-test's common metadata, resolved with the stdlib's (#1010).
kt_metadata_group(
    name = "kotlin_test_metadata",
    deps = ["@maven_kmp//:org_jetbrains_kotlin_kotlin_test_metadata"],
)

# Fails when a lockfile no longer matches its MODULE.bazel maven_kmp.install or the catalog.
test_suite(
    name = "maven_kmp_lock_test",
    tests = [
        "@detekt_cli//:lock_test",
        "@ktlint_cli//:lock_test",
        "@maven_kmp//:lock_test",
    ],
)
