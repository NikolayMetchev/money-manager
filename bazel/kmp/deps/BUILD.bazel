# What modules depend on besides Maven libraries (those are `@maven_kmp//:<catalog alias>`, see
# extensions.bzl): kotlin("test"). Compiler plugins are //bazel/kmp/plugins. Like modules, each has one target per platform:
# `<name>_jvm`, `<name>_linuxX64`, …
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")
load("//bazel/kmp:native.bzl", "kt_native_group")

package(default_visibility = ["//visibility:public"])

NATIVE_TARGETS = [
    "linuxArm64",
    "linuxX64",
    "macosArm64",
    "mingwX64",
]

# kotlin("test") on the JVM: kotlin-test plus its JUnit 4 binding, as KGP infers for a JUnit 4 test task.
kt_jvm_library(
    name = "kotlin_test_jvm",
    exports = [
        "@maven_kmp//:junit_jvm",
        "@rules_kotlin//kotlin/compiler:kotlin-test",
        "@rules_kotlin//kotlin/compiler:kotlin-test-junit",
    ],
)

# On native, kotlin.test is part of the distribution's stdlib.
[
    kt_native_group(
        name = "kotlin_test_" + target,
        target = target,
    )
    for target in NATIVE_TARGETS
]

# Fails when maven_kmp.lock.json no longer matches MODULE.bazel's maven_kmp.install or the catalog.
test_suite(
    name = "maven_kmp_lock_test",
    tests = ["@maven_kmp//:lock_test"],
)
