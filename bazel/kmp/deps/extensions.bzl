"""`maven_kmp` module extension: Kotlin Multiplatform libraries from the KMP lockfile (#1000).

`bazel run @maven_kmp//:pin` resolves the install's `artifacts` for every platform with
//bazel/kmp/resolver (Gradle Module Metadata, not POMs) into `maven_kmp.lock.json`. This extension turns the
lockfile into one `http_file` per file and the hub repository `@maven_kmp`, where each library has a target
per platform, named like modules: `@maven_kmp//:kotlinx_io_core_jvm`, `…:kotlinx_io_core_linuxX64`.
On the `metadata` platform (#1010) a library is the common metadata jar instead, extracted with one filegroup
per source set the resolver found our targets all see (`kotlinx_io_core_metadata`).

Each `install` is its own resolution and hub repository (`name`, default `maven_kmp`), as each Gradle configuration
resolves on its own. The build's JVM tools are plain Maven artifacts and use rules_jvm_external's `maven` instead.

When MODULE.bazel no longer matches what the lockfile was resolved from, the build keeps using
the lockfile, and `//bazel/kmp/deps:maven_kmp_lock_test` fails with the command that re-pins it.
"""

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive", "http_file")

def _module(coordinates):
    parts = coordinates.split(":")
    if len(parts) != 3 or not all(parts):
        fail("maven_kmp.install: want group:artifact:version, got %r" % coordinates)
    return parts[0] + ":" + parts[1]

def _expected_inputs(install):
    for module in install.classpath_forces:
        if module in install.forces:
            fail("maven_kmp.install: %s is in both forces and classpath_forces" % module)
    for coordinates in install.artifacts.values():
        _module(coordinates)
    inputs = {
        "excludes": install.excludes,
        "forces": install.forces,
        "libraries": install.artifacts,
        "platforms": install.platforms,
    }
    if install.android_aars:
        inputs["android_aars"] = install.android_aars
    if install.classpath_forces:
        inputs["classpath_forces"] = install.classpath_forces
    if install.library_platforms:
        inputs["library_platforms"] = install.library_platforms
    if install.npm:
        inputs["npm"] = install.npm
    if install.npm_forces:
        inputs["npm_forces"] = install.npm_forces
    return inputs

def _file_repo(file):
    return "maven_kmp_%s_%s" % (file["sha256"][:12], "".join([c if c.isalnum() else "_" for c in file["name"].elems()]))

_HEADER = """\
# Generated by //bazel/kmp/deps:extensions.bzl from maven_kmp.lock.json.
load("@money_manager//bazel/kmp:metadata.bzl", "kt_metadata_group", "kt_metadata_import")
load("@money_manager//bazel/kmp:native.bzl", "kt_native_group", "kt_native_import")
load("@money_manager//bazel/kmp:web.bzl", "kt_web_group", "kt_web_import")
load("@rules_java//java:java_library.bzl", "java_library")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_import")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

sh_binary(
    name = "pin",
    srcs = ["pin.sh"],
    args = {pin_args},
    data = ["@money_manager//bazel/kmp/resolver"],
)

sh_test(
    name = "lock_test",
    srcs = ["lock_test.sh"],
)
"""

def _labels(names, modules, platform):
    return ['":%s_%s"' % (names[m], platform) for m in modules]

def _through_redirects(artifacts, modules, platform):
    """`modules`, with each that has no files on `platform` replaced by what it redirects to, transitively:
    kt_jvm_import's exports only take Kotlin targets."""
    out = []
    queue = list(modules)
    seen = {}
    for _ in range(10000):
        if not queue:
            break
        module = queue.pop(0)
        if module in seen:
            continue
        seen[module] = True
        resolved = artifacts.get(module, {}).get(platform)
        if resolved and not resolved["files"]:
            queue.extend(resolved.get("deps", []))
        else:
            out.append(module)
    return out

_METADATA = "metadata"

# The common metadata of modules that also compile for the browser: the source sets the web platforms share too.
_METADATA_WEB = "metadataWeb"

_METADATA_PLATFORMS = (_METADATA, _METADATA_WEB)

_WEB = ("wasmJs", "js")

_NEVERLINK = "_neverlink"

def _metadata_build(source_sets):
    return "\n".join([
        'filegroup(name = "%s", srcs = glob(["%s/**"]), visibility = ["//visibility:public"])' % (s, s)
        for s in source_sets
    ]) + "\n"

_ANDROID = "android"

# An AAR: its classes.jar, merged with the jars it bundles (`libs/`) when it has any, as kt_jvm_import takes one jar,
# and its Android parts for the app (`aar_import`).
_AAR_BUILD = """\
load("@money_manager//bazel/kmp/android:aar.bzl", "aar_import")

LIBS = glob(["libs/*.jar"], allow_empty = True)

[genrule(
    name = "merged",
    srcs = ["classes.jar"] + LIBS,
    outs = ["merged.jar"],
    cmd = "$(execpath @bazel_tools//tools/jdk:singlejar) --exclude_build_data --output $@ --sources $(SRCS)",
    tools = ["@bazel_tools//tools/jdk:singlejar"],
) for _ in LIBS[:1]]

aar_import(
    name = "jar",
    jar = ":merged" if LIBS else "classes.jar",
    manifest = "AndroidManifest.xml",
    res = glob(["res/**"], allow_empty = True),
    r_txt = glob(["R.txt"], allow_empty = True),
    assets = glob(["assets/**"], allow_empty = True),
    jni = glob(["jni/**"], allow_empty = True),
    proguard = glob(["proguard.txt"], allow_empty = True),
    art_profile = glob(["baseline-prof.txt"], allow_empty = True),
    lint_jar = glob(["lint.jar"], allow_empty = True),
    public_txt = glob(["public.txt"], allow_empty = True),
    annotations = glob(["annotations.zip"], allow_empty = True),
    visibility = ["//visibility:public"],
)
"""

def _is_aar(file):
    return file["name"].endswith(".aar")

def _npm_repo(key):
    return "npm_" + "".join([c if c.isalnum() else "_" for c in key.elems()])

# An npm package's tarball, for the browser programs' `node_modules`.
_NPM_BUILD = """\
load("@money_manager//bazel/kmp:web.bzl", "npm_package")

npm_package(
    name = "package",
    package_name = {name},
    srcs = glob(["**"], exclude = ["BUILD.bazel", "REPO.bazel", "WORKSPACE"]),
    deps = {deps},
    visibility = ["//visibility:public"],
)
"""

def _npm_labels(deps):
    return ['"@%s//:package"' % _npm_repo(n + "@" + v) for n, v in sorted(deps.items())]

def _file_label(file):
    return '"@%s//%s"' % (_file_repo(file), ":jar" if _is_aar(file) else "file")

def _target(name, platform, resolved, names, artifacts):
    deps = _labels(names, _through_redirects(artifacts, resolved.get("deps", []), platform), platform)
    compile_only = [
        label[:-1] + _NEVERLINK + '"'
        for label in _labels(names, _through_redirects(artifacts, resolved.get("compile_only_deps", []), platform), platform)
    ]
    runtime = _labels(names, resolved.get("runtime_deps", []), platform)
    files = [_file_label(f) for f in resolved["files"] or []]
    full = "%s_%s" % (name, platform)
    if platform in _METADATA_PLATFORMS:
        if not resolved.get("source_sets"):
            return 'kt_metadata_group(name = "%s", deps = [%s])\n' % (full, ", ".join(deps))
        source_sets = ['"@%s//:%s"' % (_file_repo(f), s) for f in resolved["files"] for s in resolved["source_sets"]]
        return 'kt_metadata_import(name = "%s", source_sets = [%s], deps = [%s])\n' % (full, ", ".join(source_sets), ", ".join(deps))
    # Android libraries compile like JVM ones, against the SDK's android.jar.
    if platform in ("jvm", _ANDROID):
        if not files:
            return 'java_library(name = "%s", exports = [%s], runtime_deps = [%s])\n' % (full, ", ".join(deps + compile_only), ", ".join(runtime))

        # kt_jvm_import, not java_import: an interface jar would drop the inline function bodies Kotlin
        # inlines from a library. Its neverlink twin is what a compile-only dependency on it exports.
        return 'kt_jvm_import(name = "%s", jars = [%s], exports = [%s], runtime_deps = [%s])\n' % (
            full,
            ", ".join(files),
            ", ".join(deps + compile_only),
            ", ".join(runtime),
        ) + 'kt_jvm_import(name = "%s%s", jars = [%s], neverlink = True)\n' % (full, _NEVERLINK, ", ".join(files))
    kind = "web" if platform in _WEB else "native"
    if kind == "web":
        # A klib's runtime-only dependencies only matter to the link, which takes every klib its deps reach.
        deps = deps + _labels(names, _through_redirects(artifacts, resolved.get("runtime_deps", []), platform), platform)
    if not files:
        return 'kt_%s_group(name = "%s", target = "%s", deps = [%s])\n' % (kind, full, platform, ", ".join(deps))
    npm = ", npm = [%s]" % ", ".join(_npm_labels(resolved["npm"])) if resolved.get("npm") else ""
    return 'kt_%s_import(name = "%s", target = "%s", klibs = [%s], deps = [%s]%s)\n' % (
        kind,
        full,
        platform,
        ", ".join(files),
        ", ".join(deps),
        npm,
    )

_PIN_SH = """\
#!/usr/bin/env bash
set -euo pipefail
resolver="$(pwd)/$1"
shift
cd "$BUILD_WORKSPACE_DIRECTORY"
exec "$resolver" "$@"
"""

def _hub_impl(rctx):
    rctx.file("BUILD.bazel", rctx.attr.build_file_content)
    rctx.file("pin.sh", _PIN_SH, executable = True)
    if rctx.attr.stale:
        # A quoted heredoc: the message names commands in backticks, which `echo "…"` would run.
        script = "#!/usr/bin/env bash\ncat >&2 <<'EOF'\n%s\nEOF\nexit 1\n" % rctx.attr.stale
    else:
        script = "#!/usr/bin/env bash\nexit 0\n"
    rctx.file("lock_test.sh", script, executable = True)

_hub = repository_rule(
    implementation = _hub_impl,
    attrs = {
        "build_file_content": attr.string(),
        "stale": attr.string(doc = "Why the lockfile is out of date, or empty."),
    },
)

def _lock_path(label):
    return (label.package + "/" + label.name) if label.package else label.name

def _install(module_ctx, install, files, archives, npm):
    """One install: its hub repository's BUILD content and why its lockfile is stale (or "")."""
    lock_path = _lock_path(install.lock_file)
    lock = json.decode(module_ctx.read(install.lock_file))
    stale = ""
    if lock["inputs"] != _expected_inputs(install):
        stale = ("%s is out of date with MODULE.bazel's maven_kmp.install(name = %r). " % (lock_path, install.name) +
                 "Re-pin with `bazel run @%s//:pin`." % install.name)

    names = lock["names"]
    npm.update(lock.get("npm", {}))
    targets = []
    metadata_sets = {}
    for module in sorted(lock["artifacts"]):
        for platform in sorted(lock["artifacts"][module]):
            resolved = lock["artifacts"][module][platform]
            # A module that only redirects (a JetBrains fork naming the AndroidX original) has no files.
            for f in resolved["files"] or []:
                if platform in _METADATA_PLATFORMS:
                    # One jar serves both metadata platforms; `metadataWeb` sees a subset of its source sets.
                    if resolved.get("source_sets"):
                        source_sets = metadata_sets.setdefault(_file_repo(f), {})
                        for s in resolved["source_sets"]:
                            source_sets[s] = True
                        archives[_file_repo(f)] = (f, _metadata_build(sorted(source_sets)))
                elif _is_aar(f):
                    archives[_file_repo(f)] = (f, _AAR_BUILD)
                else:
                    files[_file_repo(f)] = f
            targets.append(_target(names[module], platform, resolved, names, lock["artifacts"]))

    pin_args = ["$(rootpath @money_manager//bazel/kmp/resolver)", "--lock", lock_path]
    pin_args += ["--kotlin", install.kotlin]
    pin_args += ["--library=%s=%s" % (a, c) for a, c in sorted(install.artifacts.items())]
    pin_args += ["--library-platforms=%s=%s" % (a, ",".join(p)) for a, p in sorted(install.library_platforms.items())]
    pin_args += ["--platform=" + p for p in install.platforms]
    pin_args += ["--force=%s=%s" % (m, v) for m, v in sorted(install.forces.items())]
    pin_args += ["--classpath-force=%s=%s" % (m, v) for m, v in sorted(install.classpath_forces.items())]
    pin_args += ["--repository=" + r for r in install.repositories]
    pin_args += ["--exclude=" + e for e in install.excludes]
    pin_args += ["--android-aar=" + m for m in install.android_aars]
    pin_args += ["--npm=%s=%s" % (a, p) for a, p in sorted(install.npm.items())]
    pin_args += ["--npm-force=%s=%s" % (n, v) for n, v in sorted(install.npm_forces.items())]
    for alias, key in sorted(lock.get("npm_libraries", {}).items()):
        name = "".join([c if c.isalnum() else "_" for c in alias.elems()])
        for platform in _WEB:
            targets.append('kt_web_group(name = "%s_%s", target = "%s", npm = ["@%s//:package"])\n' % (name, platform, platform, _npm_repo(key)))
    for alias, actual in sorted(install.aliases.items()):
        targets.append('alias(name = "%s", actual = ":%s")\n' % (alias, actual))
    return _HEADER.format(pin_args = repr(pin_args)) + "\n" + "\n".join(targets), stale

def _maven_kmp_impl(module_ctx):
    installs = [tag for mod in module_ctx.modules if mod.is_root for tag in mod.tags.install]
    if not installs:
        fail("maven_kmp: expected an install tag in the root module")
    # Files several installs share are one repository each.
    files = {}
    archives = {}
    npm = {}
    for install in installs:
        content, stale = _install(module_ctx, install, files, archives, npm)
        _hub(name = install.name, build_file_content = content, stale = stale)
    for repo, f in files.items():
        http_file(name = repo, urls = [f["url"]], sha256 = f["sha256"], downloaded_file_path = f["name"])
    for repo, (f, build) in archives.items():
        http_archive(
            name = repo,
            urls = [f["url"]],
            sha256 = f["sha256"],
            type = "zip",
            build_file_content = build,
        )
    for key, package in npm.items():
        http_archive(
            name = _npm_repo(key),
            urls = [package["url"]],
            integrity = package["integrity"],
            strip_prefix = "package",
            build_file_content = _NPM_BUILD.format(name = repr(package["name"]), deps = "[%s]" % ", ".join(_npm_labels(package.get("deps", {})))),
        )
    return module_ctx.extension_metadata(reproducible = True)

maven_kmp = module_extension(
    implementation = _maven_kmp_impl,
    tag_classes = {
        "install": tag_class(attrs = {
            "aliases": attr.string_dict(
                doc = "name → one of the hub's targets, for a tool that expects another name for it (rules_jvm_external's).",
            ),
            "android_aars": attr.string_list(
                doc = "group:artifact whose POM says jar but whose release also has an AAR, which Android takes.",
            ),
            "artifacts": attr.string_dict(
                doc = "alias → group:artifact:version: the libraries to resolve, named by alias in the hub.",
            ),
            "classpath_forces": attr.string_dict(
                doc = "group:artifact → version: Gradle's classpath substitutions, so JVM and metadata only.",
            ),
            "excludes": attr.string_list(doc = "group:artifact never resolved, whoever depends on it."),
            "forces": attr.string_dict(
                doc = "group:artifact → version on every platform, whoever asks for it (Gradle's `configurations.all`).",
            ),
            "kotlin": attr.string(
                mandatory = True,
                doc = "The Kotlin release the toolchain's stdlib and kotlin-test are; never resolved from Maven.",
            ),
            "library_platforms": attr.string_list_dict(
                doc = """alias → the platforms it resolves for (default: all), as Gradle only resolves a library for
                the source sets declaring it: the desktop Compose jars are no Android library.""",
            ),
            "lock_file": attr.label(mandatory = True),
            "npm": attr.string_dict(
                doc = "alias → name@version: npm packages our browser code imports, a target per browser platform.",
            ),
            "npm_forces": attr.string_dict(doc = "npm name → version, whoever asks for it (Yarn's `resolutions`)."),
            "name": attr.string(
                default = "maven_kmp",
                doc = "The hub repository. Each install resolves on its own, as each Gradle configuration does " +
                      "into its own lockfile.",
            ),
            "platforms": attr.string_list(
                doc = "android, jvm, metadata, metadataWeb, linuxX64, linuxArm64, macosArm64, mingwX64, wasmJs, js.",
            ),
            "repositories": attr.string_list(doc = "url[=group-regex,…], in order."),
        }),
    },
)
