"""`maven_kmp` module extension: Kotlin Multiplatform libraries from the KMP lockfile (#1000).

`bazel run @maven_kmp//:pin` resolves the configured catalog libraries for every platform with
//bazel/kmp/resolver (Gradle Module Metadata, not POMs) into `maven_kmp.lock.json`. This extension turns the
lockfile into one `http_file` per file and the hub repository `@maven_kmp`, where each library has a target
per platform, named like modules: `@maven_kmp//:kotlinx_io_core_jvm`, `…:kotlinx_io_core_linuxX64`.

When MODULE.bazel or the catalog no longer match what the lockfile was resolved from, the build keeps using
the lockfile, and `//bazel/kmp/deps:maven_kmp_lock_test` fails with the command that re-pins it.
"""

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

def _strip_comment(line):
    quoted = False
    for i in range(len(line)):
        c = line[i]
        if c == '"':
            quoted = not quoted
        elif c == "#" and not quoted:
            return line[:i].strip()
    return line.strip()

def _catalog(text):
    """The catalog's [versions] and [libraries] (`module` + `version.ref`), as the resolver reads them."""
    versions = {}
    libraries = {}
    table = ""
    for raw in text.splitlines():
        line = _strip_comment(raw)
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            table = line[1:-1]
            continue
        key, sep, value = line.partition("=")
        if not sep:
            continue
        key = key.strip()
        value = value.strip()
        if table == "versions" and value.startswith('"'):
            versions[key] = value.strip('"')
        elif table == "libraries" and value.startswith("{"):
            fields = {}
            for field in value.strip("{} ").split(","):
                k, _, v = field.partition("=")
                fields[k.strip()] = v.strip().strip('"')
            libraries[key] = fields
    return versions, libraries

def _expected_inputs(versions, libraries, install):
    libs = {}
    for alias in install.libraries:
        lib = libraries.get(alias)
        if not lib or "module" not in lib:
            fail("maven_kmp.install: %s isn't a `module = …` library in the catalog" % alias)
        libs[alias] = "%s:%s" % (lib["module"], versions.get(lib.get("version.ref"), lib.get("version", "")))
    forces = {module: versions.get(ref, "?" + ref) for module, ref in install.forces.items()}
    return {"excludes": install.excludes, "forces": forces, "libraries": libs, "platforms": install.platforms}

def _file_repo(file):
    return "maven_kmp_%s_%s" % (file["sha256"][:12], "".join([c if c.isalnum() else "_" for c in file["name"].elems()]))

_HEADER = """\
# Generated by //bazel/kmp/deps:extensions.bzl from maven_kmp.lock.json.
load("@money_manager//bazel/kmp:native.bzl", "kt_native_group", "kt_native_import")
load("@rules_java//java:java_library.bzl", "java_library")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_import")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

sh_binary(
    name = "pin",
    srcs = ["pin.sh"],
    args = {pin_args},
    data = ["@money_manager//bazel/kmp/resolver"],
)

sh_test(
    name = "lock_test",
    srcs = ["lock_test.sh"],
)
"""

def _labels(names, modules, platform):
    return ['":%s_%s"' % (names[m], platform) for m in modules]

def _through_redirects(artifacts, modules, platform):
    """`modules`, with each that has no files on `platform` replaced by what it redirects to, transitively:
    kt_jvm_import's exports only take Kotlin targets."""
    out = []
    queue = list(modules)
    seen = {}
    for _ in range(10000):
        if not queue:
            break
        module = queue.pop(0)
        if module in seen:
            continue
        seen[module] = True
        resolved = artifacts.get(module, {}).get(platform)
        if resolved and not resolved["files"]:
            queue.extend(resolved.get("deps", []))
        else:
            out.append(module)
    return out

def _target(name, platform, resolved, names, artifacts):
    deps = _labels(names, _through_redirects(artifacts, resolved.get("deps", []), platform), platform)
    runtime = _labels(names, resolved.get("runtime_deps", []), platform)
    files = ['"@%s//file"' % _file_repo(f) for f in resolved["files"] or []]
    full = "%s_%s" % (name, platform)
    if platform == "jvm":
        if not files:
            return 'java_library(name = "%s", exports = [%s], runtime_deps = [%s])\n' % (full, ", ".join(deps), ", ".join(runtime))

        # kt_jvm_import, not java_import: an interface jar would drop the inline function bodies Kotlin
        # inlines from a library.
        return 'kt_jvm_import(name = "%s", jars = [%s], exports = [%s], runtime_deps = [%s])\n' % (
            full,
            ", ".join(files),
            ", ".join(deps),
            ", ".join(runtime),
        )
    if not files:
        return 'kt_native_group(name = "%s", target = "%s", deps = [%s])\n' % (full, platform, ", ".join(deps))
    return 'kt_native_import(name = "%s", target = "%s", klibs = [%s], deps = [%s])\n' % (
        full,
        platform,
        ", ".join(files),
        ", ".join(deps),
    )

_PIN_SH = """\
#!/usr/bin/env bash
set -euo pipefail
resolver="$(pwd)/$1"
shift
cd "$BUILD_WORKSPACE_DIRECTORY"
exec "$resolver" "$@"
"""

def _hub_impl(rctx):
    rctx.file("BUILD.bazel", rctx.attr.build_file_content)
    rctx.file("pin.sh", _PIN_SH, executable = True)
    if rctx.attr.stale:
        script = "#!/usr/bin/env bash\necho %s >&2\nexit 1\n" % repr(rctx.attr.stale)
    else:
        script = "#!/usr/bin/env bash\nexit 0\n"
    rctx.file("lock_test.sh", script, executable = True)

_hub = repository_rule(
    implementation = _hub_impl,
    attrs = {
        "build_file_content": attr.string(),
        "stale": attr.string(doc = "Why the lockfile is out of date, or empty."),
    },
)

def _maven_kmp_impl(module_ctx):
    installs = [tag for mod in module_ctx.modules if mod.is_root for tag in mod.tags.install]
    if len(installs) != 1:
        fail("maven_kmp: expected one install tag in the root module, got %d" % len(installs))
    install = installs[0]
    lock = json.decode(module_ctx.read(install.lock_file))
    versions, libraries = _catalog(module_ctx.read(install.catalog))
    expected = _expected_inputs(versions, libraries, install)
    stale = ""
    if lock["inputs"] != expected:
        stale = ("bazel/kmp/deps/maven_kmp.lock.json is out of date with MODULE.bazel's maven_kmp.install or " +
                 "gradle/libs.versions.toml. Re-pin with `bazel run @maven_kmp//:pin`.")

    names = lock["names"]
    files = {}
    targets = []
    for module in sorted(lock["artifacts"]):
        for platform in sorted(lock["artifacts"][module]):
            resolved = lock["artifacts"][module][platform]
            # A module that only redirects (a JetBrains fork naming the AndroidX original) has no files.
            for f in resolved["files"] or []:
                files[_file_repo(f)] = f
            targets.append(_target(names[module], platform, resolved, names, lock["artifacts"]))
    for repo, f in files.items():
        http_file(name = repo, urls = [f["url"]], sha256 = f["sha256"], downloaded_file_path = f["name"])

    pin_args = ["$(rootpath @money_manager//bazel/kmp/resolver)", "--lock", "bazel/kmp/deps/maven_kmp.lock.json"]
    pin_args += ["--toml", "gradle/libs.versions.toml"]
    pin_args += ["--library=" + alias for alias in install.libraries]
    pin_args += ["--platform=" + p for p in install.platforms]
    pin_args += ["--force=%s=%s" % (m, ref) for m, ref in sorted(install.forces.items())]
    pin_args += ["--repository=" + r for r in install.repositories]
    pin_args += ["--exclude=" + e for e in install.excludes]
    _hub(
        name = "maven_kmp",
        build_file_content = _HEADER.format(pin_args = repr(pin_args)) + "\n" + "\n".join(targets),
        stale = stale,
    )
    return module_ctx.extension_metadata(reproducible = True)

maven_kmp = module_extension(
    implementation = _maven_kmp_impl,
    tag_classes = {
        "install": tag_class(attrs = {
            "catalog": attr.label(mandatory = True, doc = "gradle/libs.versions.toml."),
            "excludes": attr.string_list(doc = "group:artifact never resolved, whoever depends on it."),
            "forces": attr.string_dict(doc = "module → catalog [versions] key: Gradle's dependency substitutions."),
            "libraries": attr.string_list(doc = "Catalog library aliases to resolve."),
            "lock_file": attr.label(mandatory = True),
            "platforms": attr.string_list(doc = "jvm, linuxX64, linuxArm64, macosArm64, mingwX64."),
            "repositories": attr.string_list(doc = "url[=group-regex,…], in order, as in settings.gradle.kts."),
        }),
    },
)
