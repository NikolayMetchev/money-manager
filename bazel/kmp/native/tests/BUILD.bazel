load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":smoke.bzl", "konan_smoke_program")

# The toolchain compiles and links with nothing but what the repository downloaded (#998).
konan_smoke_program(
    name = "hello_linux_x64",
    srcs = ["Hello.kt"],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "hello_linux_x64_test",
    srcs = ["run_hello.sh"],
    args = ["$(rootpath :hello_linux_x64)"],
    data = [":hello_linux_x64"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Cross-compiled for the other Linux and Windows targets: they only have to link.
konan_smoke_program(
    name = "hello_linux_arm64",
    srcs = ["Hello.kt"],
    target = "linuxArm64",
)

konan_smoke_program(
    name = "hello_mingw_x64",
    srcs = ["Hello.kt"],
    target = "mingwX64",
)
