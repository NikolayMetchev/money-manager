"""The Kotlin/Native distribution and the dependencies konan needs, as one hermetic repository (#998).

KGP downloads `kotlin-native-prebuilt-<host>` and konan then fetches LLVM, the target sysroots and libffi
into `~/.konan` the first time it needs them. Here every archive is sha256-pinned (`pins.bzl`) and laid out
the way konan expects inside the repository: the distribution in `dist/` and its data directory
(`KONAN_DATA_DIR`) in `data/`, with `dependencies/.extracted` written so konan never downloads anything.
`run_konan` also passes `airplaneMode=true`, so a dependency we missed fails the build instead of being
fetched.

The repository only holds the toolchain's implementation (`:toolchain_impl`). The `toolchain()` targets
live in `//bazel/kmp/native`, so resolving toolchains for a build that has no native target never
fetches the distribution.
"""

load(":properties.bzl", "HOST_TARGETS", "dependencies", "dependency_url", "parse_properties")

# konan's name for a host → the suffix of its distribution archive on Maven Central.
DIST_HOSTS = {
    "linux_x64": "linux-x86_64",
    "macos_arm64": "macos-aarch64",
    "mingw_x64": "windows-x86_64",
}

def _archive_ext(host):
    return "zip" if host == "mingw_x64" else "tar.gz"

def _dist_url(version, host):
    return "https://repo1.maven.org/maven2/org/jetbrains/kotlin/kotlin-native-prebuilt/{v}/kotlin-native-prebuilt-{v}-{h}.{e}".format(
        v = version,
        h = DIST_HOSTS[host],
        e = _archive_ext(host),
    )

def _dist_prefix(version, host):
    return "kotlin-native-prebuilt-%s-%s" % (DIST_HOSTS[host], version)

_BUILD = """\
# Generated by //bazel/kmp/native:repository.bzl. Kotlin/Native {version} for host {host}.
load("@money_manager//bazel/kmp/native:toolchain.bzl", "kotlin_native_toolchain")

package(default_visibility = ["//visibility:public"])

# What every konan invocation reads: the compiler, its properties and the common stdlib klib.
filegroup(
    name = "dist",
    srcs = glob(
        ["dist/**"],
        exclude = ["dist/klib/platform/**"],
    ),
)
{targets}
kotlin_native_toolchain(
    name = "toolchain_impl",
    version = "{version}",
    host = "{host}",
    dist_dir = "dist",
    data_dir = "data",
    dist = ":dist",
    targets = {{
{target_dict}
    }},
)
"""

_TARGET = """
# {target}: its platform klibs and the dependencies konan needs on this host to compile and link it.
filegroup(
    name = "{target}",
    srcs = glob(["dist/klib/platform/{target}/**"]) + glob([
{deps}
    ]) + ["data/dependencies/.extracted"],
)
"""

_STALE_BUILD = """\
load("@money_manager//bazel/kmp/native:toolchain.bzl", "kotlin_native_stale_toolchain")

# Fails only when a native target needs the toolchain.
kotlin_native_stale_toolchain(
    name = "toolchain_impl",
    message = {message},
    visibility = ["//visibility:public"],
)
"""

def _impl(rctx):
    host = rctx.attr.host
    version = rctx.attr.version
    if not host:
        message = "Kotlin/Native doesn't run on this host (%s %s)." % (rctx.os.name, rctx.os.arch)
        rctx.file("BUILD.bazel", _STALE_BUILD.format(message = repr(message)))
        return
    if rctx.attr.pinned_version != version:
        message = ("bazel/kmp/native/pins.bzl pins Kotlin/Native %r but rules_kotlin compiles with Kotlin %s. " +
                   "Repin with `bazel run @kotlin_native_repin//:repin`.") % (rctx.attr.pinned_version, version)
        rctx.file("BUILD.bazel", _STALE_BUILD.format(message = repr(message)))
        return

    rctx.report_progress("Kotlin/Native %s distribution" % version)
    rctx.download_and_extract(
        url = _dist_url(version, host),
        output = "dist",
        sha256 = rctx.attr.dist_sha256,
        stripPrefix = _dist_prefix(version, host),
    )
    props = parse_properties(rctx.read("dist/konan/konan.properties"))
    targets = HOST_TARGETS[host]
    names = dependencies(props, host, targets)
    missing = [name for name in names if name not in rctx.attr.dependency_sha256]
    if missing:
        fail(("Kotlin/Native %s on %s needs dependencies that bazel/kmp/native/pins.bzl doesn't pin: %s. " +
              "Repin with `bazel run @kotlin_native_repin//:repin`.") % (version, host, ", ".join(missing)))
    for name in names:
        rctx.report_progress("Kotlin/Native dependency " + name)
        rctx.download_and_extract(
            url = dependency_url(props, name, _archive_ext(host)),
            output = "data/dependencies",
            sha256 = rctx.attr.dependency_sha256[name],
        )

    # konan's record of what it has unpacked. With every name listed, it never downloads.
    rctx.file("data/dependencies/.extracted", "\n".join(names) + "\n")

    # Keep only what our targets read: the other targets' platform klibs, the sources and the IDE's
    # commonized metadata are most of the distribution's files, and every file is an action input.
    for entry in rctx.path("dist/klib/platform").readdir():
        if entry.basename not in targets:
            rctx.delete(entry)
    for unused in ["dist/sources", "dist/klib/commonized", "dist/klib/cache"]:
        rctx.delete(unused)

    target_blocks = []
    target_dict = []
    for target in targets:
        deps = "\n".join(['        "data/dependencies/%s/**",' % d for d in dependencies(props, host, [target])])
        target_blocks.append(_TARGET.format(target = target, deps = deps))
        target_dict.append('        ":%s": "%s",' % (target, target))
    rctx.file("BUILD.bazel", _BUILD.format(
        version = version,
        host = host,
        targets = "".join(target_blocks),
        target_dict = "\n".join(target_dict),
    ))

kotlin_native_repository = repository_rule(
    implementation = _impl,
    attrs = {
        "dependency_sha256": attr.string_dict(doc = "konan dependency name → archive sha256, for this host."),
        "dist_sha256": attr.string(),
        "host": attr.string(doc = "konan's host name, or empty when the host can't run Kotlin/Native."),
        "pinned_version": attr.string(doc = "The version pins.bzl was generated for."),
        "version": attr.string(mandatory = True),
    },
)

_REPIN_BUILD = """\
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "repin",
    srcs = ["repin.sh"],
)
"""

_REPIN_SH = """\
#!/usr/bin/env bash
set -euo pipefail
cp "{path}" "$BUILD_WORKSPACE_DIRECTORY/bazel/kmp/native/pins.bzl"
echo "Wrote bazel/kmp/native/pins.bzl for Kotlin/Native {version}."
"""

def _sha256(rctx, url, cache):
    """Downloads `url` once to hash it. JetBrains' published `.sha256` files can't be used: they all
    hold the same checksum, whatever the archive."""
    if url not in cache:
        cache[url] = rctx.download(url = url, output = "archive").sha256
        rctx.delete("archive")
    return cache[url]

def _repin_impl(rctx):
    """Writes pins.bzl for every host. Downloads every archive (a few GB), so it only runs when
    `bazel run @kotlin_native_repin//:repin` asks for it, after a Kotlin bump."""
    version = rctx.attr.version
    cache = {}
    dists = {}
    for host in sorted(DIST_HOSTS):
        rctx.report_progress("Kotlin/Native %s for %s" % (version, host))
        dists[host] = _sha256(rctx, _dist_url(version, host), cache)

    deps = {}
    for host in sorted(HOST_TARGETS):
        # Each host's distribution has its own konan.properties: its own llvmHome is the `user` LLVM
        # (essentials), every other host's the `dev` one, so one host's file pins the wrong LLVM for the rest.
        rctx.download_and_extract(
            url = _dist_url(version, host),
            output = "props",
            sha256 = dists[host],
            stripPrefix = _dist_prefix(version, host),
        )
        props = parse_properties(rctx.read("props/konan/konan.properties"))
        rctx.delete("props")
        deps[host] = {}
        for name in dependencies(props, host, HOST_TARGETS[host]):
            rctx.report_progress("%s for %s" % (name, host))
            deps[host][name] = _sha256(rctx, dependency_url(props, name, _archive_ext(host)), cache)
    lines = [
        '"""Kotlin/Native pins. Generated by `bazel run @kotlin_native_repin//:repin`; don\'t edit."""',
        "",
        'KOTLIN_NATIVE_VERSION = "%s"' % version,
        "",
        "KOTLIN_NATIVE_DIST_SHA256 = {",
    ]
    lines += ['    "%s": "%s",' % (host, dists[host]) for host in sorted(dists)]
    lines += ["}", "", "KOTLIN_NATIVE_DEPENDENCY_SHA256 = {"]
    for host in sorted(deps):
        lines.append('    "%s": {' % host)
        lines += ['        "%s": "%s",' % (name, deps[host][name]) for name in sorted(deps[host])]
        lines.append("    },")
    lines += ["}", ""]
    rctx.file("pins.bzl", "\n".join(lines))
    rctx.file("repin.sh", _REPIN_SH.format(path = rctx.path("pins.bzl"), version = version), executable = True)
    rctx.file("BUILD.bazel", _REPIN_BUILD)

kotlin_native_repin = repository_rule(
    implementation = _repin_impl,
    attrs = {"version": attr.string(mandatory = True)},
)
