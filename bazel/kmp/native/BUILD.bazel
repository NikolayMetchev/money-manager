# The hermetic Kotlin/Native toolchain (#998): see repository.bzl and toolchain.bzl.
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

toolchain_type(name = "toolchain_type")

# One toolchain per exec host Kotlin/Native runs on, each over that host's distribution
# (@kotlin_native_<host>), which is only fetched once a native target selects its toolchain.
[
    toolchain(
        name = "toolchain_" + host,
        exec_compatible_with = constraints,
        toolchain = "@kotlin_native_%s//:toolchain_impl" % host,
        toolchain_type = ":toolchain_type",
    )
    for host, constraints in {
        "linux_x64": [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
        "macos_arm64": [
            "@platforms//os:macos",
            "@platforms//cpu:aarch64",
        ],
        "mingw_x64": [
            "@platforms//os:windows",
            "@platforms//cpu:x86_64",
        ],
    }.items()
]

# The Kotlin/Native target that is the build's own platform: `kmp_native_executable`'s host-only alias.
[
    config_setting(
        name = "is_" + target,
        constraint_values = constraints,
    )
    for target, constraints in {
        "linuxArm64": [
            "@platforms//os:linux",
            "@platforms//cpu:aarch64",
        ],
        "linuxX64": [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
        "macosArm64": [
            "@platforms//os:macos",
            "@platforms//cpu:aarch64",
        ],
        "mingwX64": [
            "@platforms//os:windows",
            "@platforms//cpu:x86_64",
        ],
    }.items()
]

bzl_library(
    name = "native",
    srcs = [
        "extensions.bzl",
        "pins.bzl",
        "properties.bzl",
        "repository.bzl",
        "toolchain.bzl",
    ],
    deps = ["@rules_java//java/common"],
)
