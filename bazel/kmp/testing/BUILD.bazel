load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_java//java:java_library.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "junit_xml",
    srcs = ["src/com/moneymanager/bazel/kmp/testing/JUnitXml.java"],
    visibility = ["//visibility:private"],
)

# Runs a kmp_test's JUnit 4 classes on the JVM (see defs.bzl).
java_library(
    name = "runner",
    srcs = ["src/com/moneymanager/bazel/kmp/testing/KmpJUnitRunner.java"],
    deps = [
        ":junit_xml",
        "@maven_kmp//:junit_jvm",
    ],
)

# Runs a kmp_test's Kotlin/Native test executable and writes its JUnit XML (see defs.bzl).
java_library(
    name = "native_launcher_lib",
    srcs = ["src/com/moneymanager/bazel/kmp/testing/KnTestLauncher.java"],
    deps = [":junit_xml"],
)

# The same launcher outside Bazel: CI runs the cross-linked linuxArm64 and mingwX64 test binaries through its deploy
# jar on their own runners, so they report JUnit XML too.
java_binary(
    name = "native_launcher",
    main_class = "com.moneymanager.bazel.kmp.testing.KnTestLauncher",
    runtime_deps = [":native_launcher_lib"],
)

# Coverage: `--config=coverage` (`--define=coverage=intellij`) runs the JVM and Android host tests under the IntelliJ
# coverage engine (see defs.bzl's _jvm_test, and coverage.sh for the report).
config_setting(
    name = "coverage",
    define_values = {"coverage": "intellij"},
)

# A JVM agent jar (-javaagent), so only its deploy jar is used: CoverageAgent starts Kover's agent.
java_binary(
    name = "coverage_agent",
    srcs = ["src/com/moneymanager/bazel/kmp/testing/CoverageAgent.java"],
    create_executable = False,
    deploy_manifest_lines = [
        "Premain-Class: com.moneymanager.bazel.kmp.testing.CoverageAgent",
        "Can-Retransform-Classes: true",
    ],
)

# The reporter, run by coverage.sh: the tests' binary reports and the production classes in, a JaCoCo XML report out.
java_binary(
    name = "kover_cli",
    main_class = "kotlinx.kover.cli.MainKt",
    runtime_deps = ["@kover//:org_jetbrains_kotlinx_kover_cli"],
)
