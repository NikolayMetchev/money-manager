load("@rules_java//java:java_binary.bzl", "java_binary")

# Dokka's CLI. The analysis and the plugins are dokka.bzl's pluginsClasspath.
java_binary(
    name = "runner",
    srcs = ["src/com/moneymanager/bazel/kmp/dokka/DokkaRunner.java"],
    main_class = "com.moneymanager.bazel.kmp.dokka.DokkaRunner",
    visibility = ["//visibility:public"],
    runtime_deps = ["@dokka//:org_jetbrains_dokka_dokka_cli"],
)

# The external documentation's package lists the KDoc links against (dokka.bzl's _EXTERNAL_LINKS);
# package-lists/update.sh refreshes them (CI's Auto-format PR job runs it).
filegroup(
    name = "package_lists",
    srcs = glob(["package-lists/*-list"]),
    visibility = ["//visibility:public"],
)
