load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_java//java:java_import.bzl", "java_import")
load("@rules_java//java:java_library.bzl", "java_library")
load("@rules_kotlin//kotlin:core.bzl", "kt_kotlinc_options")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_binary")
load("//bazel/kmp:optional.bzl", "ANDROID_ONLY")
load(":apk.bzl", "stamp_setting")

# The Kotlin tools below run on AGP's classpath, whose Kotlin stdlib (2.2) comes before the toolchain's: they are
# compiled for that stdlib's API, so code using anything newer fails to compile rather than at runtime. The
# rest is //bazel/kmp:kotlinc_options, which a target's own options replace.
kt_kotlinc_options(
    name = "agp_kotlinc_options",
    api_version = "2.2",
    warn = "error",
    x_lambdas = "indy",
)

# The SDK's android.jar, which every Android compile has on its classpath (neverlink): extensions.bzl.
alias(
    name = "android_jar",
    actual = "@android_platform//:android_jar",
    target_compatible_with = ANDROID_ONLY,
    visibility = ["//visibility:public"],
)

kt_jvm_binary(
    name = "mockable_jar",
    srcs = ["src/com/moneymanager/bazel/kmp/android/MockableJar.kt"],
    kotlinc_opts = ":agp_kotlinc_options",
    main_class = "com.moneymanager.bazel.kmp.android.MockableJarKt",
    target_compatible_with = ANDROID_ONLY,
    deps = ["@android_tools//:com_android_tools_build_builder"],
)

genrule(
    name = "mockable_android_jar_gen",
    srcs = ["@android_platform//:android.jar"],
    outs = ["mockable-android.jar"],
    cmd = "$(execpath :mockable_jar) $< $@",
    target_compatible_with = ANDROID_ONLY,
    tools = [":mockable_jar"],
)

# What Android host tests run on, instead of android.jar (#1022): AGP's mockable jar, returning default values
# as the Android convention's `withHostTest { isReturnDefaultValues = true }` asks.
java_import(
    name = "mockable_android_jar",
    testonly = True,
    jars = [":mockable_android_jar_gen"],
    target_compatible_with = ANDROID_ONLY,
    visibility = ["//visibility:public"],
)

# The steps of an APK build AGP does with its own classes (apk.bzl).
kt_jvm_binary(
    name = "android_app",
    srcs = ["src/com/moneymanager/bazel/kmp/android/AndroidApp.kt"],
    kotlinc_opts = ":agp_kotlinc_options",
    main_class = "com.moneymanager.bazel.kmp.android.AndroidAppKt",
    target_compatible_with = ANDROID_ONLY,
    visibility = ["//visibility:public"],
    deps = [
        "@android_tools//:com_android_tools_build_apkzlib",
        "@android_tools//:com_android_tools_build_builder",
        "@android_tools//:com_android_tools_build_gradle",
        "@android_tools//:com_android_tools_build_manifest_merger",
        "@android_tools//:com_android_tools_common",
        "@android_tools//:com_android_tools_sdk_common",
        "@android_tools//:com_google_guava_guava",
    ],
)

# D8, as AGP bundles it in its builder jar (a release build runs R8 through AGP's own runR8: AndroidApp r8).
java_binary(
    name = "d8",
    main_class = "com.android.tools.r8.D8",
    target_compatible_with = ANDROID_ONLY,
    visibility = ["//visibility:public"],
    runtime_deps = ["@android_tools//:com_android_tools_build_builder"],
)

config_setting(
    name = "stamped",
    values = {"stamp": "1"},
)

# Whether android_apk records the commit (STABLE_GIT_COMMIT, from the workspace status command) as AGP's VCS info.
stamp_setting(
    name = "stamp",
    stamped = select({
        ":stamped": True,
        "//conditions:default": False,
    }),
    visibility = ["//visibility:public"],
)

# The lint AGP runs (#1025), on the classpath AGP resolves for it (`com.android.tools.lint:lint-gradle`).

# Java, not Kotlin: it joins lint's own classpath ahead of lint, where a Kotlin target would put the toolchain's
# stdlib before the one lint was built with, and lint's analysis then fails.
java_library(
    name = "lint_runner",
    testonly = True,
    srcs = ["src/com/moneymanager/bazel/kmp/android/LintRunner.java"],
    target_compatible_with = ANDROID_ONLY,
    visibility = ["//visibility:public"],
    runtime_deps = ["@android_lint//:com_android_tools_lint_lint_gradle"],
)
