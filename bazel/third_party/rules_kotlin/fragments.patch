--- a/kotlin/internal/jvm/compile.bzl
+++ b/kotlin/internal/jvm/compile.bzl
@@ -651,6 +651,32 @@
 def _plugins_payload_to_json(payload):
     return _plugin_payload.plugins_payload_json(payload.plugins)
 
+def _fragment_flags(ctx, srcs):
+    """Kotlin Multiplatform fragment flags for a target that sets `fragment_srcs`, or none."""
+    fragment_srcs = getattr(ctx.attr, "fragment_srcs", None)
+    if not fragment_srcs:
+        return []
+    fragments = []
+    sources = []
+    for target, fragment in fragment_srcs.items():
+        if fragment not in fragments:
+            fragments.append(fragment)
+        for f in target.files.to_list():
+            if f not in srcs.kt:
+                fail("fragment_srcs: %s is not in srcs" % f.short_path)
+            sources.append("-Xfragment-sources=%s:%s" % (fragment, f.path))
+    # A fragment may have no sources: KGP names every source set in the hierarchy, and K2 takes a lone
+    # common fragment for the platform's own.
+    refines = getattr(ctx.attr, "fragment_refines", {})
+    for child, parent in refines.items():
+        for fragment in [child, parent]:
+            if fragment not in fragments:
+                fragments.append(fragment)
+    return ["-Xmulti-platform", "-Xfragments=" + ",".join(fragments)] + [
+        "-Xfragment-refines=%s:%s" % (child, parent)
+        for child, parent in refines.items()
+    ] + sources
+
 def _run_kt_builder_action(
         ctx,
         mnemonic,
@@ -707,6 +733,7 @@
 
