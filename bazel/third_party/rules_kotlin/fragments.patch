     args.add_all("--kotlin_passthrough_flags", kotlinc_options_to_flags(kotlinc_options))
+    args.add_all("--kotlin_passthrough_flags", _fragment_flags(ctx, srcs))
     args.add_all("--javacopts", javac_options_to_flags(javac_options))
 
