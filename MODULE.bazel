# The lint tools (#1015), each resolved on its own like the Gradle configuration (`ktlint`, `detekt`) it matches:
# only the build-tool-pins bundle applies to those.
maven_kmp.install(
    name = "detekt_cli",
    catalog = "//:libs.versions.toml",
    force_bundles = ["build-tool-pins"],
    libraries = ["detekt-cli"],
    lock_file = "//bazel/kmp/deps:detekt_cli.lock.json",
    platforms = ["jvm"],
    repositories = ["https://repo1.maven.org/maven2"],
    resolve_stdlib = True,
)

maven_kmp.install(
    name = "ktlint_cli",
    catalog = "//:libs.versions.toml",
    force_bundles = ["build-tool-pins"],
    libraries = ["ktlint-cli"],
    lock_file = "//bazel/kmp/deps:ktlint_cli.lock.json",
    platforms = ["jvm"],
    repositories = ["https://repo1.maven.org/maven2"],
    resolve_stdlib = True,
)

# Dokka (#1027), the KDoc site: its CLI (a fat jar, with Dokka's core) and the plugins the Gradle plugin runs.
maven_kmp.install(
    name = "dokka",
    catalog = "//:libs.versions.toml",
    force_bundles = ["build-tool-pins"],
    libraries = [
        "dokka-all-modules-page-plugin",
        "dokka-analysis-kotlin-symbols",
        "dokka-base",
        "dokka-cli",
        "dokka-templating-plugin",
    ],
    lock_file = "//bazel/kmp/deps:dokka.lock.json",
    platforms = ["jvm"],
    repositories = ["https://repo1.maven.org/maven2"],
    resolve_stdlib = True,
)

# SchemaSpy (#1027), on its own classpath as in app/db/schemaspy's Gradle `schemaspy` configuration, with the
# SQLite JDBC driver it reads the schema through.
maven_kmp.install(
    name = "schemaspy",
    catalog = "//:libs.versions.toml",
    force_bundles = ["build-tool-pins"],
    libraries = [
        "schemaspy",
        "sqldelight-sqlite-driver",
    ],
    lock_file = "//bazel/kmp/deps:schemaspy.lock.json",
    platforms = ["jvm"],
    repositories = ["https://repo1.maven.org/maven2"],
    resolve_stdlib = True,
)

# The desktop app's ProGuard (#1019), with the Compose Gradle plugin for the default rules it applies.
maven_kmp.install(
    name = "proguard",
    catalog = "//:libs.versions.toml",
    # Optional in the plugin's POM, and Gradle-only.
    excludes = ["org.jetbrains.compose.hot-reload:hot-reload-gradle-plugin"],
    force_bundles = ["build-tool-pins"],
    libraries = [
        "compose-gradle-plugin",
        "proguard-base",
    ],
    lock_file = "//bazel/kmp/deps:proguard.lock.json",
    platforms = ["jvm"],
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://plugins.gradle.org/m2",
    ],
    resolve_stdlib = True,
)

# AGP and its builder: MockableJarGenerator makes the android.jar Android host tests run on (#1022); the app
# build (#1023) runs their manifest merger, R class writer, ApkFlinger, R8 and profile compiler as AGP does.
maven_kmp.install(
    name = "android_tools",
    catalog = "//:libs.versions.toml",
    force_bundles = ["build-tool-pins"],
    libraries = [
        "android-builder",
        "android-gradle-plugin",
    ],
    lock_file = "//bazel/kmp/deps:android_tools.lock.json",
    platforms = ["jvm"],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    resolve_stdlib = True,
)

# Android lint (#1025): the lint-gradle AGP resolves to run lint, on its own classpath as AGP runs it.
maven_kmp.install(
    name = "android_lint",
    catalog = "//:libs.versions.toml",
    force_bundles = ["build-tool-pins"],
    libraries = ["android-lint-gradle"],
    lock_file = "//bazel/kmp/deps:android_lint.lock.json",
    platforms = ["jvm"],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    resolve_stdlib = True,
)

use_repo(maven_kmp, "android_lint", "android_tools", "detekt_cli", "dokka", "ktlint_cli", "maven_kmp", "proguard", "schemaspy")

android_sdk = use_extension("//bazel/kmp/android:extensions.bzl", "android_sdk")
use_repo(android_sdk, "aapt2", "android_sdk")
