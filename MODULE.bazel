# The JVM tools the build runs, each resolved on its own (the KMP libraries above need maven_kmp's variant
# resolution; these are plain Maven artifacts). Renovate bumps the versions here; `bazel/renovate/repin.sh` re-pins.
# Maven resolution keeps the version a POM asks for, often years old (logback, protobuf, guava, asm), and doesn't read
# Gradle's module metadata, which moves a KMP library's `-jvm` artifact and the Kotlin stdlib to the newest any
# dependency asks for. So an install lists those transitive libraries too, at their newest, and
# `version_conflict_policy = "pinned"` makes the listed versions win.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# The lint tools (#1015).
maven.install(
    name = "detekt_cli",
    artifacts = [
        "dev.detekt:detekt-cli:2.0.0-alpha.6",
        # Transitive versions held at the newest (see version_conflict_policy).
        "com.google.errorprone:error_prone_annotations:2.50.0",
        "dev.drewhamilton.poko:poko-annotations-jvm:0.23.2",
        "org.checkerframework:checker-qual:4.3.1",
        "org.jetbrains.kotlin:kotlin-stdlib-common:2.4.21",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk7:2.4.21",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk8:2.4.21",
        "org.jetbrains.kotlin:kotlin-stdlib:2.4.21",
        "org.jetbrains.kotlinx:kotlinx-serialization-json-jvm:1.11.0",
    ],
    lock_file = "//bazel/maven:detekt_cli_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
    version_conflict_policy = "pinned",
)

