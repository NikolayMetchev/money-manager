"""Money Manager's Bazel module.

Bazel is being brought up beside Gradle (#995). Until the cutover, Gradle stays the source of truth.
"""

module(
    name = "money_manager",
    version = "1.0.12",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_shell", version = "0.6.1")

# rules_go only hosts the Gazelle language extension (//bazel/gazelle/kmp): Gazelle extensions are Go.
bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")

# Kotlin Multiplatform fragment support (see bazel/third_party/rules_kotlin/BUILD.bazel).
single_version_override(
    module_name = "rules_kotlin",
    patch_strip = 1,
    patches = ["//bazel/third_party/rules_kotlin:fragments.patch"],
)

register_toolchains("//bazel/kmp:kotlin_toolchain")

# Each desktop OS's JDK, for its jmods (//bazel/kmp/deps:jdk_jmods).
jdk = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(
    jdk,
    "remotejdk25_linux",
    "remotejdk25_linux_aarch64",
    "remotejdk25_macos",
    "remotejdk25_macos_aarch64",
    "remotejdk25_win",
)

# Kotlin/Native for the exec host, at rules_kotlin's Kotlin version, with every konan dependency pinned in
# bazel/kmp/native/pins.bzl (#998). After a Kotlin bump: bazel run @kotlin_native_repin//:repin
kotlin_native = use_extension("//bazel/kmp/native:extensions.bzl", "kotlin_native")
use_repo(kotlin_native, "kotlin_native", "kotlin_native_repin")

# The default desktop Google OAuth client, obfuscated from CI's secrets or secrets/google-oauth.properties (#1011).
# The SQLite amalgamation utils/sqlite3 builds, pinned by sqlite-amalgamation-* in the catalog (#1012).
sqlite_amalgamation = use_extension("//bazel/kmp/sqlite:extensions.bzl", "sqlite_amalgamation")
use_repo(sqlite_amalgamation, "sqlite_amalgamation")

google_oauth = use_extension("//bazel/kmp/constants:google_oauth.bzl", "google_oauth")
use_repo(google_oauth, "google_oauth")

register_toolchains("//bazel/kmp/native:all")

# The WiX toolset jpackage builds the Windows installer with (#1020): the one the Compose Gradle plugin downloads
# (`wix311`, its downloadWix task).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "wix",
    build_file_content = 'filegroup(name = "wix", srcs = glob(["**"]), visibility = ["//visibility:public"])',
    sha256 = "2c1888d5d1dba377fc7fa14444cf556963747ff9a0a289a3599cf09da03b9e2e",
    url = "https://github.com/wixtoolset/wix3/releases/download/wix3112rtm/wix311-binaries.zip",
)

# Maven libraries, resolved per platform (jar, klib) from Gradle Module Metadata into
# bazel/kmp/deps/maven_kmp.lock.json (#1000). Versions come from the catalog. After changing this or the
# catalog, re-pin: bazel run @maven_kmp//:pin
maven_kmp = use_extension("//bazel/kmp/deps:extensions.bzl", "maven_kmp")
maven_kmp.install(
    # Android Studio renders Compose previews with the hub's `androidx_compose_ui_ui_tooling`, rules_jvm_external's
    # name for it, and builds it after every sync of a Compose project: a missing target fails that build.
    aliases = {"androidx_compose_ui_ui_tooling": "androidx_compose_ui_tooling_android"},
    catalog = "//:libs.versions.toml",
    # SQLDelight's Gradle plugin jar carries the compiler environment //bazel/kmp/sqldelight runs, but none
    # of its Gradle API.
    # JetBrains' runtime-desktop is a LICENSE-only redirect with the same jar name as androidx's runtime-desktop;
    # Gradle drops it from mm-jvm's runtime classpath, and nothing compiles against it.
    excludes = [
        "org.jetbrains.compose.runtime:runtime-desktop",
        "org.jetbrains.kotlin:kotlin-gradle-plugin",
    ],
    # These modules always resolve to the catalog version, whoever asks for them (and so does every library
    # of the build-tool-pins bundle).
    force_bundles = ["build-tool-pins"],
