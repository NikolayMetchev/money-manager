    # Transitive modules the app's graph would otherwise resolve older (compiler plugins' and Android's transitives),
    # pinned on every platform, as Gradle's `configurations.all`. Compose's internal annotation and collection are
    # deliberately not pinned (it desyncs the Compose runtime), nor are the Kotlin compiler, stdlib and reflect, or
    # dagger: each plugin needs its own.
    forces = {
        "com.google.code.findbugs:jsr305": JSR305,
        "com.google.errorprone:error_prone_annotations": ERRORPRONE,
        "com.squareup:javawriter": JAVAWRITER,
