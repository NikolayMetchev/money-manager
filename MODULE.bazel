        "turbine",
    ],
    lock_file = "//bazel/kmp/deps:maven_kmp.lock.json",
    platforms = [
        "jvm",
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    # settings.gradle.kts: Google's repository only for these groups, Maven Central for everything.
    repositories = [
        "https://dl.google.com/dl/android/maven2=androidx[.].*,com[.]android[.].*,com[.]google[.].*",
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven_kmp, "maven_kmp")
