"""Money Manager's Bazel module.

Bazel is being brought up beside Gradle (#995). Until the cutover, Gradle stays the source of truth.
"""

module(
    name = "money_manager",
    version = "1.0.12",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_shell", version = "0.8.0")

# rules_go only hosts the Gazelle language extension (//bazel/gazelle/kmp): Gazelle extensions are Go.
bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.3")

# Kotlin Multiplatform fragment support (see bazel/third_party/rules_kotlin/BUILD.bazel).
single_version_override(
    module_name = "rules_kotlin",
    patch_strip = 1,
    patches = ["//bazel/third_party/rules_kotlin:fragments.patch"],
)

register_toolchains("//bazel/kmp:kotlin_toolchain")

# Each desktop OS's JDK, for its jmods (//bazel/kmp/deps:jdk_jmods).
jdk = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(
    jdk,
    "remotejdk25_linux",
    "remotejdk25_linux_aarch64",
    "remotejdk25_macos",
    "remotejdk25_macos_aarch64",
    "remotejdk25_win",
)

# Kotlin/Native for the exec host, at rules_kotlin's Kotlin version, with every konan dependency pinned in
# bazel/kmp/native/pins.bzl (#998). After a Kotlin bump: bazel run @kotlin_native_repin//:repin
kotlin_native = use_extension("//bazel/kmp/native:extensions.bzl", "kotlin_native")
use_repo(kotlin_native, "kotlin_native_linux_x64", "kotlin_native_macos_arm64", "kotlin_native_mingw_x64", "kotlin_native_repin")

# The SQLite amalgamation utils/sqlite3 builds (#1012). The release number in sqlite.org's download naming
# (3.54.0 = 3540000), its year directory and the zip's SHA-256 move together.
sqlite_amalgamation = use_extension("//bazel/kmp/sqlite:extensions.bzl", "sqlite_amalgamation")
sqlite_amalgamation.version(
    release = "3540000",
    sha256 = "68e913b0fe8ec6b4e5f391c594a28872884e80d6cd042a1e50c957be46b5aa4d",
    year = "2026",
)
use_repo(sqlite_amalgamation, "sqlite_amalgamation")

# The default desktop Google OAuth client, obfuscated from CI's secrets or secrets/google-oauth.properties (#1011).
google_oauth = use_extension("//bazel/kmp/constants:google_oauth.bzl", "google_oauth")
use_repo(google_oauth, "google_oauth")

register_toolchains("//bazel/kmp/native:all")

register_execution_platforms("//bazel/platforms:host_klibs")

# The WiX toolset jpackage builds the Windows installer with (#1020): the one the Compose Gradle plugin downloads
# (`wix311`, its downloadWix task).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "wix",
    build_file_content = 'filegroup(name = "wix", srcs = glob(["**"]), visibility = ["//visibility:public"])',
    sha256 = "2c1888d5d1dba377fc7fa14444cf556963747ff9a0a289a3599cf09da03b9e2e",
    url = "https://github.com/wixtoolset/wix3/releases/download/wix3112rtm/wix311-binaries.zip",
)

