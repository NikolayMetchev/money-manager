        "ktor-utils",
        "mappie-api",
        "mappie-compiler-plugin",
        "metro-compiler",
        "metro-runtime",
        "mokkery-core",
        "mokkery-plugin",
        "mokkery-runtime",
        "molecule-runtime",
        "mordant-core",
        "mosaic-runtime",
        "mosaic-terminal",
