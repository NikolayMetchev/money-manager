"""Money Manager's Bazel module.

Bazel is being brought up beside Gradle (#995). Until the cutover, Gradle stays the source of truth.
"""

module(
    name = "money_manager",
    version = "1.0.12",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_shell", version = "0.6.1")

# rules_go only hosts the Gazelle language extension (//bazel/gazelle/kmp): Gazelle extensions are Go.
bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")

# Kotlin Multiplatform fragment support (see bazel/third_party/rules_kotlin/BUILD.bazel).
single_version_override(
    module_name = "rules_kotlin",
    patch_strip = 1,
    patches = ["//bazel/third_party/rules_kotlin:fragments.patch"],
)

register_toolchains("//bazel/kmp:kotlin_toolchain")

# Kotlin/Native for the exec host, at rules_kotlin's Kotlin version, with every konan dependency pinned in
# bazel/kmp/native/pins.bzl (#998). After a Kotlin bump: bazel run @kotlin_native_repin//:repin
kotlin_native = use_extension("//bazel/kmp/native:extensions.bzl", "kotlin_native")
use_repo(kotlin_native, "kotlin_native", "kotlin_native_repin")

register_toolchains("//bazel/kmp/native:all")

# Maven libraries, resolved per platform (jar, klib) from Gradle Module Metadata into
# bazel/kmp/deps/maven_kmp.lock.json (#1000). Versions come from the catalog. After changing this or the
# catalog, re-pin: bazel run @maven_kmp//:pin
maven_kmp = use_extension("//bazel/kmp/deps:extensions.bzl", "maven_kmp")
maven_kmp.install(
    catalog = "//gradle:libs.versions.toml",
    # SQLDelight's Gradle plugin jar carries the compiler environment //bazel/kmp/sqldelight runs, but none
    # of its Gradle API.
    excludes = ["org.jetbrains.kotlin:kotlin-gradle-plugin"],
    # moneymanager.kotlin-convention's dependency substitutions: these modules always resolve to the
    # catalog version, whoever asks for them.
    forces = {
        "androidx.activity:activity": "androidx-activity-compose",
        "androidx.annotation:annotation": "androidx-annotation",
        "androidx.annotation:annotation-jvm": "androidx-annotation",
        "androidx.collection:collection": "androidx-collection",
        "androidx.concurrent:concurrent-futures": "androidx-concurrent-futures",
        "androidx.lifecycle:lifecycle-common": "androidx-lifecycle",
        "androidx.lifecycle:lifecycle-common-jvm": "androidx-lifecycle",
        "androidx.lifecycle:lifecycle-runtime": "androidx-lifecycle",
        "androidx.lifecycle:lifecycle-runtime-android": "androidx-lifecycle",
        "androidx.lifecycle:lifecycle-runtime-compose": "androidx-lifecycle",
        "androidx.lifecycle:lifecycle-runtime-compose-android": "androidx-lifecycle",
        "androidx.lifecycle:lifecycle-runtime-ktx": "androidx-lifecycle",
        "androidx.lifecycle:lifecycle-runtime-ktx-android": "androidx-lifecycle",
        "androidx.navigationevent:navigationevent": "androidx-navigationevent",
        "androidx.navigationevent:navigationevent-compose": "androidx-navigationevent",
        "androidx.savedstate:savedstate": "androidx-savedstate",
        "androidx.savedstate:savedstate-compose": "androidx-savedstate",
        "androidx.test.services:storage": "androidx-test-services-storage",
        "androidx.test:runner": "androidx-test-runner",
        "androidx.tracing:tracing": "androidx-tracing",
        "org.jetbrains.kotlinx:atomicfu": "atomicfu",
        "org.jetbrains.kotlinx:atomicfu-jvm": "atomicfu",
        "org.jetbrains.kotlinx:kotlinx-coroutines-android": "kotlinx-coroutines",
        "org.jetbrains.kotlinx:kotlinx-coroutines-bom": "kotlinx-coroutines",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core": "kotlinx-coroutines",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core-jvm": "kotlinx-coroutines",
        "org.jetbrains.kotlinx:kotlinx-serialization-bom": "kotlinx-serialization",
        "org.jetbrains.kotlinx:kotlinx-serialization-core": "kotlinx-serialization",
        "org.jetbrains.kotlinx:kotlinx-serialization-core-jvm": "kotlinx-serialization",
        "org.jetbrains.kotlinx:kotlinx-serialization-json": "kotlinx-serialization",
        "org.jetbrains.kotlinx:kotlinx-serialization-json-jvm": "kotlinx-serialization",
        "org.jetbrains:annotations": "jetbrains-annotations",
        "org.slf4j:slf4j-api": "slf4j",
    },
    libraries = [
        "androidx-compose-runtime",
        "androidx-compose-runtime-desktop",
        "atomicfu",
        "bignum",
        "clikt",
        "clikt-core",
        "compose-runtime",
        "compose-runtime-desktop",
        "cryptography-bigint",
        "cryptography-core",
        "cryptography-provider-jdk",
        "cryptography-provider-openssl3-prebuilt",
        "cryptography-random",
        "junit",
        "kermit",
        "kermit-core",
        "kotlin-compose-compiler-plugin-embeddable",
        "kotlin-serialization-compiler-plugin-embeddable",
        "kotlinx-coroutines-core",
        "kotlinx-coroutines-swing",
        "kotlinx-coroutines-test",
        "kotlinx-datetime",
