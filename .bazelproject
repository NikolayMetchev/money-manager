# Project view for the JetBrains Bazel plugin (#1005): open the repository root with File → Open and pick
# "Bazel project". See docs/bazel/ide-evaluation.md.
# .bazelbsp is where the plugin rewrites its sync aspect, BUILD files included, at the start of every sync: inside
# the project those BUILD files would mark it changed again, so the sync icon would never clear.
directories:
  .
  -.bazelbsp

derive_targets_from_directories: true

# Each native module's `:<name>_ide_native` (bazel/kmp/defs.bzl) is the only module that owns its nativeMain and
# linuxMain sources. It is manual, so `bazel build //...` never compiles it.
allow_manual_targets_sync: true

# The release packaging: `:release_jars` is a JavaInfo (ProGuard's output), so a sync would shrink the app (minutes,
# even remote) for jars no module needs. Everything here is manual and only reached by allow_manual_targets_sync.
targets:
  -//app/main/jvm:release_jars
  -//app/main/jvm:release
  -//app/main/jvm:release_service_providers_test
  -//app/main/jvm:app_image
  -//app/main/jvm:app_image_aot
  -//app/main/jvm:installer
