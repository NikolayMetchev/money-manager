load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web

kmp_library(
    name = "regex",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    js_srcs = glob(["src/jsMain/kotlin/**/*.kt"]),
    jvm_android_srcs = glob(["src/jvmAndroidMain/kotlin/**/*.kt"]),
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    wasm_js_srcs = glob(["src/wasmJsMain/kotlin/**/*.kt"]),
    web_targets = [
        "wasmJs",
        "js",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":regex",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = ["//bazel/kmp/deps:kotlin_test"],
)
