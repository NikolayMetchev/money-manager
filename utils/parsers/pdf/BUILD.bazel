# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web
# gazelle:kmp_keep_dep :pdfium_native jvmMain

load("@rules_java//java:java_import.bzl", "java_import")
load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")
load("//bazel/kmp:resources.bzl", "file_resource_jar")

# The target platform's pdfium library (and its VERSION, which names the unpacked copy), as `pdfium/<file>`
# classpath resources PdfiumLibrary loads. Other platforms build no library; their extractor says so per file.
file_resource_jar(
    name = "pdfium_native_jar",
    entries = select({
        ":linux_arm64": {
            "@pdfium_linux_arm64//:lib/libpdfium.so": "pdfium/libpdfium.so",
            "@pdfium_linux_arm64//:VERSION": "pdfium/VERSION",
        },
        ":linux_x64": {
            "@pdfium_linux_x64//:lib/libpdfium.so": "pdfium/libpdfium.so",
            "@pdfium_linux_x64//:VERSION": "pdfium/VERSION",
        },
        ":macos_arm64": {
            "@pdfium_mac_arm64//:lib/libpdfium.dylib": "pdfium/libpdfium.dylib",
            "@pdfium_mac_arm64//:VERSION": "pdfium/VERSION",
        },
        ":macos_x64": {
            "@pdfium_mac_x64//:lib/libpdfium.dylib": "pdfium/libpdfium.dylib",
            "@pdfium_mac_x64//:VERSION": "pdfium/VERSION",
        },
        ":windows_x64": {
            "@pdfium_win_x64//:bin/pdfium.dll": "pdfium/pdfium.dll",
            "@pdfium_win_x64//:VERSION": "pdfium/VERSION",
        },
        "//conditions:default": {},
    }),
)

# `_jvm`, as kmp_library resolves `jvm_deps` to each label's JVM target.
java_import(
    name = "pdfium_native_jvm",
    jars = [":pdfium_native_jar"],
)

[
    config_setting(
        name = os + "_" + cpu,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + {
                "arm64": "aarch64",
                "x64": "x86_64",
            }[cpu],
        ],
    )
    for os, cpu in [
        ("linux", "arm64"),
        ("linux", "x64"),
        ("macos", "arm64"),
        ("macos", "x64"),
        ("windows", "x64"),
    ]
]

kmp_library(
    name = "pdf",
    android = True,
    android_srcs = glob(["src/androidMain/kotlin/**/*.kt"]),
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_deps = [
        ":pdfium_native",
        "//utils/files",
        "@maven_kmp//:kermit",
        "@maven_kmp//:kotlinx_io_core",
    ],
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    keep_deps = [":pdfium_native"],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    non_jvm_srcs = glob(["src/nonJvmMain/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    web_targets = [
        "wasmJs",
        "js",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":pdf",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    jvm_srcs = glob(["src/jvmTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = ["//bazel/kmp/deps:kotlin_test"],
)
