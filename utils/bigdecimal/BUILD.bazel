load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

NATIVE_TARGETS = [
    "linuxArm64",
    "linuxX64",
    "macosArm64",
    "mingwX64",
]

kmp_library(
    name = "bigdecimal",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_android_srcs = glob(["src/jvmAndroidMain/kotlin/**/*.kt"]),
    native_deps = ["@maven_kmp//:bignum"],
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = NATIVE_TARGETS,
    visibility = ["//visibility:public"],
)

kmp_test(
    name = "test",
    associate = ":bigdecimal",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = NATIVE_TARGETS,
    deps = ["//bazel/kmp/deps:kotlin_test"],
)
