# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web
# gazelle:kmp_export @maven_kmp//:kotlinx_io_core

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "localsettings",
    android = True,
    android_srcs = glob(["src/androidMain/kotlin/**/*.kt"]),
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    web_deps = ["@maven_kmp//:kotlinx_browser"],
    web_srcs = glob(["src/webMain/kotlin/**/*.kt"]),
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = ["@maven_kmp//:kotlinx_io_core"],
    deps = [
        "//utils/files",
        "@maven_kmp//:atomicfu",
        "@maven_kmp//:kermit",
        "@maven_kmp//:kotlinx_serialization_json",
    ],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":localsettings",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    jvm_deps = [
        "//utils/files",
        "@maven_kmp//:kotlinx_io_core",
    ],
    jvm_srcs = glob(["src/jvmTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = ["//bazel/kmp/deps:kotlin_test"],
)
