# gazelle:kmp_generate true
# gazelle:kmp_targets linuxArm64 linuxX64 macosArm64 mingwX64
# gazelle:kmp_export @maven_kmp//:kotlinx_io_core

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "localsettings",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    exports = ["@maven_kmp//:kotlinx_io_core"],
    deps = [
        "//utils/files",
        "@maven_kmp//:atomicfu",
        "@maven_kmp//:kermit",
        "@maven_kmp//:kotlinx_serialization_json",
    ],
)

kmp_test(
    name = "test",
    associate = ":localsettings",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    jvm_srcs = glob(["src/jvmTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    deps = [
        "//bazel/kmp/deps:kotlin_test",
        "//utils/files",
        "@maven_kmp//:kotlinx_io_core",
    ],
)
