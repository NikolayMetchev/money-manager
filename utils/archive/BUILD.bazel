# gazelle:kmp_generate true
# gazelle:kmp_targets linuxArm64 linuxX64 macosArm64 mingwX64
# gazelle:kmp_export @maven_kmp//:cryptography_core
# gazelle:kmp_keep_dep @maven_kmp//:cryptography_provider_jdk jvmMain
# gazelle:kmp_keep_dep @maven_kmp//:cryptography_provider_openssl3_prebuilt nativeMain

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "archive",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_android_srcs = glob(["src/jvmAndroidMain/kotlin/**/*.kt"]),
    jvm_deps = ["@maven_kmp//:cryptography_provider_jdk"],
    keep_deps = [
        "@maven_kmp//:cryptography_provider_jdk",
        "@maven_kmp//:cryptography_provider_openssl3_prebuilt",
    ],
    native_deps = ["@maven_kmp//:cryptography_provider_openssl3_prebuilt"],
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    exports = ["@maven_kmp//:cryptography_core"],
    deps = ["@maven_kmp//:cryptography_random"],
)

kmp_test(
    name = "test",
    associate = ":archive",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    deps = [
        "//bazel/kmp/deps:kotlin_test",
        "@maven_kmp//:kotlinx_coroutines_test",
    ],
)
