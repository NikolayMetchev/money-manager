# gazelle:kmp_keep_dep @maven_kmp//:cryptography_provider_openssl3_prebuilt nativeMain

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "rest",
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_deps = [
        "@maven_kmp//:cryptography_provider_jdk",
        "@maven_kmp//:cryptography_bigint",
    ],
    keep_deps = [
        "@maven_kmp//:cryptography_bigint",
        "@maven_kmp//:cryptography_provider_jdk",
        "@maven_kmp//:cryptography_provider_openssl3_prebuilt",
    ],
    native_deps = ["@maven_kmp//:cryptography_provider_openssl3_prebuilt"],
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    exports = [
        "//app/importengineapi",
        "//app/model/apistrategy",
        "//app/model/core",
        "@maven_kmp//:ktor_client_core",
    ],
    deps = [
        "//utils/httpclient",
        "@maven_kmp//:cryptography_core",
        "@maven_kmp//:cryptography_random",
        "@maven_kmp//:ktor_http",
        "@maven_kmp//:ktor_utils",
    ],
)

kmp_test(
    name = "test",
    associate = ":rest",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    jvm_srcs = glob(["src/jvmTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    deps = [
        "//app/model/apistrategy",
        "//bazel/kmp/deps:kotlin_test",
        "@maven_kmp//:cryptography_core",
        "@maven_kmp//:kotlinx_coroutines_test",
        "@maven_kmp//:ktor_client_mock",
        "@maven_kmp//:ktor_http",
    ],
)
