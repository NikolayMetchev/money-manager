load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

# gazelle:kmp_generate true
# gazelle:kmp_targets android
# gazelle:kmp_test_flaky true
# gazelle:kmp_keep_dep @maven_kmp//:androidx_test_runner androidDeviceTest

kmp_library(
    name = "filePicker",
    android = True,
    android_deps = [
        "@maven_kmp//:androidx_activity",
        "@maven_kmp//:androidx_activity_compose",
        "@maven_kmp//:androidx_compose_ui",
    ],
    android_srcs = glob(["src/androidMain/kotlin/**/*.kt"]),
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_deps = [
        "//utils/localsettings",
        "@maven_kmp//:kotlinx_coroutines_core",
    ],
    jvm_srcs = glob(["src/jvmMain/kotlin/**/*.kt"]),
    plugins = ["compose"],
    visibility = ["//visibility:public"],
    deps = ["@maven_kmp//:androidx_compose_runtime"],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":filePicker",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    device_deps = [
        "//bazel/kmp/deps:kotlin_test",
        "@maven_kmp//:androidx_test_runner",
    ],
    device_srcs = glob(["src/androidDeviceTest/kotlin/**/*.kt"]),
    flaky = True,
    jvm_srcs = glob(["src/jvmTest/kotlin/**/*.kt"]),
    keep_deps = ["@maven_kmp//:androidx_test_runner"],
    plugins = ["compose"],
    deps = ["//bazel/kmp/deps:kotlin_test"],
)
