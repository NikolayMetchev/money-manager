# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web
# gazelle:kmp_export //utils/bigdecimal

load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

kmp_library(
    name = "currency",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_android_srcs = glob(["src/jvmAndroidMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    non_jvm_srcs = glob(["src/nonJvmMain/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    web_targets = [
        "wasmJs",
        "js",
    ],
    exports = ["//utils/bigdecimal"],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":currency",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    jvm_android_srcs = glob(["src/jvmAndroidTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    non_jvm_deps = ["//utils/bigdecimal"],
    non_jvm_srcs = glob(["src/nonJvmTest/kotlin/**/*.kt"]),
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = ["//bazel/kmp/deps:kotlin_test"],
)
