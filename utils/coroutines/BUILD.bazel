load("//bazel/kmp:defs.bzl", "kmp_library", "kmp_test")

# gazelle:kmp_generate true
# gazelle:kmp_targets android linuxArm64 linuxX64 macosArm64 mingwX64 web

kmp_library(
    name = "coroutines",
    android = True,
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm_android_srcs = glob(["src/jvmAndroidMain/kotlin/**/*.kt"]),
    native_srcs = glob(["src/nativeMain/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    visibility = ["//visibility:public"],
    web_srcs = glob(["src/webMain/kotlin/**/*.kt"]),
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = ["@maven_kmp//:kotlinx_coroutines_core"],
)

kmp_test(
    name = "test",
    android = True,
    associate = ":coroutines",
    common_srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    native_targets = [
        "linuxArm64",
        "linuxX64",
        "macosArm64",
        "mingwX64",
    ],
    web_targets = [
        "wasmJs",
        "js",
    ],
    deps = [
        "//bazel/kmp/deps:kotlin_test",
        "@maven_kmp//:kotlinx_coroutines_core",
        "@maven_kmp//:kotlinx_coroutines_test",
    ],
)
